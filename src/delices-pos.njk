    { id:42, category:"boissons", name:"Jus de Gingembre",           desc:"Gingembre frais pressé, vif et tonique. Vegan.", price:5.00, unit:"pièce", badges:[], vegetarian:true, vegan:true, halal:true, image:"" },

    // ── Combo (ouvre le sélecteur dessert + boisson) ──
    { id:60, category:"combos",   name:"Combo Dessert + Boisson",    desc:"Un dessert au choix + une boisson au choix. Économisez 1.50 !", price:0, unit:"combo", comboPicker:true, badges:["populaire"], vegetarian:true, vegan:false, halal:true, image:"" },

