<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Délices POS">
<meta name="theme-color" content="#5B2C8D">
<title>Nimara Délices — Caisse</title>
<link rel="manifest" href="/assets/manifest-delices.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════════════════════
   RESET & VARIABLES
══════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#0e0b1a;--bg2:#14102a;--bg3:#1e1833;--bg4:#281f40;--bg5:#2d2548;
  --border:rgba(255,255,255,.08);--border2:rgba(255,255,255,.14);
  --text:#f0ebff;--text2:#c4b5fd;--muted:#9d8cc4;--faint:#5a4f78;
  --violet:#5B2C8D;--violet-l:#7c3aed;--violet-d:#3d1a6e;--violet-xl:#2a1050;
  --lavender:#a78bfa;--lavender-l:#c4b5fd;--lavender-d:#7c5fd4;
  --green:#10b981;--green-l:#34d399;--green-bg:rgba(16,185,129,.15);--green-border:rgba(16,185,129,.3);
  --orange:#f59e0b;--orange-bg:rgba(245,158,11,.12);--orange-border:rgba(245,158,11,.3);
  --gold:#fbbf24;--gold-bg:rgba(251,191,36,.12);
  --red:#ef4444;--red-bg:rgba(239,68,68,.12);--red-border:rgba(239,68,68,.3);
  --blue:#3b82f6;--blue-bg:rgba(59,130,246,.12);--blue-border:rgba(59,130,246,.3);
  --radius:14px;--radius-sm:9px;--radius-xs:6px;
  --hdr:60px;--filter:52px;
  --shadow:0 8px 32px rgba(0,0,0,.5);--shadow-sm:0 2px 12px rgba(0,0,0,.4);
  --font:'DM Sans',-apple-system,BlinkMacSystemFont,sans-serif;
  --cart-w:340px;
}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:var(--font);-webkit-font-smoothing:antialiased}
body{display:flex;flex-direction:column}
button{font-family:var(--font);cursor:pointer;border:none;outline:none}
input,select,textarea{font-family:var(--font);outline:none}
img{display:block;max-width:100%}
scrollbar-width:none;
::-webkit-scrollbar{display:none}

/* ══════════════════════════════════════════
   HEADER
══════════════════════════════════════════ */
#hdr{
  height:var(--hdr);flex-shrink:0;
  background:linear-gradient(135deg,var(--violet-d) 0%,var(--violet) 60%,var(--violet-l) 100%);
  display:flex;align-items:center;gap:.75rem;padding:0 1rem;
  box-shadow:0 2px 20px rgba(0,0,0,.6);position:relative;z-index:50;
}
.hdr-brand{display:flex;align-items:center;gap:.6rem;text-decoration:none;color:inherit;flex-shrink:0}
.hdr-badge{
  background:rgba(255,255,255,.18);backdrop-filter:blur(6px);
  border:1px solid rgba(255,255,255,.28);border-radius:7px;
  padding:.25rem .55rem;font-size:.65rem;font-weight:800;letter-spacing:.12em;color:#fff;
}
.hdr-title{font-size:1rem;font-weight:700;color:#fff;line-height:1}
.hdr-sub{font-size:.65rem;color:rgba(255,255,255,.65);font-weight:400;margin-top:1px}
.hdr-spacer{flex:1}
#daily-total{
  font-size:.8rem;font-weight:700;color:#fbbf24;
  background:rgba(251,191,36,.15);border:1px solid rgba(251,191,36,.25);
  border-radius:20px;padding:.3rem .75rem;display:none;
}
body[data-mode="vendeuse"] #daily-total,
body[data-mode="admin"] #daily-total{display:block}
#mode-badge{
  font-size:.65rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  padding:.28rem .7rem;border-radius:20px;flex-shrink:0;
}
#mode-badge.client{background:var(--green-bg);color:var(--green-l);border:1px solid var(--green-border)}
#mode-badge.vendeuse{background:var(--gold-bg);color:var(--gold);border:1px solid rgba(251,191,36,.3)}
#mode-badge.admin{background:var(--blue-bg);color:#93c5fd;border:1px solid var(--blue-border)}
.hdr-btn{
  width:40px;height:40px;border-radius:var(--radius-sm);flex-shrink:0;
  border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.1);
  color:#fff;font-size:1rem;display:flex;align-items:center;justify-content:center;
  transition:background .15s;
}
.hdr-btn:hover{background:rgba(255,255,255,.22)}
#btn-summary{display:none}
body[data-mode="vendeuse"] #btn-summary,
body[data-mode="admin"] #btn-summary{display:flex}

/* ══════════════════════════════════════════
   FILTER BAR
══════════════════════════════════════════ */
#filters{
  height:var(--filter);flex-shrink:0;
  background:var(--bg2);border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:.4rem;padding:0 1rem;
  overflow-x:auto;scrollbar-width:none;
}
#filters::-webkit-scrollbar{display:none}
.fil-btn{
  flex-shrink:0;height:34px;padding:0 .9rem;border-radius:20px;
  border:1px solid var(--border2);background:transparent;
  color:var(--muted);font-size:.78rem;font-weight:600;
  transition:all .15s;white-space:nowrap;
}
.fil-btn:hover{border-color:var(--lavender-d);color:var(--lavender)}
.fil-btn.active{background:var(--violet);border-color:var(--violet-l);color:#fff}
.fil-sep{width:1px;height:24px;background:var(--border2);flex-shrink:0;margin:0 .2rem}

/* ══════════════════════════════════════════
   MAIN LAYOUT
══════════════════════════════════════════ */
#app{
  flex:1;display:flex;overflow:hidden;
  /* subtract header + filter */
  height:calc(100vh - var(--hdr) - var(--filter));
}

/* ─── Products panel ─────────────────────── */
#products-panel{
  flex:1;overflow-y:auto;padding:1rem;
  scrollbar-width:thin;scrollbar-color:var(--border) transparent;
}
#products-panel::-webkit-scrollbar{width:4px}
#products-panel::-webkit-scrollbar-track{background:transparent}
#products-panel::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}

#product-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(180px,1fr));
  gap:.75rem;
}
/* Vendeuse: bigger cards, faster scanning */
body[data-mode="vendeuse"] #product-grid,
body[data-mode="admin"] #product-grid{
  grid-template-columns:repeat(auto-fill,minmax(160px,1fr));
  gap:.6rem;
}

/* ─── Product card ─────────────────────── */
.pcard{
  background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius);
  overflow:hidden;display:flex;flex-direction:column;
  transition:border-color .15s,transform .1s;position:relative;
  cursor:pointer;
}
.pcard:hover{border-color:var(--lavender-d)}
.pcard:active{transform:scale(.97)}
.pcard.rupture{opacity:.45;pointer-events:none}
.pcard.dernieres .pcard-img-wrap::after{
  content:"⚠️ Dernières";position:absolute;bottom:4px;left:4px;
  background:rgba(245,158,11,.9);color:#fff;font-size:.6rem;font-weight:700;
  padding:.15rem .4rem;border-radius:4px;
}
.pcard-img-wrap{position:relative;aspect-ratio:4/3;overflow:hidden;background:var(--bg4);flex-shrink:0}
.pcard-img-wrap img{width:100%;height:100%;object-fit:cover;transition:transform .2s}
.pcard:hover .pcard-img-wrap img{transform:scale(1.05)}
.pcard-img-placeholder{
  width:100%;height:100%;display:flex;align-items:center;justify-content:center;
  font-size:2.5rem;color:var(--faint);
}
.pcard-badge{
  position:absolute;top:6px;right:6px;
  font-size:.58rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
  padding:.2rem .5rem;border-radius:5px;
}
.pcard-badge.signature{background:var(--violet);color:#e9d5ff}
.pcard-badge.populaire{background:var(--gold-bg);color:var(--gold);border:1px solid rgba(251,191,36,.3)}
.pcard-badge.prestige{background:linear-gradient(135deg,#7c3aed,#a855f7);color:#fff}
.pcard-body{padding:.7rem;flex:1;display:flex;flex-direction:column;gap:.3rem}
.pcard-name{font-size:.85rem;font-weight:700;color:var(--text);line-height:1.2}
.pcard-desc{font-size:.72rem;color:var(--muted);line-height:1.4;flex:1}
.pcard-footer{display:flex;align-items:center;justify-content:space-between;margin-top:.4rem;gap:.4rem}
.pcard-price{font-size:1rem;font-weight:800;color:var(--lavender)}
.pcard-unit{font-size:.64rem;color:var(--faint);font-weight:400;display:block;margin-top:-2px}
/* Client mode: show add button */
body[data-mode="client"] .pcard-add-btn{
  width:32px;height:32px;border-radius:50%;background:var(--violet);color:#fff;
  font-size:1.1rem;display:flex;align-items:center;justify-content:center;
  transition:background .15s;flex-shrink:0;
}
body[data-mode="client"] .pcard-add-btn:hover{background:var(--violet-l)}
/* Vendeuse/admin: full card is clickable tap target */
body[data-mode="vendeuse"] .pcard-add-btn,
body[data-mode="admin"] .pcard-add-btn{display:none}
body[data-mode="vendeuse"] .pcard-body,
body[data-mode="admin"] .pcard-body{padding:.6rem}
body[data-mode="vendeuse"] .pcard-name,
body[data-mode="admin"] .pcard-name{font-size:.82rem}
body[data-mode="vendeuse"] .pcard-price,
body[data-mode="admin"] .pcard-price{font-size:.95rem}

/* Allergen badges */
.pcard-tags{display:flex;gap:.25rem;flex-wrap:wrap;margin-top:.3rem}
.tag{font-size:.58rem;padding:.12rem .4rem;border-radius:3px;font-weight:600}
.tag.veg{background:var(--green-bg);color:var(--green-l);border:1px solid var(--green-border)}
.tag.vegan{background:rgba(74,222,128,.12);color:#4ade80;border:1px solid rgba(74,222,128,.25)}
.tag.halal{background:rgba(251,191,36,.1);color:var(--gold);border:1px solid rgba(251,191,36,.2)}

/* Admin stock/price controls */
.pcard-admin-bar{
  display:none;border-top:1px solid var(--border);
  padding:.4rem .7rem;gap:.4rem;align-items:center;
}
body[data-mode="admin"] .pcard-admin-bar{display:flex}
.stock-sel{
  flex:1;background:var(--bg4);border:1px solid var(--border2);color:var(--text);
  border-radius:5px;padding:.25rem .4rem;font-size:.68rem;
}
.btn-soldé{
  padding:.25rem .5rem;font-size:.65rem;font-weight:700;
  background:var(--orange-bg);color:var(--orange);border:1px solid var(--orange-border);
  border-radius:5px;white-space:nowrap;
}
.btn-edit-price{
  padding:.25rem .5rem;font-size:.65rem;font-weight:700;
  background:var(--blue-bg);color:#93c5fd;border:1px solid var(--blue-border);
  border-radius:5px;
}

/* Sold-out overlay */
.rupture-label{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  background:rgba(14,11,26,.75);font-size:.75rem;font-weight:700;color:var(--red);
  letter-spacing:.06em;text-transform:uppercase;pointer-events:none;
}

/* ─── EMPTY STATE ────────────────────────── */
#empty-state{
  display:none;flex-direction:column;align-items:center;justify-content:center;
  padding:4rem 2rem;text-align:center;gap:1rem;color:var(--muted);
}
#empty-state .icon{font-size:3rem;opacity:.5}
#empty-state p{font-size:.9rem}

/* ══════════════════════════════════════════
   CART PANEL
══════════════════════════════════════════ */
#cart-panel{
  width:var(--cart-w);flex-shrink:0;
  background:var(--bg2);border-left:1px solid var(--border);
  display:flex;flex-direction:column;
  transition:transform .3s;
}
/* Portrait: bottom sheet */
@media(orientation:portrait),(max-width:768px){
  #app{flex-direction:column;height:auto;overflow:visible}
  body{overflow:auto}
  #products-panel{height:auto;overflow:visible;padding:.75rem}
  #cart-panel{
    width:100%;border-left:none;border-top:1px solid var(--border);
    max-height:400px;
  }
}

.cart-hdr{
  padding:.85rem 1rem;border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;flex-shrink:0;
}
.cart-title{font-size:.95rem;font-weight:700;color:var(--text)}
.cart-count{
  background:var(--violet);color:#fff;font-size:.7rem;font-weight:800;
  width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;
}
.cart-items{flex:1;overflow-y:auto;padding:.5rem;display:flex;flex-direction:column;gap:.4rem}
.cart-items::-webkit-scrollbar{width:3px}
.cart-items::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}

/* Cart item */
.ci{
  background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius-sm);
  padding:.6rem .75rem;display:flex;align-items:center;gap:.6rem;
}
.ci-name{flex:1;font-size:.8rem;font-weight:600;color:var(--text);line-height:1.2}
.ci-unit-price{font-size:.68rem;color:var(--muted)}
.ci-qty{display:flex;align-items:center;gap:.3rem;flex-shrink:0}
.ci-qty-btn{
  width:26px;height:26px;border-radius:50%;border:1px solid var(--border2);
  background:var(--bg4);color:var(--text);font-size:.9rem;
  display:flex;align-items:center;justify-content:center;transition:all .1s;
}
.ci-qty-btn:hover{background:var(--violet);border-color:var(--violet)}
.ci-qty-num{font-size:.85rem;font-weight:700;min-width:20px;text-align:center}
.ci-total{font-size:.85rem;font-weight:700;color:var(--lavender);flex-shrink:0;min-width:48px;text-align:right}
.ci-remove{
  width:24px;height:24px;border-radius:50%;background:transparent;
  color:var(--faint);font-size:.9rem;display:flex;align-items:center;justify-content:center;
  transition:all .1s;flex-shrink:0;
}
.ci-remove:hover{background:var(--red-bg);color:var(--red)}

/* Cart empty */
.cart-empty{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:2rem;gap:.75rem;color:var(--faint);text-align:center;
}
.cart-empty .icon{font-size:2.5rem;opacity:.4}
.cart-empty p{font-size:.8rem}

/* Cart footer */
.cart-footer{
  border-top:1px solid var(--border);padding:.75rem 1rem;
  display:flex;flex-direction:column;gap:.5rem;flex-shrink:0;
}
.cart-total-row{display:flex;justify-content:space-between;align-items:baseline}
.cart-total-label{font-size:.8rem;color:var(--muted);font-weight:600}
.cart-total-amount{font-size:1.6rem;font-weight:800;color:var(--text)}
.cart-total-amount span{font-size:.85rem;font-weight:500;color:var(--muted)}

/* Checkout button */
.btn-checkout{
  width:100%;padding:1rem;border-radius:var(--radius);font-size:1rem;font-weight:800;
  letter-spacing:.02em;border:none;cursor:pointer;transition:all .15s;
  min-height:52px;display:flex;align-items:center;justify-content:center;gap:.5rem;
}
.btn-checkout.primary{
  background:linear-gradient(135deg,var(--violet),var(--violet-l));color:#fff;
  box-shadow:0 4px 16px rgba(91,44,141,.4);
}
.btn-checkout.primary:hover{box-shadow:0 6px 24px rgba(91,44,141,.6);transform:translateY(-1px)}
.btn-checkout.primary:active{transform:scale(.98)}
.btn-checkout:disabled{opacity:.4;cursor:not-allowed;transform:none!important;box-shadow:none!important}
.btn-new-order{
  width:100%;padding:.7rem;border-radius:var(--radius-sm);font-size:.85rem;font-weight:700;
  background:var(--bg4);color:var(--muted);border:1px solid var(--border2);
  cursor:pointer;transition:all .15s;
}
.btn-new-order:hover{background:var(--bg5);color:var(--text)}

/* Client mode: WhatsApp / delivery note */
.cart-note{
  display:none;font-size:.72rem;color:var(--muted);text-align:center;line-height:1.4;
  padding:.3rem 0;
}
body[data-mode="client"] .cart-note{display:block}

/* ══════════════════════════════════════════
   MODALS
══════════════════════════════════════════ */
.modal-backdrop{
  position:fixed;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(4px);
  z-index:100;display:flex;align-items:center;justify-content:center;padding:1rem;
  opacity:0;pointer-events:none;transition:opacity .2s;
}
.modal-backdrop.open{opacity:1;pointer-events:all}
.modal{
  background:var(--bg3);border:1px solid var(--border2);border-radius:20px;
  width:100%;max-width:420px;max-height:90vh;overflow-y:auto;
  box-shadow:var(--shadow);
  transform:translateY(16px) scale(.97);transition:transform .2s;
}
.modal-backdrop.open .modal{transform:none}
.modal-hdr{
  padding:1.25rem 1.5rem 0;display:flex;align-items:center;justify-content:space-between;
}
.modal-title{font-size:1.15rem;font-weight:800;color:var(--text)}
.modal-close{
  width:32px;height:32px;border-radius:50%;background:var(--bg4);
  color:var(--muted);font-size:1rem;display:flex;align-items:center;justify-content:center;
  border:1px solid var(--border);cursor:pointer;
}
.modal-close:hover{color:var(--text)}
.modal-body{padding:1.25rem 1.5rem 1.5rem;display:flex;flex-direction:column;gap:1rem}
.modal-sub{font-size:.8rem;color:var(--muted);text-align:center}

/* ── PIN modal ── */
#pin-display{
  display:flex;gap:.5rem;justify-content:center;margin:.5rem 0;
}
.pin-dot{
  width:14px;height:14px;border-radius:50%;border:2px solid var(--border2);
  background:transparent;transition:background .15s;
}
.pin-dot.filled{background:var(--lavender);border-color:var(--lavender)}
.pin-pad{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}
.pin-key{
  height:56px;border-radius:var(--radius-sm);background:var(--bg4);
  border:1px solid var(--border2);color:var(--text);font-size:1.3rem;font-weight:700;
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  transition:all .1s;user-select:none;
}
.pin-key:hover{background:var(--bg5);border-color:var(--lavender-d)}
.pin-key:active{transform:scale(.93);background:var(--violet)}
.pin-key.danger{color:var(--red)}
.pin-key.wide{grid-column:span 2;font-size:.9rem}
.pin-error{color:var(--red);font-size:.8rem;text-align:center;min-height:1.2em}

/* ── Checkout modal ── */
.payment-btns{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
.pay-btn{
  padding:1.25rem .75rem;border-radius:var(--radius);border:2px solid var(--border2);
  background:var(--bg4);color:var(--text);cursor:pointer;
  display:flex;flex-direction:column;align-items:center;gap:.5rem;
  transition:all .15s;
}
.pay-btn:hover{border-color:var(--lavender-d);background:var(--bg5)}
.pay-btn.selected{border-color:var(--violet-l);background:rgba(124,58,237,.15)}
.pay-btn-icon{font-size:2rem}
.pay-btn-label{font-size:.85rem;font-weight:700}
.cash-section,.card-section{display:none}
.cash-section.active,.card-section.active{display:flex;flex-direction:column;gap:.75rem}
.input-row{display:flex;flex-direction:column;gap:.35rem}
.input-label{font-size:.75rem;font-weight:600;color:var(--muted)}
.pos-input{
  width:100%;padding:.7rem .9rem;background:var(--bg4);border:1px solid var(--border2);
  color:var(--text);border-radius:var(--radius-sm);font-size:1.1rem;font-weight:700;
}
.pos-input:focus{border-color:var(--lavender-d);outline:none}
.change-display{
  background:var(--green-bg);border:1px solid var(--green-border);border-radius:var(--radius-sm);
  padding:.9rem;display:flex;justify-content:space-between;align-items:center;
}
.change-label{font-size:.8rem;color:var(--green-l);font-weight:600}
.change-amount{font-size:1.5rem;font-weight:800;color:var(--green-l)}
.card-info{
  background:var(--blue-bg);border:1px solid var(--blue-border);border-radius:var(--radius-sm);
  padding:1rem;text-align:center;
}
.card-info .total-big{font-size:2rem;font-weight:800;color:var(--lavender-l);margin:.5rem 0}
.card-info p{font-size:.85rem;color:var(--muted)}
.card-info .sumup{font-size:1rem;font-weight:700;color:#93c5fd;margin-top:.25rem}
.btn-confirm{
  width:100%;padding:1rem;border-radius:var(--radius);font-size:1rem;font-weight:800;
  background:linear-gradient(135deg,var(--green),#059669);color:#fff;
  border:none;cursor:pointer;transition:all .15s;min-height:52px;
}
.btn-confirm:hover{box-shadow:0 4px 16px rgba(16,185,129,.4);transform:translateY(-1px)}
.btn-confirm:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none}

/* ── Box options modal ── */
.box-opt-head{display:flex;align-items:center;gap:.75rem}
.box-opt-img{width:56px;height:56px;border-radius:var(--radius-sm);object-fit:cover;flex-shrink:0;background:var(--bg4)}
.box-opt-name{font-size:1.05rem;font-weight:800;color:var(--text);line-height:1.2}
.box-opt-group{display:flex;flex-direction:column;gap:.4rem}
.box-opt-label{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.box-opt-row{display:grid;grid-template-columns:1fr 1fr;gap:.5rem}
.box-opt-row-3{grid-template-columns:1fr 1fr 1fr}
.bopt{
  display:flex;flex-direction:column;align-items:center;gap:.15rem;
  padding:.7rem .5rem;border-radius:var(--radius-sm);border:2px solid var(--border2);
  background:var(--bg4);color:var(--text);cursor:pointer;transition:all .12s;min-height:58px;justify-content:center;
}
.bopt:hover{border-color:var(--lavender-d)}
.bopt.active{border-color:var(--violet-l);background:rgba(124,58,237,.18)}
.bopt-t{font-size:.82rem;font-weight:700;line-height:1.1;text-align:center}
.bopt-s{font-size:.62rem;color:var(--muted);text-align:center;line-height:1.1}
.bopt.active .bopt-s{color:var(--lavender-l)}
.box-opt-breakdown{
  display:grid;grid-template-columns:1fr auto;gap:.3rem .5rem;
  font-size:.82rem;color:var(--text2);
  background:var(--bg4);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.65rem .8rem;
}
.box-consigne-note{
  font-size:.72rem;color:var(--gold);background:var(--gold-bg);
  border:1px solid rgba(251,191,36,.25);border-radius:var(--radius-sm);padding:.55rem .7rem;line-height:1.4;
}
.box-opt-total{
  display:flex;justify-content:space-between;align-items:baseline;
  font-size:1.05rem;font-weight:700;color:var(--text);padding:.25rem 0;
}
.box-opt-total span:last-child{font-size:1.4rem;font-weight:800;color:var(--lavender-l)}
.box-extra-row{display:flex;gap:.5rem;flex-wrap:wrap}
.box-extra{
  flex:1;min-width:120px;display:flex;align-items:center;gap:.45rem;
  padding:.6rem .7rem;border-radius:var(--radius-sm);border:1px solid var(--border2);
  background:var(--bg4);font-size:.82rem;font-weight:600;color:var(--text);cursor:pointer;
}
.box-extra input{width:18px;height:18px;accent-color:var(--violet-l);cursor:pointer}
.box-extra b{margin-left:auto;color:var(--muted);font-weight:700}

/* ── Weigh modal ── */
.weigh-rate-line{font-size:.78rem;color:var(--gold);font-weight:600;margin-top:.15rem}

/* ── Combo modal ── */
.combo-list{display:flex;flex-direction:column;gap:.35rem;max-height:160px;overflow-y:auto}
.combo-opt{
  display:flex;justify-content:space-between;align-items:center;
  padding:.55rem .75rem;border-radius:var(--radius-sm);border:1.5px solid var(--border2);
  background:var(--bg4);color:var(--text);font-size:.85rem;font-weight:600;cursor:pointer;transition:all .12s;
}
.combo-opt span{color:var(--muted);font-weight:700;font-size:.8rem}
.combo-opt:hover{border-color:var(--lavender-d)}
.combo-opt.active{border-color:var(--violet-l);background:rgba(124,58,237,.18)}
.combo-opt.active span{color:var(--lavender-l)}

/* ── Receipt modal ── */
.receipt-items{
  background:var(--bg4);border:1px solid var(--border);border-radius:var(--radius-sm);
  padding:.75rem;display:flex;flex-direction:column;gap:.4rem;max-height:200px;overflow-y:auto;
}
.receipt-item{display:flex;justify-content:space-between;font-size:.8rem;color:var(--text2)}
.receipt-divider{border:none;border-top:1px dashed var(--border2);margin:.25rem 0}
.receipt-total{display:flex;justify-content:space-between;font-size:1rem;font-weight:800;color:var(--text)}
.receipt-method{
  font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;
  padding:.3rem .75rem;border-radius:20px;display:inline-block;align-self:center;
}
.receipt-method.cash{background:var(--gold-bg);color:var(--gold);border:1px solid rgba(251,191,36,.3)}
.receipt-method.card{background:var(--blue-bg);color:#93c5fd;border:1px solid var(--blue-border)}
.btn-print{
  padding:.75rem;border-radius:var(--radius-sm);font-size:.85rem;font-weight:700;
  background:var(--bg4);color:var(--muted);border:1px solid var(--border2);
  cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:.5rem;
}
.btn-print:hover{background:var(--bg5);color:var(--text)}
.btn-new-order-big{
  width:100%;padding:1rem;border-radius:var(--radius);font-size:1rem;font-weight:800;
  background:linear-gradient(135deg,var(--violet),var(--violet-l));color:#fff;
  border:none;cursor:pointer;transition:all .15s;min-height:52px;
}
.btn-new-order-big:hover{box-shadow:0 4px 16px rgba(91,44,141,.4);transform:translateY(-1px)}

/* ── Daily summary modal ── */
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}
.stat-card{
  background:var(--bg4);border:1px solid var(--border);border-radius:var(--radius-sm);
  padding:.85rem;display:flex;flex-direction:column;gap:.2rem;
}
.stat-label{font-size:.7rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.stat-value{font-size:1.4rem;font-weight:800;color:var(--text)}
.stat-value.green{color:var(--green-l)}
.stat-value.gold{color:var(--gold)}
.stat-value.lavender{color:var(--lavender)}
.txn-list{max-height:200px;overflow-y:auto;display:flex;flex-direction:column;gap:.35rem}
.txn-row{
  display:flex;align-items:center;gap:.5rem;font-size:.75rem;
  background:var(--bg4);border:1px solid var(--border);border-radius:var(--radius-xs);
  padding:.4rem .6rem;
}
.txn-time{color:var(--faint);font-variant-numeric:tabular-nums;min-width:40px}
.txn-items{flex:1;color:var(--muted)}
.txn-total{font-weight:700;color:var(--text);min-width:54px;text-align:right}
.txn-method{font-size:.65rem;font-weight:700;padding:.15rem .4rem;border-radius:4px}
.txn-method.cash{background:var(--gold-bg);color:var(--gold)}
.txn-method.card{background:var(--blue-bg);color:#93c5fd}
.btn-export{
  padding:.7rem;border-radius:var(--radius-sm);font-size:.82rem;font-weight:700;
  background:var(--bg4);color:var(--muted);border:1px solid var(--border2);
  cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:.5rem;
}
.btn-export:hover{background:var(--bg5);color:var(--text)}

/* ── Admin edit product modal ── */
.form-group{display:flex;flex-direction:column;gap:.35rem}
.form-label{font-size:.75rem;font-weight:600;color:var(--muted)}
.form-input{
  width:100%;padding:.65rem .9rem;background:var(--bg4);border:1px solid var(--border2);
  color:var(--text);border-radius:var(--radius-sm);font-size:.9rem;
}
.form-input:focus{border-color:var(--lavender-d)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}
.btn-save{
  padding:.8rem;border-radius:var(--radius-sm);font-size:.9rem;font-weight:700;
  background:var(--violet);color:#fff;border:none;cursor:pointer;transition:all .15s;
}
.btn-save:hover{background:var(--violet-l)}

/* ── Client checkout modal (Stripe placeholder) ── */
.stripe-placeholder{
  background:var(--bg4);border:1px solid var(--border2);border-radius:var(--radius);
  padding:1.5rem;text-align:center;display:flex;flex-direction:column;gap:.75rem;align-items:center;
}
.stripe-placeholder .icon{font-size:2.5rem}
.stripe-placeholder h3{font-size:1rem;font-weight:700;color:var(--text)}
.stripe-placeholder p{font-size:.82rem;color:var(--muted);line-height:1.5}
.btn-whatsapp{
  padding:.85rem 1.5rem;border-radius:var(--radius);font-size:.9rem;font-weight:700;
  background:#25d366;color:#fff;border:none;cursor:pointer;transition:all .15s;
  display:flex;align-items:center;gap:.5rem;text-decoration:none;
}
.btn-whatsapp:hover{background:#22c55e}
.delivery-note{
  background:var(--orange-bg);border:1px solid var(--orange-border);border-radius:var(--radius-sm);
  padding:.75rem;font-size:.78rem;color:var(--orange);line-height:1.5;
}

/* ── Admin add product modal ── */
/* reuses form-group, form-input, form-label, btn-save */

/* ══════════════════════════════════════════
   STAND FICHE
══════════════════════════════════════════ */
#fiche{
  position:fixed;inset:0;z-index:90;display:none;
  background:radial-gradient(circle at 50% 0%,#3d1a6e 0%,#0e0b1a 70%);
  flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:2rem;overflow-y:auto;
}
#fiche.open{display:flex}
#fiche-close{
  position:absolute;top:1.25rem;right:1.25rem;width:44px;height:44px;border-radius:50%;
  border:1px solid var(--border2);background:rgba(255,255,255,.08);color:var(--text);
  font-size:1.2rem;display:flex;align-items:center;justify-content:center;transition:background .15s;
}
#fiche-close:hover{background:rgba(255,255,255,.18)}
#fiche-edit{
  position:absolute;top:1.25rem;left:1.25rem;
  padding:.6rem 1rem;border-radius:var(--radius-sm);border:1px solid var(--border2);
  background:rgba(255,255,255,.08);color:var(--text);font-size:.8rem;font-weight:700;
  transition:background .15s;display:none;
}
body[data-mode="vendeuse"] #fiche-edit,
body[data-mode="admin"] #fiche-edit{display:block}
#fiche-edit:hover{background:rgba(255,255,255,.18)}
.fiche-badge{
  background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);border-radius:10px;
  padding:.4rem .9rem;font-size:.85rem;font-weight:800;letter-spacing:.15em;color:#fff;margin-bottom:1.5rem;
}
.fiche-today{font-size:clamp(1.6rem,4vw,2.6rem);font-weight:800;color:#fff;letter-spacing:.02em;line-height:1.1;margin-bottom:.4rem}
.fiche-tagline{font-size:clamp(1rem,2.5vw,1.5rem);color:var(--lavender-l);font-style:italic;margin-bottom:2.5rem}
.fiche-card{
  background:rgba(255,255,255,.06);border:1.5px solid rgba(167,139,250,.35);border-radius:28px;
  padding:clamp(1.75rem,5vw,3rem) clamp(2rem,7vw,4.5rem);
  box-shadow:0 20px 80px rgba(0,0,0,.5);max-width:600px;width:100%;
}
.fiche-formule-label{font-size:clamp(.85rem,2vw,1.1rem);font-weight:700;letter-spacing:.25em;text-transform:uppercase;color:var(--gold);margin-bottom:.6rem}
.fiche-day{font-size:clamp(1.8rem,5vw,3rem);font-weight:800;color:#fff;margin-bottom:.25rem}
.fiche-dish{font-size:clamp(1rem,2.5vw,1.4rem);color:var(--lavender-l);font-weight:500;margin-bottom:1.25rem}
.fiche-price{
  font-size:clamp(3.5rem,12vw,6rem);font-weight:800;line-height:1;
  background:linear-gradient(135deg,#fbbf24,#fcd34d);
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:.25rem;
}
.fiche-price .chf{font-size:.35em;font-weight:700;color:var(--gold);-webkit-text-fill-color:var(--gold);vertical-align:super}
.fiche-combos{font-size:clamp(1rem,2.5vw,1.4rem);color:#fff;font-weight:600;margin-bottom:1.75rem}
.fiche-combos .plus{color:var(--lavender)}
.fiche-hours{
  display:inline-flex;align-items:center;gap:.6rem;
  background:rgba(167,139,250,.15);border:1px solid rgba(167,139,250,.3);border-radius:30px;
  padding:.6rem 1.5rem;font-size:clamp(1rem,2.5vw,1.3rem);font-weight:700;color:var(--lavender-l);
}
.fiche-foot{margin-top:2.5rem;font-size:.85rem;color:var(--muted);letter-spacing:.1em}

/* ══════════════════════════════════════════
   PRINT
══════════════════════════════════════════ */
@media print{
  body{background:#fff;color:#000}
  #hdr,#filters,#products-panel,#cart-panel,
  .modal-backdrop:not(#receipt-modal){display:none!important}
  #receipt-modal{position:static!important;opacity:1!important;pointer-events:all!important;background:transparent}
  #receipt-modal .modal{box-shadow:none;border:none;max-width:100%;background:#fff;color:#000}
  /* When the fiche is open, print it instead */
  #fiche.open{position:static;background:#fff!important;display:flex!important;min-height:100vh}
  #fiche.open ~ * ,#hdr,#filters,#products-panel,#cart-panel{display:none!important}
  #fiche.open #fiche-close,#fiche.open #fiche-edit{display:none!important}
  #fiche.open .fiche-today,#fiche.open .fiche-day,#fiche.open .fiche-combos{color:#5B2C8D!important}
  #fiche.open .fiche-price{-webkit-text-fill-color:#5B2C8D!important;background:none!important;color:#5B2C8D!important}
  #fiche.open .fiche-card{border-color:#5B2C8D!important;box-shadow:none}
}

/* ══════════════════════════════════════════
   UTILITY
══════════════════════════════════════════ */
.hidden{display:none!important}
.flex{display:flex}
.gap-sm{gap:.5rem}
.fw-bold{font-weight:700}
.text-muted{color:var(--muted)}
.text-sm{font-size:.8rem}
</style>
</head>
<body data-mode="client">

<!-- ══════════════════════════════════════════
     HEADER
══════════════════════════════════════════ -->
<header id="hdr">
  <div class="hdr-brand">
    <span class="hdr-badge">NIMARA</span>
    <div>
      <div class="hdr-title">Délices</div>
      <div class="hdr-sub">Le stand gourmand</div>
    </div>
  </div>
  <div class="hdr-spacer"></div>
  <div id="daily-total">CA: CHF <span id="daily-total-val">0.00</span></div>
  <span id="mode-badge" class="client">Client</span>
  <button class="hdr-btn" id="btn-fiche" title="Fiche stand" onclick="openFiche()">📋</button>
  <button class="hdr-btn" id="btn-summary" title="Bilan du jour" onclick="openModal('summary-modal')">📊</button>
  <button class="hdr-btn" title="Paramètres / Mode" onclick="openModal('pin-modal')">⚙️</button>
</header>

<!-- ══════════════════════════════════════════
     FILTER BAR
══════════════════════════════════════════ -->
<nav id="filters">
  <button class="fil-btn active" data-filter="all">Tout</button>
  <button class="fil-btn" data-filter="sucre">🍰 Douceurs</button>
  <button class="fil-btn" data-filter="sale">🍛 Saveurs du Monde</button>
  <button class="fil-btn" data-filter="boissons">🥤 Boissons</button>
  <button class="fil-btn" data-filter="combos">🎁 Combos</button>
  <button class="fil-btn" data-filter="formules">🎉 Formules</button>
  <button class="fil-btn" data-filter="extras">🥡 Extras</button>
  <div class="fil-sep"></div>
  <button class="fil-btn" data-filter="vegetarian">🌿 Végétarien</button>
  <button class="fil-btn" data-filter="vegan">🌱 Vegan</button>
  <button class="fil-btn" data-filter="halal">☪️ Halal</button>
</nav>

<!-- ══════════════════════════════════════════
     MAIN APP
══════════════════════════════════════════ -->
<div id="app">

  <!-- Products panel -->
  <main id="products-panel">
    <div id="product-grid"></div>
    <div id="empty-state">
      <div class="icon">🔍</div>
      <p>Aucun produit pour ce filtre</p>
    </div>
  </main>

  <!-- Cart panel -->
  <aside id="cart-panel">
    <div class="cart-hdr">
      <span class="cart-title">🛒 Panier</span>
      <span class="cart-count" id="cart-count">0</span>
    </div>
    <div class="cart-items" id="cart-items">
      <div class="cart-empty">
        <div class="icon">🛒</div>
        <p>Le panier est vide</p>
      </div>
    </div>
    <div class="cart-footer">
      <div class="cart-total-row">
        <span class="cart-total-label">Total</span>
        <span class="cart-total-amount">CHF <span id="cart-total">0.00</span></span>
      </div>
      <p class="cart-note">🚚 Livraison via <a href="https://ubereats.com" target="_blank" style="color:var(--lavender)">UberEats</a> · ❓ <a href="https://wa.me/41XXXXXXXXX" target="_blank" style="color:var(--green-l)">WhatsApp</a></p>
      <button class="btn-checkout primary" id="btn-checkout" disabled onclick="handleCheckout()">
        Passer commande
      </button>
    </div>
  </aside>

</div>

<!-- ══════════════════════════════════════════
     MODAL: PIN
══════════════════════════════════════════ -->
<div class="modal-backdrop" id="pin-modal">
  <div class="modal">
    <div class="modal-hdr">
      <span class="modal-title">🔐 Accès</span>
      <button class="modal-close" onclick="closeModal('pin-modal')">✕</button>
    </div>
    <div class="modal-body">
      <p class="modal-sub">Entrez le code PIN pour accéder au mode vendeuse ou admin</p>
      <div id="pin-display">
        <div class="pin-dot" id="pd0"></div>
        <div class="pin-dot" id="pd1"></div>
        <div class="pin-dot" id="pd2"></div>
        <div class="pin-dot" id="pd3"></div>
      </div>
      <p class="pin-error" id="pin-error"></p>
      <div class="pin-pad">
        <button class="pin-key" onclick="pinPress('1')">1</button>
        <button class="pin-key" onclick="pinPress('2')">2</button>
        <button class="pin-key" onclick="pinPress('3')">3</button>
        <button class="pin-key" onclick="pinPress('4')">4</button>
        <button class="pin-key" onclick="pinPress('5')">5</button>
        <button class="pin-key" onclick="pinPress('6')">6</button>
        <button class="pin-key" onclick="pinPress('7')">7</button>
        <button class="pin-key" onclick="pinPress('8')">8</button>
        <button class="pin-key" onclick="pinPress('9')">9</button>
        <button class="pin-key danger" onclick="pinClear()">⌫</button>
        <button class="pin-key" onclick="pinPress('0')">0</button>
        <button class="pin-key wide" onclick="switchToClient()" style="grid-column:3;font-size:.75rem">Mode Client</button>
      </div>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════
     MODAL: BOX OPTIONS (taille + contenant)
══════════════════════════════════════════ -->
<div class="modal-backdrop" id="box-options-modal">
  <div class="modal">
    <div class="modal-hdr">
      <span class="modal-title">📦 Composer la box</span>
      <button class="modal-close" onclick="closeModal('box-options-modal')">✕</button>
    </div>
    <div class="modal-body">
      <div class="box-opt-head">
        <img id="box-options-img" class="box-opt-img" alt="" onerror="this.style.display='none'">
        <div class="box-opt-name" id="box-options-name"></div>
      </div>

      <div class="box-opt-group">
        <div class="box-opt-label">Taille</div>
        <div class="box-opt-row">
          <button class="bopt bopt-size active" data-size="petite" onclick="selectBoxSize(this)">
            <span class="bopt-t">Petite</span><span class="bopt-s">viande 12.90 · végé 11.90</span>
          </button>
          <button class="bopt bopt-size" data-size="grande" onclick="selectBoxSize(this)">
            <span class="bopt-t">Grande</span><span class="bopt-s">viande 15.90 · végé 14.90</span>
          </button>
        </div>
      </div>

      <div class="box-opt-group">
        <div class="box-opt-label">Contenant</div>
        <div class="box-opt-row box-opt-row-3">
          <button class="bopt bopt-cont active" data-cont="surplace" onclick="selectBoxCont(this)">
            <span class="bopt-t">🍽 Sur place</span><span class="bopt-s">inclus</span>
          </button>
          <button class="bopt bopt-cont" data-cont="emporter" onclick="selectBoxCont(this)">
            <span class="bopt-t">🥡 Box carton</span><span class="bopt-s">+1.– emporter</span>
          </button>
          <button class="bopt bopt-cont" data-cont="verre" onclick="selectBoxCont(this)">
            <span class="bopt-t">🫙 Box verre</span><span class="bopt-s">+10.– consigne</span>
          </button>
        </div>
      </div>

      <div class="box-opt-group">
        <div class="box-opt-label">Extras</div>
        <div class="box-extra-row">
          <label class="box-extra"><input type="checkbox" id="box-couverts" onchange="toggleBoxExtra('couverts',this.checked)"> 🍴 Couverts <b>+0.20</b></label>
          <label class="box-extra"><input type="checkbox" id="box-sac" onchange="toggleBoxExtra('sac',this.checked)"> 🛍 Sac <b>+0.20</b></label>
        </div>
      </div>

      <div class="box-opt-breakdown" id="box-options-breakdown"></div>
      <div class="box-consigne-note" id="box-consigne-note" style="display:none">
        💡 La consigne de 10.– est remboursée au retour de la box en verre.
      </div>

      <div class="box-opt-total">
        <span>Total</span>
        <span>CHF <span id="box-options-total">0.00</span></span>
      </div>
      <button class="btn-confirm" onclick="confirmBoxOptions()">➕ Ajouter au panier</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════
     MODAL: WEIGH (vente au poids / 100 g)
══════════════════════════════════════════ -->
<div class="modal-backdrop" id="weigh-modal">
  <div class="modal">
    <div class="modal-hdr">
      <span class="modal-title">⚖️ Vente au poids</span>
      <button class="modal-close" onclick="closeModal('weigh-modal')">✕</button>
    </div>
    <div class="modal-body">
      <div class="box-opt-head">
        <img id="weigh-img" class="box-opt-img" alt="" onerror="this.style.display='none'">
        <div>
          <div class="box-opt-name" id="weigh-name"></div>
