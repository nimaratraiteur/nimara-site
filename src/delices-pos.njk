<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Délices POS">
<meta name="theme-color" content="#5B2C8D">
<title>Nimara Délices POS</title>
<link rel="manifest" href="/assets/manifest-delices.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#0e0b1a;--bg2:#1a1527;--bg3:#241d36;--bg4:#2d2545;
  --border:#332b52;--border2:#3d3460;
  --text:#f0ebff;--muted:#9d8cc4;--faint:#6b5f8a;
  --violet:#5B2C8D;--violet-l:#7c3aed;--violet-d:#3d1a6e;
  --lavender:#a78bfa;--lavender-l:#c4b5fd;
  --green:#10b981;--green-bg:rgba(16,185,129,.12);
  --orange:#f59e0b;--orange-bg:rgba(245,158,11,.12);
  --gold:#fbbf24;--gold-bg:rgba(251,191,36,.12);
  --red:#ef4444;--red-bg:rgba(239,68,68,.12);
  --radius:14px;--radius-sm:9px;
  --header-h:64px;--filter-h:56px;
  --shadow:0 4px 24px rgba(0,0,0,.4);
  --font:DM Sans,-apple-system,sans-serif;
}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:var(--font);-webkit-font-smoothing:antialiased}
body{display:flex;flex-direction:column}

/* ─── HEADER ─────────────────────────── */
#hdr{
  height:var(--header-h);flex-shrink:0;
  background:linear-gradient(135deg,var(--violet-d),var(--violet));
  display:flex;align-items:center;justify-content:space-between;
  padding:0 1.25rem;gap:1rem;
  box-shadow:0 2px 12px rgba(0,0,0,.5);position:relative;z-index:10;
}
#hdr-logo{display:flex;align-items:center;gap:.65rem;text-decoration:none;color:inherit}
#hdr-logo .badge{
  background:rgba(255,255,255,.18);backdrop-filter:blur(4px);
  border:1px solid rgba(255,255,255,.25);border-radius:8px;
  padding:.3rem .6rem;font-size:.7rem;font-weight:700;letter-spacing:.1em;color:#fff;
}
#hdr-logo .title{font-size:1.1rem;font-weight:700;color:#fff;line-height:1.2}
#hdr-logo .sub{font-size:.7rem;color:rgba(255,255,255,.7);font-weight:400}
#hdr-right{display:flex;align-items:center;gap:.75rem}
#mode-badge{
  font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  padding:.3rem .8rem;border-radius:20px;transition:all .2s;
}
#mode-badge.client{background:rgba(16,185,129,.2);color:#6ee7b7;border:1px solid rgba(16,185,129,.3)}
#mode-badge.staff{background:rgba(251,191,36,.2);color:#fbbf24;border:1px solid rgba(251,191,36,.3)}
#btn-toggle-mode{
  padding:.5rem 1rem;border-radius:var(--radius-sm);border:1px solid rgba(255,255,255,.25);
  background:rgba(255,255,255,.12);color:#fff;font-family:var(--font);font-size:.8rem;font-weight:600;
  cursor:pointer;transition:all .15s;white-space:nowrap;
}
#btn-toggle-mode:hover{background:rgba(255,255,255,.22)}
#btn-scan{
  width:38px;height:38px;border-radius:var(--radius-sm);border:1px solid rgba(255,255,255,.25);
  background:rgba(255,255,255,.12);color:#fff;font-size:1.1rem;
  cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;
}
#btn-scan:hover{background:rgba(255,255,255,.22)}

/* ─── FILTER BAR ─────────────────────── */
#filters{
  height:var(--filter-h);flex-shrink:0;
  background:var(--bg2);border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:.5rem;padding:0 1rem;overflow-x:auto;
  scrollbar-width:none;
}
#filters::-webkit-scrollbar{display:none}
.f-btn{
  height:34px;padding:0 .85rem;border-radius:20px;border:1px solid var(--border2);
  background:transparent;color:var(--muted);font-family:var(--font);font-size:.78rem;font-weight:500;
  cursor:pointer;white-space:nowrap;transition:all .15s;flex-shrink:0;
}
.f-btn:hover{border-color:var(--lavender);color:var(--lavender)}
.f-btn.active{background:var(--violet);border-color:var(--violet);color:#fff}
.f-sep{width:1px;height:22px;background:var(--border);flex-shrink:0;margin:0 .25rem}
.f-diet{height:34px;padding:0 .85rem;border-radius:20px;border:1px solid var(--border2);
  background:transparent;color:var(--muted);font-family:var(--font);font-size:.78rem;font-weight:500;
  cursor:pointer;white-space:nowrap;transition:all .15s;flex-shrink:0;display:flex;align-items:center;gap:.35rem;
}
.f-diet:hover{border-color:var(--lavender-l);color:var(--lavender-l)}
.f-diet.active{background:rgba(167,139,250,.15);border-color:var(--lavender);color:var(--lavender-l)}

/* ─── GRID AREA ──────────────────────── */
#grid-wrap{flex:1;overflow-y:auto;padding:1rem;overscroll-behavior:contain}
#grid-wrap::-webkit-scrollbar{width:4px}
#grid-wrap::-webkit-scrollbar-track{background:transparent}
#grid-wrap::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}
#grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:.875rem;
}
body.staff-view #grid{
  grid-template-columns:repeat(auto-fill,minmax(320px,1fr));
}

/* ─── PRODUCT CARD ───────────────────── */
.card{
  background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);
  overflow:hidden;transition:transform .15s,box-shadow .15s;
  display:flex;flex-direction:column;position:relative;
}
.card:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.card__img{width:100%;height:160px;object-fit:cover;display:block;background:var(--bg3)}
.card__img-ph{width:100%;height:160px;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:3rem}
.card__body{padding:.875rem;flex:1;display:flex;flex-direction:column;gap:.5rem}
.card__name{font-size:.95rem;font-weight:700;color:var(--text);line-height:1.25}
.card__unit{font-size:.7rem;color:var(--muted);font-weight:400}
.card__desc{font-size:.75rem;color:var(--muted);line-height:1.4;flex:1}
.card__price{font-size:1.05rem;font-weight:700;color:var(--lavender-l)}
.card__price-old{font-size:.8rem;color:var(--faint);text-decoration:line-through;margin-right:.35rem}
.card__price-sale{color:var(--gold)}
.card__badges{display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.35rem}
.badge-pill{
  font-size:.6rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  padding:.2rem .5rem;border-radius:10px;
}
.bp-sig{background:rgba(167,139,250,.15);color:var(--lavender-l)}
.bp-pop{background:rgba(245,158,11,.15);color:#fcd34d}
.bp-pre{background:rgba(251,191,36,.15);color:#fbbf24}
.bp-veg{background:rgba(16,185,129,.12);color:#6ee7b7}
.bp-vegan{background:rgba(52,211,153,.12);color:#34d399}
.bp-halal{background:rgba(99,179,237,.12);color:#93c5fd}
.bp-sale{background:var(--gold-bg);color:var(--gold)}
.bp-low{background:var(--orange-bg);color:var(--orange)}
.card__allergens{display:flex;flex-wrap:wrap;gap:.25rem;margin-top:.25rem}
.allergen-tag{font-size:.58rem;padding:.15rem .4rem;border-radius:6px;background:rgba(255,255,255,.06);color:var(--faint)}
.card__wa{
  display:flex;align-items:center;justify-content:center;gap:.4rem;
  margin-top:.5rem;padding:.6rem;border-radius:var(--radius-sm);
  background:rgba(37,211,102,.12);border:1px solid rgba(37,211,102,.2);
  color:#4ade80;font-size:.75rem;font-weight:600;text-decoration:none;
  transition:all .15s;
}
.card__wa:hover{background:rgba(37,211,102,.22)}

/* Card: rupture overlay in client mode */
.card.rupture-hidden{display:none}
.card.rupture-dim{opacity:.4;pointer-events:none}

/* Status ring on card */
.card .status-ring{
  position:absolute;top:.6rem;right:.6rem;width:10px;height:10px;border-radius:50%;
}
.sr-available{background:var(--green)}
.sr-low{background:var(--orange)}
.sr-sale{background:var(--gold)}
.sr-rupture{background:var(--red)}

/* ─── STAFF CARD EXTRAS ──────────────── */
.staff-controls{
  padding:.75rem .875rem;border-top:1px solid var(--border);
  background:var(--bg3);display:flex;flex-direction:column;gap:.6rem;
}
.status-btns{display:flex;gap:.4rem;flex-wrap:wrap}
.s-btn{
  flex:1;min-width:0;padding:.45rem .5rem;border-radius:var(--radius-sm);
  border:1px solid transparent;font-family:var(--font);font-size:.68rem;font-weight:600;
  cursor:pointer;transition:all .15s;white-space:nowrap;text-align:center;
}
.s-btn.av{background:var(--green-bg);border-color:rgba(16,185,129,.3);color:var(--green)}
.s-btn.lw{background:var(--orange-bg);border-color:rgba(245,158,11,.3);color:var(--orange)}
.s-btn.sl{background:var(--gold-bg);border-color:rgba(251,191,36,.3);color:var(--gold)}
.s-btn.ru{background:var(--red-bg);border-color:rgba(239,68,68,.3);color:var(--red)}
.s-btn.active-av{background:var(--green);color:#fff}
.s-btn.active-lw{background:var(--orange);color:#fff}
.s-btn.active-sl{background:var(--gold);color:#000}
.s-btn.active-ru{background:var(--red);color:#fff}
.s-btn:hover{filter:brightness(1.1)}

.qty-row{display:flex;align-items:center;gap:.5rem}
.qty-label{font-size:.7rem;color:var(--muted);font-weight:500;flex:1}
.qty-ctrl{display:flex;align-items:center;gap:.4rem}
.qty-btn{
  width:32px;height:32px;border-radius:50%;border:1px solid var(--border2);
  background:var(--bg4);color:var(--text);font-size:1.1rem;font-weight:700;
  cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;
}
.qty-btn:hover{background:var(--violet);border-color:var(--violet)}
.qty-num{min-width:32px;text-align:center;font-size:.95rem;font-weight:700;color:var(--lavender-l)}

.barcode-btn{
  padding:.4rem .75rem;border-radius:var(--radius-sm);border:1px solid var(--border2);
  background:transparent;color:var(--muted);font-family:var(--font);font-size:.7rem;font-weight:500;
  cursor:pointer;transition:all .15s;align-self:flex-start;
}
.barcode-btn:hover{border-color:var(--lavender);color:var(--lavender)}

/* ─── STAFF FOOTER ───────────────────── */
#staff-bar{
  flex-shrink:0;height:52px;
  background:var(--bg2);border-top:1px solid var(--border);
  display:none;align-items:center;padding:0 1.25rem;gap:.75rem;
}
body.staff-view #staff-bar{display:flex}
.sbar-btn{
  padding:.45rem 1rem;border-radius:var(--radius-sm);
  border:1px solid var(--border2);background:transparent;
  color:var(--muted);font-family:var(--font);font-size:.78rem;font-weight:500;
  cursor:pointer;display:flex;align-items:center;gap:.4rem;transition:all .15s;
}
.sbar-btn:hover{border-color:var(--lavender);color:var(--lavender)}
.sbar-btn.danger:hover{border-color:var(--red);color:var(--red)}
#sbar-stats{
  margin-left:auto;font-size:.75rem;color:var(--muted);
  display:flex;gap:1rem;align-items:center;
}
.stat-pill{display:flex;align-items:center;gap:.3rem;font-size:.72rem}
.sp-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}

/* ─── MODALS ─────────────────────────── */
.modal-overlay{
  position:fixed;inset:0;z-index:100;
  background:rgba(14,11,26,.85);backdrop-filter:blur(6px);
  display:flex;align-items:center;justify-content:center;
  animation:fadeIn .15s;
}
.modal-overlay.hidden{display:none}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

.modal-box{
  background:var(--bg2);border:1px solid var(--border);border-radius:20px;
  box-shadow:0 20px 60px rgba(0,0,0,.6);padding:2rem;
  width:90%;max-width:440px;animation:slideUp .2s;
}
@keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}

/* PIN Modal */
#pin-modal .modal-box{text-align:center;max-width:360px}
.pin-logo{font-size:2rem;margin-bottom:.5rem}
.pin-title{font-size:1.1rem;font-weight:700;margin-bottom:.25rem;color:var(--text)}
.pin-sub{font-size:.8rem;color:var(--muted);margin-bottom:1.5rem}
.pin-dots{display:flex;justify-content:center;gap:.75rem;margin-bottom:1.5rem}
.pin-dot{
  width:14px;height:14px;border-radius:50%;
  border:2px solid var(--border2);background:transparent;transition:all .15s;
}
.pin-dot.filled{background:var(--lavender);border-color:var(--lavender)}
.pin-dot.error{background:var(--red);border-color:var(--red)}
.pin-dot.ok{background:var(--green);border-color:var(--green)}
.pin-pad{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;max-width:260px;margin:0 auto}
.pin-key{
  aspect-ratio:1;border-radius:var(--radius-sm);border:1px solid var(--border2);
  background:var(--bg3);color:var(--text);font-family:var(--font);
  font-size:1.3rem;font-weight:600;cursor:pointer;transition:all .15s;
  display:flex;align-items:center;justify-content:center;
}
.pin-key:hover{background:var(--bg4);border-color:var(--lavender)}
.pin-key:active{transform:scale(.95);background:var(--violet)}
.pin-key.clr{font-size:.8rem;color:var(--muted)}
.pin-key.back{font-size:1.1rem}
.pin-cancel{margin-top:1rem;font-size:.78rem;color:var(--muted);background:none;border:none;cursor:pointer;font-family:var(--font)}
.pin-cancel:hover{color:var(--text)}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
.shake{animation:shake .3s}

/* Barcode Modal */
#barcode-modal .modal-box{text-align:center;max-width:400px}
#barcode-title{font-size:1rem;font-weight:700;margin-bottom:.25rem}
#barcode-unit{font-size:.75rem;color:var(--muted);margin-bottom:1.25rem}
#barcode-svg{display:block;margin:0 auto;max-width:100%;border-radius:8px;overflow:hidden}
#barcode-code{font-size:.7rem;color:var(--muted);margin-top:.75rem;font-family:monospace}
.modal-close{
  margin-top:1.25rem;padding:.55rem 1.5rem;border-radius:var(--radius-sm);
  border:1px solid var(--border2);background:transparent;
  color:var(--muted);font-family:var(--font);font-size:.82rem;cursor:pointer;transition:all .15s;
}
.modal-close:hover{border-color:var(--lavender);color:var(--lavender)}

/* Scanner Modal */
#scanner-modal .modal-box{max-width:500px;padding:1.5rem}
#scanner-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}
#scanner-header h2{font-size:1rem;font-weight:700}
#scanner-video-wrap{
  border-radius:var(--radius-sm);overflow:hidden;background:var(--bg3);
  min-height:280px;position:relative;
}
#scanner-video-wrap #qr-reader{width:100%}
#scanner-video-wrap #qr-reader video{border-radius:var(--radius-sm)}
#scanner-result{
  margin-top:1rem;padding:.875rem;border-radius:var(--radius-sm);
  background:var(--bg3);border:1px solid var(--border);display:none;
}
#scanner-result.visible{display:block;animation:fadeIn .2s}
#scanner-result .sr-name{font-weight:700;font-size:.95rem;margin-bottom:.25rem}
#scanner-result .sr-info{font-size:.75rem;color:var(--muted)}
#scanner-result .sr-sold{font-size:.78rem;color:var(--green);margin-top:.4rem;font-weight:600}
#scanner-tip{font-size:.72rem;color:var(--muted);text-align:center;margin-top:.75rem}

/* Summary Modal */
#summary-modal .modal-box{max-width:560px;max-height:80vh;overflow-y:auto;padding:1.5rem}
#summary-modal h2{font-size:1.1rem;font-weight:700;margin-bottom:1.25rem;padding-bottom:.75rem;border-bottom:1px solid var(--border)}
.sum-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:.5rem;margin-bottom:1.25rem}
.sum-stat{
  background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius-sm);
  padding:.875rem;text-align:center;
}
.sum-stat .val{font-size:1.8rem;font-weight:700;line-height:1}
.sum-stat .lbl{font-size:.68rem;color:var(--muted);margin-top:.3rem;text-transform:uppercase;letter-spacing:.06em}
.sum-table{width:100%;border-collapse:collapse;font-size:.78rem}
.sum-table th{color:var(--muted);font-weight:600;text-align:left;padding:.4rem .5rem;border-bottom:1px solid var(--border);font-size:.68rem;text-transform:uppercase}
.sum-table td{padding:.5rem;border-bottom:1px solid rgba(255,255,255,.04);vertical-align:middle}
.sum-table tr:last-child td{border-bottom:none}
.st-status{display:inline-block;padding:.15rem .45rem;border-radius:6px;font-size:.65rem;font-weight:700}
.st-av{background:var(--green-bg);color:var(--green)}
.st-lw{background:var(--orange-bg);color:var(--orange)}
.st-sl{background:var(--gold-bg);color:var(--gold)}
.st-ru{background:var(--red-bg);color:var(--red)}
.sum-actions{display:flex;gap:.5rem;margin-top:1.25rem;flex-wrap:wrap}
.sum-actions button{flex:1;padding:.6rem;border-radius:var(--radius-sm);font-family:var(--font);font-size:.78rem;font-weight:600;cursor:pointer;transition:all .15s}
#btn-export{background:var(--violet);border:none;color:#fff}
#btn-export:hover{background:var(--violet-l)}
#btn-reset-confirm{background:var(--red-bg);border:1px solid rgba(239,68,68,.3);color:var(--red)}
#btn-reset-confirm:hover{background:var(--red);color:#fff}

/* Empty state */
#empty{
  grid-column:1/-1;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:3rem;color:var(--faint);text-align:center;gap:.5rem;
}
#empty .em-icon{font-size:3rem}
#empty .em-msg{font-size:.85rem}

/* Scan result toast */
#scan-toast{
  position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%);
  background:var(--bg2);border:1px solid var(--green);border-radius:var(--radius);
  padding:.875rem 1.25rem;box-shadow:var(--shadow);z-index:200;
  display:none;animation:slideUp .2s;min-width:280px;max-width:90vw;
}
#scan-toast.visible{display:block}
#scan-toast .t-name{font-weight:700;font-size:.9rem;margin-bottom:.25rem;color:var(--text)}
#scan-toast .t-info{font-size:.75rem;color:var(--muted)}
#scan-toast .t-action{font-size:.75rem;color:var(--green);font-weight:600;margin-top:.35rem}

/* Scrollbar global */
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}

/* Responsive */
@media(max-width:600px){
  #grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
  body.staff-view #grid{grid-template-columns:1fr}
  .status-btns{flex-wrap:wrap}
}
@media(min-width:1024px){
  #grid{grid-template-columns:repeat(auto-fill,minmax(230px,1fr))}
  body.staff-view #grid{grid-template-columns:repeat(auto-fill,minmax(340px,1fr))}
}
</style>
</head>
<body>

<!-- ══ PIN MODAL ════════════════════════════════════ -->
<div id="pin-modal" class="modal-overlay hidden">
  <div class="modal-box">
    <div class="pin-logo">🔐</div>
    <div class="pin-title">Mode Vendeuse</div>
    <div class="pin-sub">Entrez votre code PIN à 4 chiffres</div>
    <div class="pin-dots">
      <div class="pin-dot" id="pd0"></div>
      <div class="pin-dot" id="pd1"></div>
      <div class="pin-dot" id="pd2"></div>
      <div class="pin-dot" id="pd3"></div>
    </div>
    <div class="pin-pad">
      <button class="pin-key" onclick="pinKey('1')">1</button>
      <button class="pin-key" onclick="pinKey('2')">2</button>
      <button class="pin-key" onclick="pinKey('3')">3</button>
      <button class="pin-key" onclick="pinKey('4')">4</button>
      <button class="pin-key" onclick="pinKey('5')">5</button>
      <button class="pin-key" onclick="pinKey('6')">6</button>
      <button class="pin-key" onclick="pinKey('7')">7</button>
      <button class="pin-key" onclick="pinKey('8')">8</button>
      <button class="pin-key" onclick="pinKey('9')">9</button>
      <button class="pin-key clr" onclick="pinClear()">Effacer</button>
      <button class="pin-key" onclick="pinKey('0')">0</button>
      <button class="pin-key back" onclick="pinBack()">⌫</button>
    </div>
    <button class="pin-cancel" onclick="closePinModal()">Annuler</button>
  </div>
</div>

<!-- ══ BARCODE MODAL ═════════════════════════════════ -->
<div id="barcode-modal" class="modal-overlay hidden">
  <div class="modal-box">
    <div id="barcode-title">Produit</div>
    <div id="barcode-unit"></div>
    <svg id="barcode-svg"></svg>
    <div id="barcode-code"></div>
    <button class="modal-close" onclick="closeBarcodeModal()">Fermer</button>
  </div>
</div>

<!-- ══ SCANNER MODAL ════════════════════════════════= -->
<div id="scanner-modal" class="modal-overlay hidden">
  <div class="modal-box">
    <div id="scanner-header">
      <h2>📷 Scanner un produit</h2>
      <button class="modal-close" style="margin:0" onclick="closeScanner()">✕</button>
    </div>
    <div id="scanner-video-wrap">
      <div id="qr-reader"></div>
    </div>
    <div id="scanner-result">
      <div class="sr-name" id="sr-name"></div>
      <div class="sr-info" id="sr-info"></div>
      <div class="sr-sold" id="sr-sold"></div>
    </div>
    <div id="scanner-tip">Pointez la caméra vers le code-barres du produit</div>
  </div>
</div>

<!-- ══ SUMMARY MODAL ════════════════════════════════= -->
<div id="summary-modal" class="modal-overlay hidden">
  <div class="modal-box">
    <h2 id="summary-title">Bilan du jour</h2>
    <div class="sum-stats" id="sum-stats"></div>
    <table class="sum-table">
      <thead>
        <tr>
          <th>Produit</th>
          <th>Statut</th>
          <th>Stock</th>
        </tr>
      </thead>
      <tbody id="sum-tbody"></tbody>
    </table>
    <div class="sum-actions">
      <button id="btn-export" onclick="exportSummary()">⬇ Exporter</button>
      <button id="btn-reset-confirm" onclick="confirmReset()">🔄 Reset journée</button>
      <button class="modal-close" style="flex:none;margin:0;min-width:80px" onclick="closeSummary()">Fermer</button>
    </div>
  </div>
</div>

<!-- ══ SCAN TOAST ════════════════════════════════════ -->
<div id="scan-toast">
  <div class="t-name" id="toast-name"></div>
  <div class="t-info" id="toast-info"></div>
  <div class="t-action" id="toast-action"></div>
</div>

<!-- ══ HEADER ════════════════════════════════════════ -->
<header id="hdr">
  <div id="hdr-logo">
    <span class="badge">NIMARA</span>
    <div>
      <div class="title">Rue des Délices</div>
      <div class="sub">Point de vente</div>
    </div>
  </div>
  <div id="hdr-right">
    <span id="mode-badge" class="client">Client</span>
    <button id="btn-scan" onclick="openScanner()" title="Scanner un produit" style="display:none">📷</button>
    <button id="btn-toggle-mode" onclick="handleModeToggle()">Mode Vendeuse</button>
  </div>
</header>

<!-- ══ FILTER BAR ════════════════════════════════════ -->
<div id="filters">
  <button class="f-btn active" data-cat="all" onclick="setCategory('all')">🍽 Tout</button>
  <button class="f-btn" data-cat="sucre" onclick="setCategory('sucre')">🍰 Douceurs</button>
  <button class="f-btn" data-cat="sale" onclick="setCategory('sale')">🍛 Saveurs du Monde</button>
  <button class="f-btn" data-cat="formules" onclick="setCategory('formules')">🎉 Formules</button>
  <div class="f-sep"></div>
  <button class="f-diet" id="f-veg" onclick="toggleDiet('vegetarian')">🌱 Végétarien</button>
  <button class="f-diet" id="f-vegan" onclick="toggleDiet('vegan')">🌿 Vegan</button>
  <button class="f-diet" id="f-halal" onclick="toggleDiet('halal')">☪ Halal</button>
</div>

<!-- ══ PRODUCT GRID ══════════════════════════════════ -->
<div id="grid-wrap">
  <div id="grid"></div>
</div>

<!-- ══ STAFF FOOTER ══════════════════════════════════ -->
<div id="staff-bar">
  <button class="sbar-btn" onclick="openSummary()">📊 Bilan journalier</button>
  <div id="sbar-stats"></div>
</div>

<!-- ══ CDN SCRIPTS ═══════════════════════════════════ -->
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

<!-- ══ APP SCRIPT ════════════════════════════════════ -->
<script>
// ─── DATA (injected at build time from menu.json) ────────────────────────────
const PRODUCTS = {{ menu.products | dump | safe }};
const CATEGORIES = {{ menu.categories | dump | safe }};
const WA_NUM = '{{ site.whatsapp }}';

// ─── ALLERGEN ICONS ──────────────────────────────────────────────────────────
const ALLERGEN_ICONS = {
  gluten: '🌾',
  lactose: '🥛',
  oeufs: '🥚',
  fruits_a_coque: '🥜',
  sesame: '🌰',
};
const ALLERGEN_LABELS = {
  gluten: 'Gluten', lactose: 'Lactose', oeufs: 'Œufs',
  fruits_a_coque: 'Fruits à coque', sesame: 'Sésame',
};

// ─── STATE ────────────────────────────────────────────────────────────────────
const STATE_KEY = 'nimara_pos_stock';
const LOG_KEY   = 'nimara_pos_sales';

let mode = 'client';   // 'client' | 'staff'
let filters = { category: 'all', vegetarian: false, vegan: false, halal: false };
let stock = {};        // { [id]: { status, quantity, salePercent } }
let salesLog = [];     // [{ productId, ts }]
let scanner = null;
let pinBuffer = '';
const PIN = '1234';

// ── Load / init stock ────────────────────────────────────────────────────────
function loadState() {
  try {
    const saved = localStorage.getItem(STATE_KEY);
    if (saved) {
      stock = JSON.parse(saved);
      // Merge in any new products not yet in saved state
      PRODUCTS.forEach(p => {
        if (!stock[p.id]) stock[p.id] = { status: 'available', quantity: p.batch, salePercent: 30 };
      });
    } else {
      initStock();
    }
  } catch (_) { initStock(); }

  try {
    const savedLog = localStorage.getItem(LOG_KEY);
    salesLog = savedLog ? JSON.parse(savedLog) : [];
  } catch (_) { salesLog = []; }
}

function initStock() {
  stock = {};
  PRODUCTS.forEach(p => {
    stock[p.id] = { status: 'available', quantity: p.batch, salePercent: 30 };
  });
}

function saveStock() {
  localStorage.setItem(STATE_KEY, JSON.stringify(stock));
}

function saveSalesLog() {
  localStorage.setItem(LOG_KEY, JSON.stringify(salesLog));
}

// ─── BARCODE HELPERS ──────────────────────────────────────────────────────────
function productBarcode(p) {
  return 'NIM' + String(p.id).padStart(4, '0');
}

function findProductByBarcode(code) {
  return PRODUCTS.find(p => productBarcode(p) === code) || null;
}

// ─── FILTERING ────────────────────────────────────────────────────────────────
function visibleProducts() {
  return PRODUCTS.filter(p => {
    if (filters.category !== 'all' && p.category !== filters.category) return false;
    if (filters.vegetarian && !p.vegetarian) return false;
    if (filters.vegan && !p.vegan) return false;
    if (filters.halal && !p.halal) return false;
    return true;
  });
}

// ─── RENDER ───────────────────────────────────────────────────────────────────
function render() {
  const grid = document.getElementById('grid');
  const products = visibleProducts();

  if (!products.length) {
    grid.innerHTML = '<div id="empty"><div class="em-icon">🔍</div><div class="em-msg">Aucun produit ne correspond aux filtres sélectionnés.</div></div>';
    return;
  }

  grid.innerHTML = products.map(p => renderCard(p)).join('');
  updateStaffBar();
}

function renderCard(p) {
  const s = stock[p.id] || { status: 'available', quantity: p.batch, salePercent: 30 };
  const isStaff = mode === 'staff';
  const isRupture = s.status === 'rupture';
  const isSale = s.status === 'sale';
  const isLow = s.status === 'low';

  // In client mode: hide rupture products
  if (!isStaff && isRupture) return '';

  // Price display
  const basePrice = 'CHF ' + p.price.toFixed(2);
  let priceHtml;
  if (isSale) {
    const discounted = p.price * (1 - s.salePercent / 100);
    priceHtml = '<span class="card__price-old">' + basePrice + '</span><span class="card__price card__price-sale">CHF ' + discounted.toFixed(2) + ' <span class="badge-pill bp-sale">-' + s.salePercent + '%</span></span>';
  } else {
    priceHtml = '<span class="card__price">' + basePrice + '</span>';
  }

  // Badges
  const badges = [];
  if (p.badges && p.badges.includes('signature')) badges.push('<span class="badge-pill bp-sig">💫 Signature</span>');
  if (p.badges && p.badges.includes('populaire')) badges.push('<span class="badge-pill bp-pop">⭐ Populaire</span>');
  if (p.badges && p.badges.includes('prestige')) badges.push('<span class="badge-pill bp-pre">👑 Prestige</span>');
  if (p.vegetarian && !p.vegan) badges.push('<span class="badge-pill bp-veg">🌱 Végé</span>');
  if (p.vegan) badges.push('<span class="badge-pill bp-vegan">🌿 Vegan</span>');
  if (p.halal) badges.push('<span class="badge-pill bp-halal">☪ Halal</span>');
  if (isLow && !isStaff) badges.push('<span class="badge-pill bp-low">⚠️ Dernières pièces</span>');

  // Allergens
  const allergenHtml = p.allergens.length
    ? '<div class="card__allergens">' + p.allergens.map(a => '<span class="allergen-tag" title="' + (ALLERGEN_LABELS[a] || a) + '">' + (ALLERGEN_ICONS[a] || '⚠') + ' ' + (ALLERGEN_LABELS[a] || a) + '</span>').join('') + '</div>'
    : '';

  // Status ring
  const ringClass = { available:'sr-available', low:'sr-low', sale:'sr-sale', rupture:'sr-rupture' }[s.status] || 'sr-available';

  // Image
  const imgHtml = p.image
    ? '<img class="card__img" src="' + p.image + '" alt="' + p.name.fr + '" loading="lazy" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'">' +
      '<div class="card__img-ph" style="display:none">' + (CATEGORIES.find(c => c.id === p.category) || {}).icon + '</div>'
    : '<div class="card__img-ph">' + ((CATEGORIES.find(c => c.id === p.category) || {}).icon || '🍽') + '</div>';

  // WhatsApp CTA (client mode only)
  const waMsg = encodeURIComponent('Bonjour Nimara, je souhaite commander : ' + p.name.fr);
  const waHtml = !isStaff
    ? '<a class="card__wa" href="https://wa.me/' + WA_NUM + '?text=' + waMsg + '" target="_blank" rel="noopener">📱 Commander</a>'
    : '';

  // Staff controls
  const staffCtrl = isStaff ? renderStaffControls(p, s) : '';

  const dimClass = !isStaff && isRupture ? ' rupture-dim' : '';

  return '<div class="card' + dimClass + '" id="card-' + p.id + '">' +
    '<div class="status-ring ' + ringClass + '"></div>' +
    imgHtml +
    '<div class="card__body">' +
      '<div class="card__name">' + p.name.fr + '<span class="card__unit"> · ' + p.unit + '</span></div>' +
      '<div class="card__desc">' + p.description.fr + '</div>' +
      '<div>' + priceHtml + '</div>' +
      (badges.length ? '<div class="card__badges">' + badges.join('') + '</div>' : '') +
      allergenHtml +
      waHtml +
    '</div>' +
    staffCtrl +
  '</div>';
}

function renderStaffControls(p, s) {
  const av = s.status === 'available';
  const lw = s.status === 'low';
  const sl = s.status === 'sale';
  const ru = s.status === 'rupture';

  return '<div class="staff-controls">' +
    '<div class="status-btns">' +
      '<button class="s-btn av' + (av ? ' active-av' : '') + '" onclick="setStatus(' + p.id + ',\'available\')">✅ Dispo</button>' +
      '<button class="s-btn lw' + (lw ? ' active-lw' : '') + '" onclick="setStatus(' + p.id + ',\'low\')">⚠️ Fin</button>' +
      '<button class="s-btn sl' + (sl ? ' active-sl' : '') + '" onclick="setStatus(' + p.id + ',\'sale\')">🏷️ -30%</button>' +
      '<button class="s-btn ru' + (ru ? ' active-ru' : '') + '" onclick="setStatus(' + p.id + ',\'rupture\')">❌ Rupture</button>' +
    '</div>' +
    '<div class="qty-row">' +
      '<span class="qty-label">Stock</span>' +
      '<div class="qty-ctrl">' +
        '<button class="qty-btn" onclick="adjustQty(' + p.id + ',-1)">−</button>' +
        '<span class="qty-num" id="qty-' + p.id + '">' + s.quantity + '</span>' +
        '<button class="qty-btn" onclick="adjustQty(' + p.id + ',1)">+</button>' +
      '</div>' +
    '</div>' +
    '<button class="barcode-btn" onclick="showBarcode(' + p.id + ')">🔡 Code-barres</button>' +
  '</div>';
}

function updateStaffBar() {
  const avCount  = PRODUCTS.filter(p => stock[p.id]?.status === 'available').length;
  const lwCount  = PRODUCTS.filter(p => stock[p.id]?.status === 'low').length;
  const slCount  = PRODUCTS.filter(p => stock[p.id]?.status === 'sale').length;
  const ruCount  = PRODUCTS.filter(p => stock[p.id]?.status === 'rupture').length;
  const todaySold = todaySalesCount();

  document.getElementById('sbar-stats').innerHTML =
    '<span class="stat-pill"><span class="sp-dot" style="background:var(--green)"></span>' + avCount + ' dispos</span>' +
    '<span class="stat-pill"><span class="sp-dot" style="background:var(--orange)"></span>' + lwCount + ' fin</span>' +
    '<span class="stat-pill"><span class="sp-dot" style="background:var(--red)"></span>' + ruCount + ' rupture</span>' +
    '<span class="stat-pill"><span class="sp-dot" style="background:var(--lavender)"></span>' + todaySold + ' vendus</span>';
}

function todaySalesCount() {
  const today = new Date().toDateString();
  return salesLog.filter(s => new Date(s.ts).toDateString() === today).length;
}

// ─── FILTERS ─────────────────────────────────────────────────────────────────
function setCategory(cat) {
  filters.category = cat;
  document.querySelectorAll('.f-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.cat === cat);
  });
  render();
}

function toggleDiet(key) {
  filters[key] = !filters[key];
  const btn = document.getElementById('f-' + (key === 'vegetarian' ? 'veg' : key));
  if (btn) btn.classList.toggle('active', filters[key]);
  render();
}

// ─── MODE TOGGLE ─────────────────────────────────────────────────────────────
function handleModeToggle() {
  if (mode === 'client') {
    openPinModal();
  } else {
    exitStaffMode();
  }
}

function enterStaffMode() {
  mode = 'staff';
  document.body.classList.add('staff-view');
  document.getElementById('mode-badge').className = 'staff';
  document.getElementById('mode-badge').textContent = 'Vendeuse';
  document.getElementById('btn-toggle-mode').textContent = 'Mode Client';
  document.getElementById('btn-scan').style.display = 'flex';
  render();
}

function exitStaffMode() {
  mode = 'client';
  document.body.classList.remove('staff-view');
  document.getElementById('mode-badge').className = 'client';
  document.getElementById('mode-badge').textContent = 'Client';
  document.getElementById('btn-toggle-mode').textContent = 'Mode Vendeuse';
  document.getElementById('btn-scan').style.display = 'none';
  render();
}

// ─── PIN MODAL ────────────────────────────────────────────────────────────────
function openPinModal() {
  pinBuffer = '';
  updatePinDots();
  document.getElementById('pin-modal').classList.remove('hidden');
}

function closePinModal() {
  pinBuffer = '';
  document.getElementById('pin-modal').classList.add('hidden');
}

function pinKey(digit) {
  if (pinBuffer.length >= 4) return;
  pinBuffer += digit;
  updatePinDots();
  if (pinBuffer.length === 4) {
    setTimeout(checkPin, 100);
  }
}

function pinBack() {
  pinBuffer = pinBuffer.slice(0, -1);
  updatePinDots();
}

function pinClear() {
  pinBuffer = '';
  updatePinDots();
}

function updatePinDots() {
  for (let i = 0; i < 4; i++) {
    const dot = document.getElementById('pd' + i);
    dot.className = 'pin-dot' + (i < pinBuffer.length ? ' filled' : '');
  }
}

function checkPin() {
  if (pinBuffer === PIN) {
    for (let i = 0; i < 4; i++) document.getElementById('pd' + i).className = 'pin-dot ok';
    setTimeout(() => {
      closePinModal();
      enterStaffMode();
    }, 400);
  } else {
    for (let i = 0; i < 4; i++) document.getElementById('pd' + i).className = 'pin-dot error';
    const box = document.querySelector('#pin-modal .modal-box');
    box.classList.add('shake');
    setTimeout(() => { box.classList.remove('shake'); pinBuffer = ''; updatePinDots(); }, 500);
  }
}

// ─── STOCK ACTIONS ────────────────────────────────────────────────────────────
function setStatus(productId, status) {
  if (!stock[productId]) return;
  stock[productId].status = status;
  saveStock();
  // Update just the card
  const card = document.getElementById('card-' + productId);
  if (card) {
    const p = PRODUCTS.find(x => x.id === productId);
    if (p) card.outerHTML = renderCard(p);
  }
  updateStaffBar();
}

function adjustQty(productId, delta) {
  if (!stock[productId]) return;
  const newQty = Math.max(0, stock[productId].quantity + delta);
  stock[productId].quantity = newQty;
  if (newQty === 0 && stock[productId].status !== 'rupture') {
    stock[productId].status = 'rupture';
  }
  saveStock();
  const qtyEl = document.getElementById('qty-' + productId);
  if (qtyEl) qtyEl.textContent = newQty;
  updateStaffBar();
}

function markSold(productId) {
  adjustQty(productId, -1);
  salesLog.push({ productId, ts: Date.now() });
  saveSalesLog();
  updateStaffBar();
}

// ─── BARCODE MODAL ────────────────────────────────────────────────────────────
function showBarcode(productId) {
  const p = PRODUCTS.find(x => x.id === productId);
  if (!p) return;
  const code = productBarcode(p);

  document.getElementById('barcode-title').textContent = p.name.fr;
  document.getElementById('barcode-unit').textContent = p.unit + ' · ' + 'CHF ' + p.price.toFixed(2);
  document.getElementById('barcode-code').textContent = code;

  // Clear previous barcode
  const svg = document.getElementById('barcode-svg');
  svg.innerHTML = '';

  document.getElementById('barcode-modal').classList.remove('hidden');

  // Render barcode after DOM update
  requestAnimationFrame(() => {
    try {
      JsBarcode('#barcode-svg', code, {
        format: 'CODE128',
        lineColor: '#f0ebff',
        background: '#1a1527',
        width: 2.5,
        height: 90,
        displayValue: true,
        font: 'DM Sans, sans-serif',
        fontSize: 14,
        margin: 16,
      });
    } catch(e) {
      svg.innerHTML = '<text fill="#9d8cc4" style="font-size:14px">' + code + '</text>';
    }
  });
}

function closeBarcodeModal() {
  document.getElementById('barcode-modal').classList.add('hidden');
}

// ─── SCANNER ─────────────────────────────────────────────────────────────────
function openScanner() {
  if (mode !== 'staff') return;
  document.getElementById('scanner-modal').classList.remove('hidden');
  document.getElementById('scanner-result').style.display = 'none';

  if (typeof Html5Qrcode === 'undefined') {
    document.getElementById('scanner-tip').textContent = 'Librairie de scan non disponible. Vérifiez la connexion internet.';
    return;
  }

  scanner = new Html5Qrcode('qr-reader');
  scanner.start(
    { facingMode: 'environment' },
    { fps: 10, qrbox: { width: 240, height: 180 } },
    (decodedText) => { handleBarcodeScan(decodedText); },
    () => {}
  ).catch(err => {
    document.getElementById('scanner-tip').textContent = 'Caméra non accessible : ' + err;
  });
}

function closeScanner() {
  document.getElementById('scanner-modal').classList.add('hidden');
  if (scanner) {
    scanner.stop().catch(() => {}).finally(() => { scanner = null; });
  }
}

function handleBarcodeScan(code) {
  const p = findProductByBarcode(code);
  const resultEl = document.getElementById('scanner-result');

  if (p) {
    document.getElementById('sr-name').textContent = p.name.fr;
    document.getElementById('sr-info').textContent = 'CHF ' + p.price.toFixed(2) + ' · ' + p.unit;
    document.getElementById('sr-sold').textContent = '✅ Vendu — stock mis à jour';
    resultEl.style.display = 'block';
    markSold(p.id);

    // Show toast and close scanner after 1.5s
    showToast(p, 'vendu');
    setTimeout(closeScanner, 1500);
  } else {
    document.getElementById('sr-name').textContent = 'Code non reconnu';
    document.getElementById('sr-info').textContent = code;
    document.getElementById('sr-sold').textContent = '';
    resultEl.style.display = 'block';
  }
}

// ─── TOAST ────────────────────────────────────────────────────────────────────
let toastTimer = null;
function showToast(p, action) {
  const s = stock[p.id];
  document.getElementById('toast-name').textContent = p.name.fr;
  document.getElementById('toast-info').textContent = 'CHF ' + p.price.toFixed(2) + ' · stock restant: ' + (s ? s.quantity : '?');
  document.getElementById('toast-action').textContent = action === 'vendu' ? '✅ Article marqué comme vendu' : '';
  const toast = document.getElementById('scan-toast');
  toast.classList.add('visible');
  if (toastTimer) clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove('visible'), 3000);
}

// ─── SUMMARY MODAL ────────────────────────────────────────────────────────────
function openSummary() {
  const today = new Date().toDateString();
  const soldToday = salesLog.filter(s => new Date(s.ts).toDateString() === today);
  const avCount  = PRODUCTS.filter(p => stock[p.id]?.status === 'available').length;
  const lwCount  = PRODUCTS.filter(p => stock[p.id]?.status === 'low').length;
  const slCount  = PRODUCTS.filter(p => stock[p.id]?.status === 'sale').length;
  const ruCount  = PRODUCTS.filter(p => stock[p.id]?.status === 'rupture').length;

  document.getElementById('summary-title').textContent =
    'Bilan — ' + new Date().toLocaleDateString('fr-CH', { day:'numeric', month:'long' });

  document.getElementById('sum-stats').innerHTML =
    stat(avCount, '✅', 'Disponibles', '#10b981') +
    stat(lwCount, '⚠️', 'Dernières pièces', '#f59e0b') +
    stat(ruCount, '❌', 'Rupture', '#ef4444') +
    stat(soldToday.length, '📦', 'Vendus aujourd\'hui', '#a78bfa');

  // Table
  const tbody = document.getElementById('sum-tbody');
  tbody.innerHTML = PRODUCTS.map(p => {
    const s = stock[p.id] || { status:'available', quantity: p.batch };
    const sLabel = { available:'✅ Dispo', low:'⚠️ Fin', sale:'🏷 Soldé', rupture:'❌ Rupture' }[s.status] || s.status;
    const sClass = { available:'st-av', low:'st-lw', sale:'st-sl', rupture:'st-ru' }[s.status] || 'st-av';
    return '<tr>' +
      '<td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + p.name.fr + '</td>' +
      '<td><span class="st-status ' + sClass + '">' + sLabel + '</span></td>' +
      '<td style="text-align:right;font-weight:600">' + s.quantity + '</td>' +
    '</tr>';
  }).join('');

  document.getElementById('summary-modal').classList.remove('hidden');
}

function stat(val, icon, label, color) {
  return '<div class="sum-stat"><div class="val" style="color:' + color + '">' + icon + ' ' + val + '</div><div class="lbl">' + label + '</div></div>';
}

function closeSummary() {
  document.getElementById('summary-modal').classList.add('hidden');
}

function exportSummary() {
  const today = new Date();
  const dateStr = today.toLocaleDateString('fr-CH');
  const soldToday = salesLog.filter(s => new Date(s.ts).toDateString() === today.toDateString());

  let txt = '=== BILAN JOURNALIER NIMARA ===\n';
  txt += 'Date : ' + dateStr + '\n';
  txt += 'Heure : ' + today.toLocaleTimeString('fr-CH') + '\n\n';

  const avCount  = PRODUCTS.filter(p => stock[p.id]?.status === 'available').length;
  const lwCount  = PRODUCTS.filter(p => stock[p.id]?.status === 'low').length;
  const slCount  = PRODUCTS.filter(p => stock[p.id]?.status === 'sale').length;
  const ruCount  = PRODUCTS.filter(p => stock[p.id]?.status === 'rupture').length;

  txt += '--- RÉSUMÉ ---\n';
  txt += '✅ Disponibles     : ' + avCount + '\n';
  txt += '⚠️ Dernières pièces: ' + lwCount + '\n';
  txt += '🏷️ Soldés          : ' + slCount + '\n';
  txt += '❌ Rupture         : ' + ruCount + '\n';
  txt += '📦 Vendus/jour     : ' + soldToday.length + '\n\n';

  txt += '--- DÉTAIL PRODUITS ---\n';
  PRODUCTS.forEach(p => {
    const s = stock[p.id] || { status:'available', quantity:p.batch };
    const icon = { available:'✅', low:'⚠️', sale:'🏷️', rupture:'❌' }[s.status] || '•';
    txt += icon + ' ' + p.name.fr.padEnd(35) + ' | Qté: ' + String(s.quantity).padStart(3) + ' | ' + s.status + '\n';
  });

  if (soldToday.length) {
    txt += '\n--- VENTES DU JOUR ---\n';
    soldToday.forEach(sale => {
      const p = PRODUCTS.find(x => x.id === sale.productId);
      const t = new Date(sale.ts).toLocaleTimeString('fr-CH');
      txt += t + ' — ' + (p ? p.name.fr : 'Produit #' + sale.productId) + '\n';
    });
  }

  const blob = new Blob([txt], { type:'text/plain;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'nimara-bilan-' + dateStr.replace(/\//g, '-') + '.txt';
  a.click();
  URL.revokeObjectURL(url);
}

function confirmReset() {
  if (confirm('Remettre tous les stocks à zéro et réinitialiser le bilan du jour ?')) {
    dailyReset();
    closeSummary();
  }
}

function dailyReset() {
  initStock();
  saveStock();
  // Clear today's sales from log
  const today = new Date().toDateString();
  salesLog = salesLog.filter(s => new Date(s.ts).toDateString() !== today);
  saveSalesLog();
  render();
}

// ─── INIT ─────────────────────────────────────────────────────────────────────
loadState();
render();

// Service worker registration
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/delices-pos-sw.js')
      .catch(() => {});
  });
}
</script>
