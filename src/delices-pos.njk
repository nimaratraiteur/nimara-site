    { id:50, category:"extras",   name:"Couverts",                   desc:"Set de couverts jetables.", price:0.20, unit:"pièce", badges:[], vegetarian:true, vegan:true, halal:true, image:"" },
    { id:51, category:"extras",   name:"Sac",                        desc:"Sac pour l'emporter.", price:0.20, unit:"pièce", badges:[], vegetarian:true, vegan:true, halal:true, image:"" }
  ]
};

/* ══════════════════════════════════════════
   BOX MEAL PRICING
   Petite/Grande × viande/végé, +1 à emporter,
   +10 consigne pour box en verre (remboursée).
══════════════════════════════════════════ */
const BOX_PRICING = {
  petite: { meat: 12.90, veg: 11.90 },
  grande: { meat: 15.90, veg: 14.90 },
  emporter: 1.00,   // box carton usage unique
  boxVerre: 10.00   // consigne remboursée au retour
};
const EXTRA_PRICE = { couverts: 0.20, sac: 0.20 };
const COMBO_DISCOUNT = 1.50;
function boxTierOf(p) {
  return p.boxTier || ((p.vegan || p.vegetarian) ? 'veg' : 'meat');
}

/* ══════════════════════════════════════════
   STATE
══════════════════════════════════════════ */
const LS = {
  get: k => { try { return JSON.parse(localStorage.getItem(k)) } catch(e) { return null } },
  set: (k,v) => { try { localStorage.setItem(k, JSON.stringify(v)) } catch(e){} }
};

let state = {
  mode: 'client',          // 'client' | 'vendeuse' | 'admin'
  filter: 'all',
  cart: [],                // [{id, name, price, qty}]
  stock: LS.get('pos_stock') || {},        // {id: 'disponible'|'dernieres'|'rupture'}
  productMods: LS.get('pos_mods') || {},   // {id: {name?, desc?, price?, unit?, image?}}
  customProducts: LS.get('pos_custom') || [], // added by admin
  sales: LS.get('pos_sales') || [],        // [{ts, items, total, method}]
  pinBuffer: ''
};

/* Merge base + custom products */
function allProducts() {
  return [...MENU_DATA.products, ...state.customProducts];
}

/* Get effective product (with admin overrides) */
function getProduct(id) {
  const base = allProducts().find(p => p.id === id);
  if (!base) return null;
  const m = state.productMods[id] || {};
  return { ...base, ...m };
}

/* Stock status for product */
function stockStatus(id) {
  return state.stock[id] || 'disponible';
}

/* ══════════════════════════════════════════
   FILTER LOGIC
══════════════════════════════════════════ */
function filteredProducts() {
  let products = allProducts();
  const f = state.filter;
  const catIds = MENU_DATA.categories.map(c => c.id);
  if (catIds.includes(f)) {
    products = products.filter(p => p.category === f);
  } else if (f === 'vegetarian') {
    products = products.filter(p => p.vegetarian);
  } else if (f === 'vegan') {
    products = products.filter(p => p.vegan);
  } else if (f === 'halal') {
    products = products.filter(p => p.halal);
  }
  // In admin: skip rupture filter (can still manage them)
  if (state.mode !== 'admin') {
    // hide hidden products (but keep rupture so client sees "sold out")
  }
  return products;
}

/* ══════════════════════════════════════════
   CART LOGIC
══════════════════════════════════════════ */
function cartTotal() {
  return state.cart.reduce((s, i) => s + i.price * i.qty, 0);
}
function cartItemCount() {
  return state.cart.reduce((s, i) => s + i.qty, 0);
}
function addToCart(id) {
  const p = getProduct(id);
  if (!p) return;
  const existing = state.cart.find(i => i.id === id);
  if (existing) {
    existing.qty++;
  } else {
    state.cart.push({ id, name: p.name, price: p.price, unit: p.unit, qty: 1 });
  }
  renderCart();
  // Tactile feedback
  const btn = document.querySelector(`.pcard[data-id="${id}"]`);
  if (btn) { btn.style.transform = 'scale(.95)'; setTimeout(() => btn.style.transform = '', 150); }
}
/* Route an add request: box meals / weighables / combos open a picker, others add directly */
function handleAdd(id) {
  const p = getProduct(id);
  if (!p) return;
  if (p.comboPicker) { openCombo(); return; }
  if (p.boxMeal) { openBoxOptions(id); return; }
  if (p.weighable) { openWeigh(id); return; }
  addToCart(id);
}

/* ── Box options picker ── */
let boxChoice = { id: null, size: 'petite', container: 'surplace', couverts: false, sac: false };

function openBoxOptions(id) {
  const p = getProduct(id);
  if (!p) return;
  boxChoice = { id, size: 'petite', container: 'surplace', couverts: false, sac: false };
  document.getElementById('box-options-name').textContent = p.name;
  document.getElementById('box-options-img').src = p.image || '';
  // reset active buttons + checkboxes
  document.querySelectorAll('#box-options-modal .bopt-size').forEach(b => b.classList.toggle('active', b.dataset.size === 'petite'));
  document.querySelectorAll('#box-options-modal .bopt-cont').forEach(b => b.classList.toggle('active', b.dataset.cont === 'surplace'));
  document.getElementById('box-couverts').checked = false;
  document.getElementById('box-sac').checked = false;
  updateBoxOptions();
  openModal('box-options-modal');
}

function boxComputed() {
  const p = getProduct(boxChoice.id);
  const tier = boxTierOf(p);
  let price = BOX_PRICING[boxChoice.size][tier];
  let consigne = 0;
  if (boxChoice.container === 'emporter') price += BOX_PRICING.emporter;
  if (boxChoice.container === 'verre') consigne = BOX_PRICING.boxVerre;
  if (boxChoice.couverts) price += EXTRA_PRICE.couverts;
  if (boxChoice.sac) price += EXTRA_PRICE.sac;
  return { price, consigne, total: price + consigne };
}

function updateBoxOptions() {
  const p = getProduct(boxChoice.id);
  const tier = boxTierOf(p);
  const base = BOX_PRICING[boxChoice.size][tier];
  const { consigne, total } = boxComputed();
  const breakdown = document.getElementById('box-options-breakdown');
  let html = `<span>Plat (${boxChoice.size === 'grande' ? 'grande' : 'petite'} box)</span><span>CHF ${base.toFixed(2)}</span>`;
  if (boxChoice.container === 'emporter') html += `<span>🥡 Box carton</span><span>CHF ${BOX_PRICING.emporter.toFixed(2)}</span>`;
  if (boxChoice.couverts) html += `<span>🍴 Couverts</span><span>CHF ${EXTRA_PRICE.couverts.toFixed(2)}</span>`;
  if (boxChoice.sac) html += `<span>🛍 Sac</span><span>CHF ${EXTRA_PRICE.sac.toFixed(2)}</span>`;
  if (consigne > 0) html += `<span>🫙 Consigne box verre</span><span>CHF ${consigne.toFixed(2)}</span>`;
  breakdown.innerHTML = html;
  document.getElementById('box-options-total').textContent = total.toFixed(2);
  document.getElementById('box-consigne-note').style.display = consigne > 0 ? 'block' : 'none';
}

function selectBoxSize(btn) {
  boxChoice.size = btn.dataset.size;
  document.querySelectorAll('#box-options-modal .bopt-size').forEach(b => b.classList.toggle('active', b === btn));
  updateBoxOptions();
}
function selectBoxCont(btn) {
  boxChoice.container = btn.dataset.cont;
  document.querySelectorAll('#box-options-modal .bopt-cont').forEach(b => b.classList.toggle('active', b === btn));
  updateBoxOptions();
}
function toggleBoxExtra(kind, checked) {
  boxChoice[kind] = checked;
  updateBoxOptions();
}

function confirmBoxOptions() {
  const p = getProduct(boxChoice.id);
  if (!p) return;
  const { total } = boxComputed();
  const sizeLabel = boxChoice.size === 'grande' ? 'Grande' : 'Petite';
  const parts = [sizeLabel];
  if (boxChoice.container === 'emporter') parts.push('box carton');
  else if (boxChoice.container === 'verre') parts.push('box verre +10 consigne');
  if (boxChoice.couverts) parts.push('couverts');
  if (boxChoice.sac) parts.push('sac');
  const lineId = `${boxChoice.id}::${boxChoice.size}::${boxChoice.container}::${boxChoice.couverts?1:0}${boxChoice.sac?1:0}`;
  const name = `${p.name} (${parts.join(', ')})`;
  const existing = state.cart.find(i => i.id === lineId);
  if (existing) existing.qty++;
  else state.cart.push({ id: lineId, name, price: total, unit: 'box', qty: 1 });
  closeModal('box-options-modal');
  renderCart();
}

/* ══════════════════════════════════════════
   WEIGHT SALE (vente au poids, prix / 100 g)
══════════════════════════════════════════ */
let weighId = null;
function openWeigh(id) {
  const p = getProduct(id);
  if (!p) return;
  weighId = id;
  document.getElementById('weigh-name').textContent = p.name;
  document.getElementById('weigh-img').src = p.image || '';
  document.getElementById('weigh-rate').textContent = Number(p.per100g || 0).toFixed(2);
  document.getElementById('weigh-whole-price').textContent = Number(p.price).toFixed(2);
  document.getElementById('weigh-grams').value = '';
  document.getElementById('weigh-total').textContent = '0.00';
  openModal('weigh-modal');
  setTimeout(() => document.getElementById('weigh-grams').focus(), 60);
}
function weighCalc() {
  const p = getProduct(weighId);
  const g = parseFloat(document.getElementById('weigh-grams').value) || 0;
  const total = (p.per100g || 0) * (g / 100);
  document.getElementById('weigh-total').textContent = total.toFixed(2);
  return total;
}
function confirmWeigh() {
  const p = getProduct(weighId);
  const g = parseFloat(document.getElementById('weigh-grams').value) || 0;
  if (g <= 0) { alert('Entrez un poids en grammes'); return; }
  const total = Math.round((p.per100g || 0) * (g / 100) * 20) / 20; // arrondi 0.05
  const lineId = `${weighId}::${g}g::${Date.now()}`;
  state.cart.push({ id: lineId, name: `${p.name} (${g} g)`, price: total, unit: `${g} g`, qty: 1 });
  closeModal('weigh-modal');
  renderCart();
}
function addWholeCake() {
  addToCart(weighId);
  closeModal('weigh-modal');
}

/* ══════════════════════════════════════════
   COMBO (dessert + boisson, −1.50)
══════════════════════════════════════════ */
let comboChoice = { dessert: null, boisson: null };
function dessertsList() { return allProducts().filter(p => p.category === 'sucre' && !p.weighable); }
function boissonsList() { return allProducts().filter(p => p.category === 'boissons'); }

function openCombo() {
  comboChoice = { dessert: null, boisson: null };
  const dWrap = document.getElementById('combo-desserts');
  const bWrap = document.getElementById('combo-boissons');
  dWrap.innerHTML = dessertsList().map(p =>
    `<button class="combo-opt" data-cid="${p.id}" onclick="selectCombo('dessert',${p.id},this)">${p.name}<span>CHF ${p.price.toFixed(2)}</span></button>`
  ).join('');
  bWrap.innerHTML = boissonsList().map(p =>
    `<button class="combo-opt" data-cid="${p.id}" onclick="selectCombo('boisson',${p.id},this)">${p.name}<span>CHF ${p.price.toFixed(2)}</span></button>`
  ).join('');
  updateCombo();
  openModal('combo-modal');
}
function selectCombo(kind, id, btn) {
  comboChoice[kind] = id;
  const wrap = kind === 'dessert' ? document.getElementById('combo-desserts') : document.getElementById('combo-boissons');
  wrap.querySelectorAll('.combo-opt').forEach(b => b.classList.toggle('active', b === btn));
  updateCombo();
}
function comboComputed() {
  const d = getProduct(comboChoice.dessert);
  const b = getProduct(comboChoice.boisson);
  if (!d || !b) return { total: 0, ok: false, d, b };
  const total = Math.max(0, d.price + b.price - COMBO_DISCOUNT);
  return { total, ok: true, d, b };
}
function updateCombo() {
  const { total, ok } = comboComputed();
  document.getElementById('combo-total').textContent = total.toFixed(2);
  document.getElementById('combo-confirm').disabled = !ok;
}
function confirmCombo() {
  const { total, ok, d, b } = comboComputed();
  if (!ok) return;
  const lineId = `combo::${d.id}::${b.id}`;
  const name = `Combo: ${d.name} + ${b.name}`;
  const existing = state.cart.find(i => i.id === lineId);
  if (existing) existing.qty++;
  else state.cart.push({ id: lineId, name, price: total, unit: 'combo', qty: 1 });
  closeModal('combo-modal');
  renderCart();
}

function changeQty(id, delta) {
  const item = state.cart.find(i => String(i.id) === String(id));
  if (!item) return;
  item.qty += delta;
  if (item.qty <= 0) state.cart = state.cart.filter(i => String(i.id) !== String(id));
  renderCart();
}
function removeFromCart(id) {
  state.cart = state.cart.filter(i => String(i.id) !== String(id));
  renderCart();
}
function newOrder() {
  state.cart = [];
  renderCart();
}

/* ══════════════════════════════════════════
   RENDER: PRODUCTS
══════════════════════════════════════════ */
function renderProducts() {
  const products = filteredProducts();
  const grid = document.getElementById('product-grid');
  const empty = document.getElementById('empty-state');
  const visible = products.filter(p => {
    if (state.mode !== 'admin' && stockStatus(p.id) === 'rupture') return false;
    return true;
  });

  if (visible.length === 0) {
    grid.innerHTML = '';
    empty.style.display = 'flex';
    return;
  }
  empty.style.display = 'none';

  grid.innerHTML = products.map(p => {
    const mods = state.productMods[p.id] || {};
    const eff = { ...p, ...mods };
    const stock = stockStatus(p.id);
    const isRupture = stock === 'rupture';
    const isDernieres = stock === 'dernieres';

    // Badge
    const badgeHtml = eff.badges && eff.badges.length
      ? `<span class="pcard-badge ${eff.badges[0]}">${eff.badges[0] === 'signature' ? '⭐ Signature' : eff.badges[0] === 'populaire' ? '🔥 Populaire' : '👑 Prestige'}</span>`
      : '';

    // Image
    const imgHtml = eff.image
      ? `<img src="${eff.image}" alt="${eff.name}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
      : '';
    const catObj = MENU_DATA.categories.find(c => c.id === eff.category);
    const placeholderIcon = catObj ? catObj.icon : '🍽';

    // Tags
    const tags = [];
    if (eff.vegetarian) tags.push('<span class="tag veg">🌿 Végé</span>');
    if (eff.vegan) tags.push('<span class="tag vegan">🌱 Vegan</span>');
    if (eff.halal) tags.push('<span class="tag halal">☪️ Halal</span>');

    // Add button (client mode only)
    const addBtn = state.mode === 'client'
      ? `<button class="pcard-add-btn" onclick="event.stopPropagation();handleAdd(${p.id})" aria-label="Ajouter au panier">+</button>`
      : '';

    // Admin bar
    const adminBar = state.mode === 'admin' ? `
      <div class="pcard-admin-bar">
        <select class="stock-sel" onchange="setStock(${p.id},this.value)">
          <option value="disponible" ${stock==='disponible'?'selected':''}>✅ Dispo</option>
          <option value="dernieres" ${stock==='dernieres'?'selected':''}>⚠️ Dernières</option>
          <option value="rupture" ${stock==='rupture'?'selected':''}>❌ Rupture</option>
        </select>
        <button class="btn-soldé" onclick="event.stopPropagation();soldé(${p.id})">-30%</button>
        <button class="btn-edit-price" onclick="event.stopPropagation();openEditProduct(${p.id})">✏️</button>
      </div>` : '';

    const ruptureBadge = isRupture ? '<div class="rupture-label">Rupture</div>' : '';

    return `
      <div class="pcard ${isRupture?'rupture':''} ${isDernieres?'dernieres':''}"
           data-id="${p.id}"
           onclick="handleCardClick(${p.id})"
           role="button" tabindex="0"
           aria-label="${eff.name} — CHF ${eff.price.toFixed(2)}">
        <div class="pcard-img-wrap">
          ${imgHtml}
          <div class="pcard-img-placeholder" style="display:${eff.image?'none':'flex'}">${placeholderIcon}</div>
          ${badgeHtml}
          ${ruptureBadge}
        </div>
        <div class="pcard-body">
          <div class="pcard-name">${eff.name}</div>
          <div class="pcard-desc">${eff.desc || eff.description || ''}</div>
          <div class="pcard-tags">${tags.join('')}</div>
          <div class="pcard-footer">
            <div>
              ${eff.comboPicker
                ? `<div class="pcard-price">🎁 −${COMBO_DISCOUNT.toFixed(2)}</div><span class="pcard-unit">dessert + boisson</span>`
                : eff.boxMeal
                ? `<div class="pcard-price">dès CHF ${eff.price.toFixed(2)}</div><span class="pcard-unit">petite / grande box</span>`
                : eff.weighable
                ? `<div class="pcard-price">CHF ${eff.price.toFixed(2)}</div><span class="pcard-unit">entier · ${Number(eff.per100g||0).toFixed(2)}/100g</span>`
                : `<div class="pcard-price">CHF ${eff.price.toFixed(2)}</div><span class="pcard-unit">/ ${eff.unit}</span>`}
            </div>
            ${addBtn}
          </div>
        </div>
        ${adminBar}
      </div>`;
  }).join('');
}

function handleCardClick(id) {
  if (state.mode === 'client') return; // client uses the + button
  if (stockStatus(id) === 'rupture' && state.mode !== 'admin') return;
  handleAdd(id);
}

/* ══════════════════════════════════════════
   RENDER: CART
══════════════════════════════════════════ */
function renderCart() {
  const total = cartTotal();
  const count = cartItemCount();
  document.getElementById('cart-total').textContent = total.toFixed(2);
  document.getElementById('cart-count').textContent = count;

  const btn = document.getElementById('btn-checkout');
  btn.disabled = count === 0;

  const container = document.getElementById('cart-items');
  if (state.cart.length === 0) {
    container.innerHTML = '<div class="cart-empty"><div class="icon">🛒</div><p>Le panier est vide</p></div>';
    return;
  }

  container.innerHTML = state.cart.map(item => `
    <div class="ci">
      <div style="flex:1">
        <div class="ci-name">${item.name}</div>
        <div class="ci-unit-price">CHF ${item.price.toFixed(2)} / ${item.unit || 'pcs'}</div>
      </div>
      <div class="ci-qty">
        <button class="ci-qty-btn" onclick="changeQty('${item.id}',-1)" aria-label="Moins">−</button>
        <span class="ci-qty-num">${item.qty}</span>
        <button class="ci-qty-btn" onclick="changeQty('${item.id}',1)" aria-label="Plus">+</button>
      </div>
      <span class="ci-total">CHF ${(item.price * item.qty).toFixed(2)}</span>
      <button class="ci-remove" onclick="removeFromCart('${item.id}')" aria-label="Supprimer">✕</button>
    </div>`).join('');

  updateDailyTotal();
}

/* ══════════════════════════════════════════
   CHECKOUT
══════════════════════════════════════════ */
function handleCheckout() {
  if (state.cart.length === 0) return;
  if (state.mode === 'client') {
    document.getElementById('client-checkout-total').textContent = cartTotal().toFixed(2);
    openModal('client-checkout-modal');
    return;
  }
  // Vendeuse / Admin: POS checkout
  const total = cartTotal().toFixed(2);
  document.getElementById('checkout-total').textContent = total;
  document.getElementById('card-total-display').textContent = total;
  document.getElementById('cash-received').value = '';
  document.getElementById('change-display').style.display = 'none';
  document.getElementById('btn-confirm-cash').disabled = true;
  document.getElementById('cash-section').classList.remove('active');
  document.getElementById('card-section').classList.remove('active');
  document.getElementById('pay-cash-btn').classList.remove('selected');
  document.getElementById('pay-card-btn').classList.remove('selected');
  openModal('checkout-modal');
}

let selectedPayment = null;
function selectPayment(method) {
  selectedPayment = method;
  document.getElementById('pay-cash-btn').classList.toggle('selected', method === 'cash');
  document.getElementById('pay-card-btn').classList.toggle('selected', method === 'card');
  document.getElementById('cash-section').classList.toggle('active', method === 'cash');
  document.getElementById('card-section').classList.toggle('active', method === 'card');
  if (method === 'cash') {
    setTimeout(() => document.getElementById('cash-received').focus(), 50);
  }
}

function calcChange() {
  const total = cartTotal();
  const received = parseFloat(document.getElementById('cash-received').value) || 0;
  const change = received - total;
  const display = document.getElementById('change-display');
  const btn = document.getElementById('btn-confirm-cash');
  if (received > 0 && change >= 0) {
    document.getElementById('change-amount').textContent = `CHF ${change.toFixed(2)}`;
    display.style.display = 'flex';
    btn.disabled = false;
    btn.textContent = change > 0
      ? `✅ Confirmer — Rendre CHF ${change.toFixed(2)}`
      : '✅ Confirmer — Compte rond';
  } else {
    display.style.display = 'none';
    btn.disabled = true;
  }
}

function confirmPayment(method) {
  const total = cartTotal();
  const received = method === 'cash' ? parseFloat(document.getElementById('cash-received').value) || 0 : null;
  const change = method === 'cash' ? received - total : 0;

  // Save transaction
  const txn = {
    ts: Date.now(),
    items: state.cart.map(i => ({ id: i.id, name: i.name, qty: i.qty, price: i.price })),
    total,
    method,
    change: method === 'cash' ? change : null
  };
  state.sales.push(txn);
  LS.set('pos_sales', state.sales);

  closeModal('checkout-modal');
  showReceipt(txn);
}

/* ══════════════════════════════════════════
   RECEIPT
══════════════════════════════════════════ */
function showReceipt(txn) {
  const itemsHtml = txn.items.map(i =>
    `<div class="receipt-item">
       <span>${i.qty}× ${i.name}</span>
       <span>CHF ${(i.price * i.qty).toFixed(2)}</span>
     </div>`
  ).join('<hr class="receipt-divider">');

  document.getElementById('receipt-items').innerHTML = itemsHtml;
  document.getElementById('receipt-total').textContent = txn.total.toFixed(2);

  const methodEl = document.getElementById('receipt-method');
  methodEl.textContent = txn.method === 'cash' ? '💵 Espèces' : '💳 Carte SumUp';
  methodEl.className = `receipt-method ${txn.method}`;

  const changeRow = document.getElementById('receipt-change-row');
  if (txn.method === 'cash' && txn.change > 0) {
    changeRow.style.display = 'block';
    changeRow.textContent = `Monnaie rendue: CHF ${txn.change.toFixed(2)}`;
  } else {
    changeRow.style.display = 'none';
  }

  openModal('receipt-modal');
  updateDailyTotal();
}

/* ══════════════════════════════════════════
   DAILY SUMMARY
══════════════════════════════════════════ */
function updateDailyTotal() {
  const today = new Date().toDateString();
  const todaySales = state.sales.filter(s => new Date(s.ts).toDateString() === today);
  const total = todaySales.reduce((s, t) => s + t.total, 0);
  document.getElementById('daily-total-val').textContent = total.toFixed(2);
}

function openSummary() {
  const today = new Date().toDateString();
  const todaySales = state.sales.filter(s => new Date(s.ts).toDateString() === today);
  const total = todaySales.reduce((s, t) => s + t.total, 0);
  const cash = todaySales.filter(t => t.method === 'cash').reduce((s, t) => s + t.total, 0);
  const card = todaySales.filter(t => t.method === 'card').reduce((s, t) => s + t.total, 0);
  const txnCount = todaySales.length;

  // Top products
  const productTotals = {};
  todaySales.forEach(t => t.items.forEach(i => {
    if (!productTotals[i.name]) productTotals[i.name] = { qty: 0, total: 0 };
    productTotals[i.name].qty += i.qty;
    productTotals[i.name].total += i.qty * i.price;
  }));
  const topProducts = Object.entries(productTotals).sort((a, b) => b[1].total - a[1].total).slice(0, 3);

  document.getElementById('stat-grid').innerHTML = `
    <div class="stat-card"><span class="stat-label">CA Total</span><span class="stat-value green">CHF ${total.toFixed(2)}</span></div>
    <div class="stat-card"><span class="stat-label">Transactions</span><span class="stat-value lavender">${txnCount}</span></div>
    <div class="stat-card"><span class="stat-label">💵 Cash</span><span class="stat-value gold">CHF ${cash.toFixed(2)}</span></div>
    <div class="stat-card"><span class="stat-label">💳 Carte</span><span class="stat-value">CHF ${card.toFixed(2)}</span></div>
    ${topProducts.map(([name, d]) => `<div class="stat-card" style="grid-column:span 2"><span class="stat-label">🏆 ${name}</span><span class="stat-value" style="font-size:1rem">${d.qty}× — CHF ${d.total.toFixed(2)}</span></div>`).join('')}`;

  document.getElementById('txn-list').innerHTML = todaySales.length === 0
    ? '<div style="color:var(--faint);font-size:.8rem;text-align:center;padding:1rem">Aucune transaction aujourd\'hui</div>'
    : [...todaySales].reverse().map(t => {
        const time = new Date(t.ts).toLocaleTimeString('fr-CH', { hour: '2-digit', minute: '2-digit' });
        const itemNames = t.items.map(i => `${i.qty}× ${i.name}`).join(', ');
        return `<div class="txn-row">
          <span class="txn-time">${time}</span>
          <span class="txn-items">${itemNames.length > 35 ? itemNames.substring(0,32)+'…' : itemNames}</span>
          <span class="txn-total">CHF ${t.total.toFixed(2)}</span>
          <span class="txn-method ${t.method}">${t.method === 'cash' ? '💵' : '💳'}</span>
        </div>`;
      }).join('');

  openModal('summary-modal');
}

function exportCSV() {
  const today = new Date().toDateString();
  const todaySales = state.sales.filter(s => new Date(s.ts).toDateString() === today);
  if (todaySales.length === 0) { alert('Aucune transaction à exporter'); return; }
  const rows = ['Heure,Produits,Total CHF,Moyen de paiement'];
  todaySales.forEach(t => {
    const time = new Date(t.ts).toLocaleTimeString('fr-CH');
    const items = t.items.map(i => `${i.qty}x ${i.name}`).join(' | ');
    rows.push(`"${time}","${items}",${t.total.toFixed(2)},${t.method}`);
  });
  const blob = new Blob([rows.join('\n')], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `nimara-ventes-${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
  URL.revokeObjectURL(url);
}

function resetDay() {
  if (!confirm('Supprimer toutes les transactions d\'aujourd\'hui ?')) return;
  const today = new Date().toDateString();
  state.sales = state.sales.filter(s => new Date(s.ts).toDateString() !== today);
  LS.set('pos_sales', state.sales);
  updateDailyTotal();
  closeModal('summary-modal');
}

/* ══════════════════════════════════════════
   ADMIN: STOCK & PRODUCT EDIT
══════════════════════════════════════════ */
function setStock(id, val) {
  state.stock[id] = val;
  LS.set('pos_stock', state.stock);
  renderProducts();
}

function soldé(id) {
  const p = getProduct(id);
  if (!p) return;
  const newPrice = Math.round(p.price * 0.7 * 20) / 20; // round to 0.05
  if (!state.productMods[id]) state.productMods[id] = {};
  state.productMods[id].price = newPrice;
  state.productMods[id].badges = ['populaire'];
  LS.set('pos_mods', state.productMods);
  renderProducts();
}

function openEditProduct(id) {
  const p = getProduct(id);
  if (!p) return;
  document.getElementById('edit-product-id').value = id;
  document.getElementById('edit-name').value = p.name;
  document.getElementById('edit-desc').value = p.desc || p.description || '';
  document.getElementById('edit-price').value = p.price;
  document.getElementById('edit-unit').value = p.unit || '';
  document.getElementById('edit-image').value = p.image || '';
  document.getElementById('edit-stock').value = stockStatus(id);
  openModal('edit-product-modal');
}

function saveProductEdit() {
  const id = parseInt(document.getElementById('edit-product-id').value);
  if (!state.productMods[id]) state.productMods[id] = {};
  state.productMods[id].name = document.getElementById('edit-name').value;
  state.productMods[id].desc = document.getElementById('edit-desc').value;
  state.productMods[id].price = parseFloat(document.getElementById('edit-price').value);
  state.productMods[id].unit = document.getElementById('edit-unit').value;
  state.productMods[id].image = document.getElementById('edit-image').value;
  state.stock[id] = document.getElementById('edit-stock').value;
  LS.set('pos_mods', state.productMods);
  LS.set('pos_stock', state.stock);
  closeModal('edit-product-modal');
  renderProducts();
}

function saveNewProduct() {
  const name = document.getElementById('new-name').value.trim();
  const price = parseFloat(document.getElementById('new-price').value);
  if (!name || isNaN(price)) { alert('Nom et prix requis'); return; }
  const newId = Date.now();
  const p = {
    id: newId,
    category: document.getElementById('new-category').value,
    name,
    desc: document.getElementById('new-desc').value,
    price,
    unit: document.getElementById('new-unit').value || 'pièce',
    badges: [],
    vegetarian: document.getElementById('new-veg').checked,
    vegan: document.getElementById('new-vegan').checked,
    halal: document.getElementById('new-halal').checked,
    image: document.getElementById('new-image').value
  };
  state.customProducts.push(p);
  LS.set('pos_custom', state.customProducts);
  closeModal('add-product-modal');
  renderProducts();
  // Clear form
  ['new-name','new-desc','new-price','new-unit','new-image'].forEach(id => document.getElementById(id).value = '');
  ['new-veg','new-vegan','new-halal'].forEach(id => document.getElementById(id).checked = false);
}

/* ══════════════════════════════════════════
   MODE SWITCHING (PIN)
══════════════════════════════════════════ */
function pinPress(digit) {
  if (state.pinBuffer.length >= 4) return;
  state.pinBuffer += digit;
  updatePinDots();
  if (state.pinBuffer.length === 4) {
    setTimeout(checkPin, 100);
  }
}

function pinClear() {
  state.pinBuffer = state.pinBuffer.slice(0, -1);
  updatePinDots();
  document.getElementById('pin-error').textContent = '';
}

function updatePinDots() {
  for (let i = 0; i < 4; i++) {
    document.getElementById(`pd${i}`).classList.toggle('filled', i < state.pinBuffer.length);
  }
}

function checkPin() {
  const pin = state.pinBuffer;
  state.pinBuffer = '';
  updatePinDots();
  if (pin === '1234') {
    setMode('vendeuse');
    closeModal('pin-modal');
  } else if (pin === '5678') {
    setMode('admin');
    closeModal('pin-modal');
  } else {
    document.getElementById('pin-error').textContent = 'Code incorrect. Réessayez.';
    // Shake animation
    document.getElementById('pin-display').style.animation = 'none';
    setTimeout(() => document.getElementById('pin-display').style.animation = '', 10);
  }
}

function switchToClient() {
  setMode('client');
  closeModal('pin-modal');
}

function setMode(mode) {
  state.mode = mode;
  document.body.setAttribute('data-mode', mode);
  // Update mode badge
  const badge = document.getElementById('mode-badge');
  badge.className = `mode-badge ${mode}`;
  if (mode === 'client') { badge.textContent = 'Client'; badge.id = 'mode-badge'; badge.className = 'client'; badge.id = 'mode-badge'; }
  else if (mode === 'vendeuse') { badge.textContent = 'Vendeuse'; badge.className = 'vendeuse'; }
  else if (mode === 'admin') { badge.textContent = 'Admin'; badge.className = 'admin'; }
  badge.id = 'mode-badge'; // keep id

  // Update checkout button text
  const checkoutBtn = document.getElementById('btn-checkout');
  if (mode === 'client') {
    checkoutBtn.textContent = 'Passer commande';
  } else {
    checkoutBtn.textContent = '💳 Encaisser';
  }

  // Show admin add product button
  let adminBtn = document.getElementById('admin-add-btn');
  if (mode === 'admin') {
    if (!adminBtn) {
      adminBtn = document.createElement('button');
      adminBtn.id = 'admin-add-btn';
      adminBtn.className = 'hdr-btn';
      adminBtn.title = 'Ajouter un produit';
      adminBtn.textContent = '➕';
      adminBtn.onclick = () => openModal('add-product-modal');
      document.getElementById('hdr').insertBefore(adminBtn, document.getElementById('btn-summary'));
    }
  } else {
    if (adminBtn) adminBtn.remove();
  }

  renderProducts();
  renderCart();
  updateDailyTotal();
}

/* ══════════════════════════════════════════
   MODALS
══════════════════════════════════════════ */
function openModal(id) {
  if (id === 'summary-modal') openSummary();
  document.getElementById(id).classList.add('open');
}
function closeModal(id) {
  document.getElementById(id).classList.remove('open');
}

// Close modal on backdrop click
document.querySelectorAll('.modal-backdrop').forEach(backdrop => {
  backdrop.addEventListener('click', e => {
    if (e.target === backdrop) {
      backdrop.classList.remove('open');
      if (backdrop.id === 'receipt-modal') newOrder();
    }
  });
});

// Close on ESC
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    document.querySelectorAll('.modal-backdrop.open').forEach(m => m.classList.remove('open'));
  }
});

/* ══════════════════════════════════════════
   FILTER BUTTONS
══════════════════════════════════════════ */
document.querySelectorAll('.fil-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.fil-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    state.filter = btn.dataset.filter;
    renderProducts();
  });
});

/* ══════════════════════════════════════════
   KEYBOARD: PIN pad
══════════════════════════════════════════ */
document.addEventListener('keydown', e => {
  const pinModal = document.getElementById('pin-modal');
  if (!pinModal.classList.contains('open')) return;
  if (e.key >= '0' && e.key <= '9') pinPress(e.key);
  if (e.key === 'Backspace') pinClear();
});

/* ══════════════════════════════════════════
   STAND FICHE
══════════════════════════════════════════ */
let formula = Object.assign({ price: 12.90, dish: '' }, LS.get('pos_formula') || {});

function renderFiche() {
  let dayName;
  try { dayName = new Date().toLocaleDateString('fr-FR', { weekday: 'long' }); }
  catch (e) { dayName = ['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'][new Date().getDay()] || 'jour'; }
  const dayCap = dayName.charAt(0).toUpperCase() + dayName.slice(1);
  document.getElementById('fiche-day').textContent = 'Menu de ' + dayCap;

  const dishEl = document.getElementById('fiche-dish');
  dishEl.textContent = formula.dish || '';
  dishEl.style.display = formula.dish ? 'block' : 'none';

  document.getElementById('fiche-price').innerHTML =
    '<span class="chf">CHF</span> ' + Number(formula.price).toFixed(2);
}

function openFiche() {
  renderFiche();
  document.getElementById('fiche').classList.add('open');
}
function closeFiche() {
  document.getElementById('fiche').classList.remove('open');
}
function editFormula() {
  const newDish = prompt('Plat de la formule du jour (optionnel) :', formula.dish || '');
  if (newDish !== null) formula.dish = newDish.trim();
  const newPrice = prompt('Prix de la formule (CHF) :', Number(formula.price).toFixed(2));
  if (newPrice !== null) {
    const v = parseFloat(String(newPrice).replace(',', '.'));
    if (!isNaN(v) && v >= 0) formula.price = v;
  }
  LS.set('pos_formula', formula);
  renderFiche();
}

/* ══════════════════════════════════════════
   INIT
══════════════════════════════════════════ */
function init() {
  renderProducts();
  renderCart();
  updateDailyTotal();
}

init();

