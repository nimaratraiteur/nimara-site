<script>
// SLIDESHOW
let cur=0;
const slides=document.querySelectorAll('.hero-slide');
const dots=document.querySelectorAll('.hero-dot');
let auto=setInterval(()=>goSlide((cur+1)%slides.length),5500);
function goSlide(n){slides[cur].classList.remove('active');dots[cur].classList.remove('active');cur=n;slides[cur].classList.add('active');dots[cur].classList.add('active');clearInterval(auto);auto=setInterval(()=>goSlide((cur+1)%slides.length),5500);}

// NAV SCROLL
window.addEventListener('scroll',()=>document.getElementById('navbar').classList.toggle('scrolled',scrollY>60));

// REVEAL
const obs=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting)x.target.classList.add('visible');}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

// GALLERY DRAG
const gs=document.getElementById('galleryScroll');
let down=false,sx,sl;
gs.addEventListener('mousedown',e=>{down=true;sx=e.pageX-gs.offsetLeft;sl=gs.scrollLeft;});
gs.addEventListener('mouseleave',()=>down=false);
gs.addEventListener('mouseup',()=>down=false);
gs.addEventListener('mousemove',e=>{if(!down)return;e.preventDefault();gs.scrollLeft=sl-(e.pageX-gs.offsetLeft-sx)*1.5;});

// OPEN STATUS
(function(){
  const now=new Date();const day=now.getDay();const h=now.getHours()+now.getMinutes()/60;
  const open=(day>=1&&day<=5&&h>=7.5&&h<18.5)||(day===6&&h>=8&&h<17)||(day===0&&h>=9&&h<14);
  if(!open){
    const b=document.getElementById('openBadge');
    b.style.cssText='background:rgba(220,38,38,.15);border-color:rgba(220,38,38,.3);color:#f87171';
    document.getElementById('oDot').style.cssText='background:#f87171;animation:none';
    document.getElementById('openLabel').textContent='Actuellement fermé';
  }
  document.querySelectorAll('.hr-row').forEach(r=>{
    if((r.dataset.day||'').split(',').includes(String(day))){
      r.classList.add('today');
      r.querySelector('.hr-day')?.classList.add('today');
      r.querySelector('.hr-time')?.classList.add('today');
    }
  });
})();
</script>

