<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{--v:#5B2C8D;--v2:#7c3aed;--lav:#a78bfa;--gold:#f59e0b;--goldd:#d97706;--ink:#0f0a1a;--ink2:#1c1007;--cream:#fffbf0;--warm:#fef3c7;--mu:#78716c;--wa:#25d366;}
html{scroll-behavior:smooth;overflow-x:hidden;}
body{font-family:"DM Sans",sans-serif;background:var(--ink);color:white;overflow-x:hidden;}

body::before{content:"";position:fixed;inset:0;z-index:1;pointer-events:none;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");opacity:.35;}

/* NAV */
.nav{position:fixed;top:0;left:0;right:0;z-index:200;padding:0 40px;height:64px;display:flex;align-items:center;justify-content:space-between;transition:background .4s;}
.nav.scrolled{background:rgba(15,10,26,.92);backdrop-filter:blur(20px);border-bottom:1px solid rgba(167,139,250,.12);}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none;}
.nav-n{width:36px;height:36px;background:var(--v);border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:"Cormorant Garamond",serif;font-size:20px;color:white;font-weight:600;}
.nav-brand{font-size:18px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:white;}
.nav-links{display:flex;align-items:center;gap:6px;}
.nav-link{padding:7px 16px;border-radius:50px;font-size:13px;font-weight:500;text-decoration:none;color:rgba(255,255,255,.6);transition:all .2s;}
.nav-link:hover{color:white;background:rgba(255,255,255,.08);}
.nav-cta{display:flex;align-items:center;gap:7px;background:var(--wa);color:white;padding:8px 18px;border-radius:50px;font-size:13px;font-weight:700;text-decoration:none;transition:all .2s;}
.nav-cta:hover{background:#1da851;transform:translateY(-1px);}
.nav-cta svg,.wa-fab svg{width:15px;height:15px;}

/* HERO */
.hero{position:relative;height:100vh;min-height:600px;display:flex;align-items:flex-end;overflow:hidden;}
.hero-slides{position:absolute;inset:0;}
.hero-slide{position:absolute;inset:0;opacity:0;transition:opacity 1.2s ease;}
.hero-slide.active{opacity:1;}
.hero-slide img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.06);}
.hero-slide.active img{animation:slowzoom 8s ease-out forwards;}
@keyframes slowzoom{from{transform:scale(1.06)}to{transform:scale(1.0)}}
.hero-grad{position:absolute;inset:0;z-index:2;background:linear-gradient(to top,rgba(15,10,26,1) 0%,rgba(15,10,26,.45) 40%,transparent 70%),linear-gradient(to right,rgba(15,10,26,.65) 0%,transparent 60%);}
.hero-content{position:relative;z-index:3;padding:0 40px 72px;max-width:780px;}
.hero-kicker{display:inline-flex;align-items:center;gap:8px;background:rgba(245,158,11,.15);border:1px solid rgba(245,158,11,.3);border-radius:50px;padding:5px 16px;font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:20px;opacity:0;animation:fadeup .8s .3s ease forwards;}
.hero-title{font-family:"Cormorant Garamond",serif;font-size:clamp(52px,8.5vw,96px);font-weight:300;line-height:.95;margin-bottom:20px;color:white;opacity:0;animation:fadeup .9s .5s ease forwards;}
.hero-title em{font-style:italic;color:var(--gold);}
.hero-title .l2{display:block;margin-left:clamp(20px,5vw,60px);}
.hero-sub{font-size:clamp(14px,1.8vw,17px);font-weight:300;color:rgba(255,255,255,.6);line-height:1.75;max-width:480px;margin-bottom:32px;opacity:0;animation:fadeup .8s .7s ease forwards;}
.hero-pills{display:flex;gap:10px;flex-wrap:wrap;opacity:0;animation:fadeup .8s .9s ease forwards;}
.hero-pill{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);backdrop-filter:blur(8px);border-radius:50px;padding:8px 18px;font-size:13px;color:rgba(255,255,255,.8);font-weight:500;cursor:pointer;text-decoration:none;transition:all .25s;}
.hero-pill:hover{background:rgba(255,255,255,.18);color:white;transform:translateY(-2px);}
.hero-pill.wa{background:rgba(37,211,102,.2);border-color:rgba(37,211,102,.4);color:#4ade80;}
.hero-dots{position:absolute;bottom:24px;right:40px;z-index:4;display:flex;gap:8px;align-items:center;}
.hero-dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.3);cursor:pointer;transition:all .3s;}
.hero-dot.active{background:var(--gold);width:24px;border-radius:3px;}
.scroll-hint{position:absolute;bottom:32px;left:50%;transform:translateX(-50%);z-index:4;display:flex;flex-direction:column;align-items:center;gap:8px;opacity:0;animation:fadeup .8s 1.5s ease forwards;}
.scroll-hint span{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.3);}
.scroll-arrow{width:1px;height:40px;background:linear-gradient(to bottom,rgba(245,158,11,.5),transparent);animation:scrollpulse 2s infinite;}
@keyframes scrollpulse{0%,100%{opacity:.4}50%{opacity:1}}
@keyframes fadeup{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

/* ROUTING */
.routing{padding:80px 40px;background:var(--ink);position:relative;z-index:5;}
.routing-inner{max-width:1100px;margin:0 auto;}
.s-kicker{font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--lav);margin-bottom:12px;display:block;}
.s-title{font-family:"Cormorant Garamond",serif;font-size:clamp(32px,5vw,56px);font-weight:300;line-height:1;margin-bottom:48px;}
.routing-cards{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
.r-card{border-radius:20px;padding:40px;position:relative;overflow:hidden;cursor:pointer;transition:transform .35s,box-shadow .35s;text-decoration:none;display:flex;flex-direction:column;gap:16px;min-height:320px;}
.r-card:hover{transform:translateY(-6px);}
.r-card--part{background:var(--cream);color:var(--ink2);box-shadow:0 4px 32px rgba(245,158,11,.08);}
.r-card--part:hover{box-shadow:0 20px 60px rgba(245,158,11,.2);}
.r-card--event{background:linear-gradient(135deg,#1a0a2e,#2d1054);color:white;border:1px solid rgba(167,139,250,.2);box-shadow:0 4px 32px rgba(91,44,141,.2);}
.r-card--event:hover{box-shadow:0 20px 60px rgba(91,44,141,.4);border-color:rgba(167,139,250,.4);}
.r-card__bg{position:absolute;inset:0;z-index:0;opacity:.1;transition:opacity .4s;}
.r-card:hover .r-card__bg{opacity:.18;}
.r-card__bg img{width:100%;height:100%;object-fit:cover;}
.r-card__content{position:relative;z-index:1;flex:1;display:flex;flex-direction:column;gap:12px;}
.r-icon{font-size:44px;}
.r-label{font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;}
.r-card--part .r-label{color:var(--mu);}
.r-card--event .r-label{color:var(--lav);}
.r-card__title{font-family:"Cormorant Garamond",serif;font-size:36px;font-weight:300;line-height:1.05;}
.r-card--event .r-card__title em{font-style:italic;color:var(--gold);}
.r-desc{font-size:14px;line-height:1.65;flex:1;}
.r-card--part .r-desc{color:var(--mu);}
.r-card--event .r-desc{color:rgba(255,255,255,.6);}
.r-actions{display:flex;flex-direction:column;gap:10px;}
.r-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px 20px;border-radius:12px;font-size:14px;font-weight:600;text-decoration:none;transition:all .25s;border:none;cursor:pointer;font-family:"DM Sans",sans-serif;}
.r-btn--uber{background:#000;color:white;}
.r-btn--uber:hover{background:#1a1a1a;}
.r-btn--delices{background:var(--warm);color:var(--ink2);border:1px solid rgba(245,158,11,.3);}
.r-btn--delices:hover{background:var(--gold);color:white;}
.r-btn--calc{background:var(--v);color:white;box-shadow:0 4px 16px rgba(91,44,141,.4);}
.r-btn--calc:hover{background:var(--v2);transform:translateY(-1px);}
.r-or{font-size:11px;text-align:center;color:rgba(0,0,0,.25);letter-spacing:.1em;text-transform:uppercase;}

/* GALLERY */
.gallery{padding:0 0 80px;background:var(--ink);position:relative;z-index:5;}
.gallery-head{padding:64px 40px 32px;display:flex;align-items:flex-end;justify-content:space-between;}
.gallery-scroll{display:flex;gap:16px;overflow-x:auto;padding:0 40px 16px;scrollbar-width:none;cursor:grab;}
.gallery-scroll::-webkit-scrollbar{display:none;}
.g-item{flex-shrink:0;border-radius:16px;overflow:hidden;position:relative;transition:transform .3s;}
.g-item:hover{transform:scale(1.02);}
.g-item.tall{width:240px;height:320px;}
.g-item.wide{width:360px;height:240px;}
.g-item img{width:100%;height:100%;object-fit:cover;display:block;}
.g-label{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(0,0,0,.8));padding:32px 16px 14px;font-size:13px;font-weight:600;color:white;}
.g-badge{position:absolute;top:12px;left:12px;background:rgba(0,0,0,.5);backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,.15);border-radius:50px;padding:4px 12px;font-size:10px;font-weight:600;color:white;}
.scroll-hint-h{text-align:center;padding:8px 0 0;font-size:11px;color:rgba(255,255,255,.2);letter-spacing:.1em;text-transform:uppercase;}

/* CHAVANNES */
.chavannes{background:linear-gradient(160deg,#0f0a1a,#1a0a2e 40%,#0f0a1a);padding:100px 40px;position:relative;z-index:5;overflow:hidden;}
.chavannes::before{content:"";position:absolute;top:-200px;right:-200px;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(91,44,141,.2),transparent 70%);pointer-events:none;}
.ch-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;}
.ch-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.cv{border-radius:14px;overflow:hidden;position:relative;aspect-ratio:1;transition:transform .3s;}
.cv:hover{transform:scale(1.03);}
.cv.big{grid-column:span 2;aspect-ratio:16/9;}
.cv img{width:100%;height:100%;object-fit:cover;display:block;}
.cv-name{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(0,0,0,.75));padding:24px 12px 10px;font-size:12px;font-weight:600;color:white;}
.cv-sp{position:absolute;top:10px;right:10px;font-size:10px;background:rgba(0,0,0,.5);backdrop-filter:blur(4px);border-radius:50px;padding:3px 8px;color:white;}

/* SHARED TEXT STYLES */
.s-ey{font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--lav);margin-bottom:12px;display:block;}
.s-t{font-family:"Cormorant Garamond",serif;font-size:clamp(36px,5vw,60px);font-weight:300;line-height:1;margin-bottom:20px;}
.s-t em{font-style:italic;}
.s-d{font-size:15px;font-weight:300;color:rgba(255,255,255,.55);line-height:1.75;margin-bottom:28px;}
.s-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px;}
.s-tag{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:50px;padding:7px 16px;font-size:12px;color:rgba(255,255,255,.6);}
.s-cta{display:inline-flex;align-items:center;gap:8px;background:var(--v);color:white;padding:14px 28px;border-radius:12px;font-size:14px;font-weight:600;text-decoration:none;transition:all .25s;box-shadow:0 4px 20px rgba(91,44,141,.4);}
.s-cta:hover{background:var(--v2);transform:translateY(-2px);}

/* Artisanales */
.martine{background:linear-gradient(160deg,var(--cream) 0%,var(--warm) 50%,var(--cream) 100%);padding:100px 40px;color:var(--ink2);position:relative;z-index:5;}
.martine::before{content:"";position:absolute;bottom:-100px;left:-100px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(245,158,11,.1),transparent 70%);pointer-events:none;}
.m-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;}
.m-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
.mi{border-radius:12px;overflow:hidden;aspect-ratio:3/4;position:relative;transition:transform .3s;box-shadow:0 4px 20px rgba(0,0,0,.12);}
.mi:hover{transform:scale(1.03);}
.mi img{width:100%;height:100%;object-fit:cover;display:block;}
.mi-name{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(28,16,7,.7));padding:20px 10px 8px;font-size:11px;font-weight:600;color:white;}
.martine .s-ey{color:var(--goldd);}
.martine .s-d{color:var(--mu);}
.martine .s-tag{background:rgba(0,0,0,.05);border-color:rgba(0,0,0,.1);color:var(--mu);}
.martine .s-cta{background:var(--goldd);box-shadow:0 4px 20px rgba(217,119,6,.3);}
.martine .s-cta:hover{background:var(--gold);}

/* EVENTS */
.events{background:var(--ink2);padding:100px 40px;position:relative;z-index:5;overflow:hidden;text-align:center;}
.e-inner{max-width:1100px;margin:0 auto;}
.e-title{font-family:"Cormorant Garamond",serif;font-size:clamp(40px,7vw,80px);font-weight:300;line-height:1;margin-bottom:16px;}
.e-title em{font-style:italic;color:var(--gold);}
.e-desc{font-size:16px;color:rgba(255,255,255,.45);max-width:560px;margin:0 auto 48px;line-height:1.75;}
.p-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:48px;}
.p-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:24px 20px;text-align:center;transition:all .3s;}
.p-card:hover{background:rgba(167,139,250,.08);border-color:rgba(167,139,250,.25);transform:translateY(-4px);}
.p-icon{font-size:32px;margin-bottom:12px;}
.p-name{font-weight:700;font-size:15px;margin-bottom:4px;}
.p-from{font-size:11px;color:rgba(255,255,255,.3);margin-bottom:8px;letter-spacing:.05em;text-transform:uppercase;}
.p-price{font-family:"Cormorant Garamond",serif;font-size:36px;font-weight:300;color:var(--lav);}
.p-unit{font-size:11px;color:rgba(255,255,255,.3);}
.p-d{font-size:12px;color:rgba(255,255,255,.35);margin-top:8px;line-height:1.5;}
.e-ctagroup{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;}
.e-cta{display:flex;align-items:center;gap:8px;padding:15px 32px;border-radius:14px;font-size:15px;font-weight:700;text-decoration:none;transition:all .25s;}
.e-cta--calc{background:var(--v);color:white;box-shadow:0 4px 24px rgba(91,44,141,.45);}
.e-cta--calc:hover{background:var(--v2);transform:translateY(-2px);}
.e-cta--wa{background:var(--wa);color:white;box-shadow:0 4px 24px rgba(37,211,102,.3);}
.e-cta--wa:hover{background:#1da851;transform:translateY(-2px);}
.e-cta svg{width:20px;height:20px;}

/* DÉLICES */
.delices{background:linear-gradient(135deg,#1a0a2e,#0f0a1a);padding:100px 40px;position:relative;z-index:5;}
.d-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;}
.d-map{border-radius:20px;overflow:hidden;border:1px solid rgba(167,139,250,.15);box-shadow:0 20px 60px rgba(0,0,0,.4);}
.d-map iframe{width:100%;height:360px;border:none;display:block;}
.d-mapfoot{background:rgba(255,255,255,.04);padding:16px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;}
.d-addr strong{color:white;font-size:14px;font-weight:600;display:block;margin-bottom:2px;}
.d-addr span{font-size:12px;color:rgba(255,255,255,.4);}
.d-go{display:flex;align-items:center;gap:6px;background:var(--gold);color:var(--ink2);padding:8px 16px;border-radius:50px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;transition:all .2s;}
.d-go:hover{background:var(--goldd);color:white;}
.hr-list{margin-top:20px;}
.hr-row{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.06);font-size:13px;}
.hr-row:last-child{border-bottom:none;}
.hr-row.today{background:rgba(167,139,250,.08);margin:0 -8px;padding:9px 8px;border-radius:8px;border-bottom:none;}
.hr-day{color:rgba(255,255,255,.5);}
.hr-day.today{color:var(--lav);font-weight:600;}
.hr-time{color:rgba(255,255,255,.8);}
.hr-time.today{color:var(--gold);font-weight:600;}
.open-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(22,163,74,.15);border:1px solid rgba(22,163,74,.3);border-radius:50px;padding:5px 14px;font-size:11px;font-weight:700;color:#4ade80;margin-top:16px;}
.o-dot{width:6px;height:6px;border-radius:50%;background:#4ade80;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.d-actions{margin-top:24px;display:flex;flex-direction:column;gap:10px;}
.d-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:13px 20px;border-radius:12px;font-size:14px;font-weight:600;text-decoration:none;transition:all .25s;}
.d-btn--wa{background:var(--wa);color:white;box-shadow:0 4px 16px rgba(37,211,102,.25);}
.d-btn--wa:hover{background:#1da851;}
.d-btn--map{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:white;}
.d-btn--map:hover{background:rgba(255,255,255,.1);}

/* FINAL CTA */
.final{background:var(--ink);padding:120px 40px;text-align:center;position:relative;z-index:5;overflow:hidden;}
.final::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 50%,rgba(91,44,141,.16),transparent 70%);pointer-events:none;}
.final-inner{position:relative;z-index:1;}
.final-t{font-family:"Cormorant Garamond",serif;font-size:clamp(40px,7vw,88px);font-weight:300;line-height:.95;margin-bottom:20px;}
