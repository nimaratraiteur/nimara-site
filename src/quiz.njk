---
layout: layouts/page
title: Quel Nimara êtes-vous ?
subtitle: "5 questions, 60 secondes, votre recommandation Nimara personnalisée."
description: "Quiz Nimara : 5 questions pour découvrir quelle formule Nimara vous correspond. Pâtisseries, box midi, événement. Recommandation personnalisée + offre exclusive."
eyebrow: "Quiz · 60 secondes"
permalink: /quiz/
---

<section class="section" id="quiz">
  <div class="container" style="max-width:720px">

    <!-- Progress bar -->
    <div class="qz-progress">
      <div class="qz-progress-bar" id="qz-progress-bar"></div>
      <div class="qz-progress-text" id="qz-progress-text">Question 1 / 5</div>
    </div>

    <!-- Questions -->
    <div id="qz-stage">

      <!-- Q1 -->
      <div class="qz-question is-active" data-step="1">
        <h2 class="qz-title">Quelle est l'occasion ?</h2>
        <p class="qz-sub">Qu'est-ce qui vous amène chez Nimara aujourd'hui ?</p>
        <div class="qz-options">
          <button class="qz-option" data-answer="event-pro" data-next="2">
            <span class="qz-icon">🏢</span>
            <span class="qz-label">Événement d'entreprise</span>
            <span class="qz-sub-label">Séminaire, apéro, coffee break</span>
          </button>
          <button class="qz-option" data-answer="event-private" data-next="2">
            <span class="qz-icon">🎉</span>
            <span class="qz-label">Événement privé</span>
            <span class="qz-sub-label">Mariage, anniversaire, fête</span>
          </button>
          <button class="qz-option" data-answer="recurring" data-next="2">
            <span class="qz-icon">📦</span>
            <span class="qz-label">Commande régulière</span>
            <span class="qz-sub-label">Box midi pour l'équipe</span>
          </button>
          <button class="qz-option" data-answer="personal" data-next="2">
            <span class="qz-icon">🥐</span>
            <span class="qz-label">Juste pour moi</span>
            <span class="qz-sub-label">Pâtisseries, plats, gourmandise</span>
          </button>
        </div>
      </div>

      <!-- Q2 -->
      <div class="qz-question" data-step="2">
        <h2 class="qz-title">Pour combien de personnes ?</h2>
        <p class="qz-sub">Combien serez-vous ? (approximatif, c'est OK)</p>
        <div class="qz-options">
          <button class="qz-option" data-answer="1-5" data-next="3">
            <span class="qz-icon">👤</span>
            <span class="qz-label">1 à 5</span>
            <span class="qz-sub-label">Juste moi ou famille proche</span>
          </button>
          <button class="qz-option" data-answer="6-15" data-next="3">
            <span class="qz-icon">👥</span>
            <span class="qz-label">6 à 15</span>
            <span class="qz-sub-label">Équipe ou petit groupe</span>
          </button>
          <button class="qz-option" data-answer="16-30" data-next="3">
            <span class="qz-icon">👨‍👩‍👧‍👦</span>
            <span class="qz-label">16 à 30</span>
            <span class="qz-sub-label">Séminaire ou réunion</span>
          </button>
          <button class="qz-option" data-answer="30+" data-next="3">
            <span class="qz-icon">🎪</span>
            <span class="qz-label">30 et plus</span>
            <span class="qz-sub-label">Grand événement</span>
          </button>
        </div>
      </div>

      <!-- Q3 -->
      <div class="qz-question" data-step="3">
        <h2 class="qz-title">Plutôt sucré ou salé ?</h2>
        <p class="qz-sub">Pour qu'on sache où orienter nos suggestions…</p>
        <div class="qz-options">
          <button class="qz-option" data-answer="sweet" data-next="4">
            <span class="qz-icon">🍰</span>
            <span class="qz-label">Sucré</span>
            <span class="qz-sub-label">Pâtisseries Nimara</span>
          </button>
          <button class="qz-option" data-answer="savory" data-next="4">
            <span class="qz-icon">🍛</span>
            <span class="qz-label">Salé</span>
            <span class="qz-sub-label">Cuisine indienne Chavannes</span>
          </button>
          <button class="qz-option" data-answer="both" data-next="4">
            <span class="qz-icon">🥰</span>
            <span class="qz-label">Les deux</span>
            <span class="qz-sub-label">Pour un vrai régal complet</span>
          </button>
          <button class="qz-option" data-answer="surprise" data-next="4">
            <span class="qz-icon">🎲</span>
            <span class="qz-label">Surprenez-moi</span>
            <span class="qz-sub-label">Laissez Marine &amp; Inga décider</span>
          </button>
        </div>
      </div>

      <!-- Q4 -->
      <div class="qz-question" data-step="4">
        <h2 class="qz-title">Quand ça ?</h2>
        <p class="qz-sub">Quel est votre horizon temporel ?</p>
        <div class="qz-options">
          <button class="qz-option" data-answer="urgent" data-next="5">
            <span class="qz-icon">⚡</span>
            <span class="qz-label">Sous 24-48h</span>
            <span class="qz-sub-label">Un peu urgent</span>
          </button>
          <button class="qz-option" data-answer="this-week" data-next="5">
            <span class="qz-icon">📅</span>
            <span class="qz-label">Cette semaine</span>
            <span class="qz-sub-label">Dans les 3-7 jours</span>
          </button>
          <button class="qz-option" data-answer="2-weeks" data-next="5">
            <span class="qz-icon">📆</span>
            <span class="qz-label">Dans 2-3 semaines</span>
            <span class="qz-sub-label">J'ai le temps de préparer</span>
          </button>
          <button class="qz-option" data-answer="later" data-next="5">
            <span class="qz-icon">🌅</span>
            <span class="qz-label">Plus tard</span>
            <span class="qz-sub-label">Un mois ou plus</span>
          </button>
        </div>
      </div>

      <!-- Q5 : email -->
      <div class="qz-question" data-step="5">
        <h2 class="qz-title">🎁 Votre recommandation vous attend</h2>
        <p class="qz-sub">Nous envoyons votre formule personnalisée + un code exclusif par email.</p>
        <form id="qz-form" name="nimara-quiz" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="qz-form">
          <input type="hidden" name="form-name" value="nimara-quiz">
          <input type="hidden" name="answers" id="qz-answers">
          <p style="display:none"><input name="bot-field"></p>
          <input type="email" name="email" id="qz-email" placeholder="votre@email.com" required class="qz-input">
          <button type="submit" class="qz-submit">✨ Voir ma recommandation personnalisée</button>
          <p class="qz-note">Pas de spam. Un email avec votre formule + un code exclusif à utiliser en 14 jours.</p>
        </form>
      </div>

      <!-- Résultat -->
      <div class="qz-question" data-step="result">
        <div class="qz-result-emoji" id="qz-result-emoji">✨</div>
        <h2 class="qz-title" id="qz-result-title">Votre recommandation personnalisée</h2>
        <p class="qz-sub" id="qz-result-sub">D'après vos réponses, voici ce qu'on vous propose :</p>

        <div class="qz-result-card" id="qz-result-card">
          <!-- Injecté par JS -->
        </div>

        <div class="qz-result-code">
          <div class="qz-code-label">🎁 Votre code exclusif (valable 14 jours)</div>
          <div class="qz-code" id="qz-result-code">QUIZ10</div>
          <div class="qz-code-sub">-10% sur la formule recommandée</div>
        </div>

        <div class="qz-result-actions">
          <a id="qz-result-cta-main" href="/calculateur/" class="qz-cta-primary">🎯 Activer ma recommandation</a>
          <a href="https://wa.me/41225576020" target="_blank" rel="noopener" class="qz-cta-secondary">💬 Parler à l'équipe</a>
        </div>

        <button type="button" class="qz-restart" id="qz-restart">↻ Refaire le quiz</button>
      </div>

    </div>

  </div>
</section>

<style>
  .qz-progress{max-width:520px;margin:0 auto 2rem;position:relative}
  .qz-progress::before{content:"";position:absolute;inset:0;background:rgba(167,139,250,.15);border-radius:50px;height:6px;top:50%;transform:translateY(-50%)}
  .qz-progress-bar{background:linear-gradient(90deg,var(--violet,#5B2C8D),var(--lavender,#a78bfa));border-radius:50px;height:6px;width:20%;position:relative;z-index:1;transition:width .5s cubic-bezier(.2,.9,.35,1);box-shadow:0 0 12px rgba(167,139,250,.5)}
  .qz-progress-text{text-align:center;font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:var(--violet,#5B2C8D);font-weight:600;margin-top:10px}

  .qz-question{display:none;animation:qzFade .5s cubic-bezier(.2,.9,.35,1)}
  .qz-question.is-active{display:block}
  @keyframes qzFade{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}

  .qz-title{font-family:'Playfair Display',serif;font-size:clamp(1.75rem,4vw,2.4rem);font-weight:500;text-align:center;color:var(--violet,#5B2C8D);margin:0 0 .5rem}
  .qz-sub{text-align:center;color:var(--gray-500,#6b7280);font-size:.95rem;margin-bottom:2rem;line-height:1.55}

  .qz-options{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1rem;max-width:600px;margin:0 auto}
  .qz-option{background:white;border:2px solid rgba(167,139,250,.2);border-radius:14px;padding:1.25rem 1.5rem;display:flex;flex-direction:column;align-items:flex-start;gap:.4rem;cursor:pointer;transition:all .25s;font-family:inherit;text-align:left;font-size:inherit}
  .qz-option:hover{border-color:var(--violet,#5B2C8D);background:linear-gradient(135deg,#faf7ff,#fff);transform:translateY(-2px);box-shadow:0 12px 24px rgba(91,44,141,.12)}
  .qz-option.is-selected{border-color:var(--violet,#5B2C8D);background:linear-gradient(135deg,rgba(91,44,141,.05),rgba(167,139,250,.03))}
  .qz-icon{font-size:32px;line-height:1;margin-bottom:.25rem}
  .qz-label{font-size:1.05rem;font-weight:600;color:var(--ink,#1a1330)}
  .qz-sub-label{font-size:.8rem;color:var(--gray-500,#6b7280);font-weight:400}

  .qz-form{max-width:460px;margin:0 auto;display:flex;flex-direction:column;gap:.75rem}
  .qz-input{background:white;border:2px solid rgba(167,139,250,.25);padding:14px 18px;border-radius:12px;font-family:inherit;font-size:1rem;outline:none;transition:all .2s}
  .qz-input:focus{border-color:var(--violet,#5B2C8D);box-shadow:0 0 0 4px rgba(91,44,141,.1)}
  .qz-submit{background:linear-gradient(135deg,var(--violet,#5B2C8D),var(--lavender,#a78bfa));color:white;padding:16px 24px;border-radius:12px;font-family:inherit;font-weight:700;font-size:1rem;border:none;cursor:pointer;transition:all .25s;box-shadow:0 8px 20px rgba(91,44,141,.25)}
  .qz-submit:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(91,44,141,.4)}
  .qz-submit:disabled{opacity:.6;cursor:not-allowed;transform:none}
  .qz-note{font-size:.75rem;color:var(--gray-500,#6b7280);text-align:center;margin:.5rem 0 0}

  .qz-result-emoji{font-size:64px;text-align:center;margin-bottom:.5rem;animation:qzBounce 1s cubic-bezier(.2,.9,.35,1)}
  @keyframes qzBounce{0%{transform:scale(.3);opacity:0}60%{transform:scale(1.15)}100%{transform:scale(1);opacity:1}}
  .qz-result-card{background:linear-gradient(160deg,#faf7ff,#fff);border:2px solid var(--lavender,#a78bfa);border-radius:16px;padding:1.5rem 2rem;margin:1.5rem 0;box-shadow:0 12px 32px rgba(91,44,141,.12)}
  .qz-result-card h3{font-family:'Playfair Display',serif;font-size:1.5rem;margin:0 0 .5rem;color:var(--violet,#5B2C8D);font-weight:600}
  .qz-result-card p{color:var(--ink,#1a1330);margin:0 0 .75rem;font-size:.95rem;line-height:1.6}
  .qz-result-card ul{margin:.5rem 0;padding-left:1.25rem;font-size:.9rem;color:var(--gray-500,#6b7280)}
  .qz-result-card li{margin-bottom:.25rem}
  .qz-result-price{font-family:'Playfair Display',serif;font-size:1.6rem;font-weight:600;color:var(--violet,#5B2C8D);margin-top:.75rem}

  .qz-result-code{background:linear-gradient(135deg,rgba(245,158,11,.1),rgba(200,151,58,.05));border:1.5px dashed var(--gold,#c8973a);border-radius:14px;padding:1rem 1.5rem;margin:1rem 0;text-align:center}
  .qz-code-label{font-size:.75rem;color:var(--warn,#b7791f);font-weight:600;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.25rem}
  .qz-code{font-family:'SF Mono',Consolas,monospace;font-size:1.6rem;font-weight:700;letter-spacing:.2em;color:var(--violet,#5B2C8D);margin:.25rem 0}
  .qz-code-sub{font-size:.8rem;color:var(--gray-500,#6b7280);font-style:italic}

  .qz-result-actions{display:flex;gap:.75rem;flex-wrap:wrap;justify-content:center;margin-top:1.5rem}
  .qz-cta-primary{background:var(--violet,#5B2C8D);color:white;padding:14px 24px;border-radius:10px;text-decoration:none;font-weight:600;font-size:.95rem;transition:all .25s}
  .qz-cta-primary:hover{background:#4a2374;transform:translateY(-2px);box-shadow:0 8px 20px rgba(91,44,141,.3)}
  .qz-cta-secondary{background:white;color:var(--violet,#5B2C8D);border:1.5px solid var(--violet,#5B2C8D);padding:14px 24px;border-radius:10px;text-decoration:none;font-weight:600;font-size:.95rem;transition:all .25s}
  .qz-cta-secondary:hover{background:#faf7ff}

  .qz-restart{background:transparent;border:none;color:var(--gray-500,#6b7280);padding:.5rem 1rem;font-family:inherit;font-size:.85rem;cursor:pointer;margin:1.5rem auto 0;display:block;text-decoration:underline}
  .qz-restart:hover{color:var(--violet,#5B2C8D)}

  @media (max-width:560px){
    .qz-options{grid-template-columns:1fr}
    .qz-result-actions{flex-direction:column}
    .qz-cta-primary,.qz-cta-secondary{width:100%;text-align:center}
  }
</style>

<script>
(function(){
  const answers = {};
  const totalSteps = 5;
  const questions = document.querySelectorAll('.qz-question');
  const progressBar = document.getElementById('qz-progress-bar');
  const progressText = document.getElementById('qz-progress-text');

  function showStep(step) {
    questions.forEach(q => q.classList.remove('is-active'));
    const target = document.querySelector('[data-step="' + step + '"]');
    if (target) target.classList.add('is-active');

    if (step === 'result') {
      progressBar.style.width = '100%';
      progressText.textContent = 'Votre recommandation ✨';
    } else {
      const pct = (parseInt(step) / totalSteps) * 100;
      progressBar.style.width = pct + '%';
      progressText.textContent = 'Question ' + step + ' / ' + totalSteps;
    }
  }

  document.querySelectorAll('.qz-option').forEach(btn => {
    btn.addEventListener('click', () => {
      const step = btn.closest('.qz-question').dataset.step;
      const answer = btn.dataset.answer;
      const next = btn.dataset.next;
      answers['q' + step] = answer;
      btn.closest('.qz-options').querySelectorAll('.qz-option').forEach(b => b.classList.remove('is-selected'));
      btn.classList.add('is-selected');
      setTimeout(() => showStep(next), 250);
      if (typeof gtag === 'function') gtag('event', 'quiz_answer', { event_category: 'conversion', step: step, answer: answer });
    });
  });

  // Form submit
  const form = document.getElementById('qz-form');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const emailInput = document.getElementById('qz-email');
    answers.email = emailInput.value;
    answers.q5 = emailInput.value;
    document.getElementById('qz-answers').value = JSON.stringify(answers);

    const submitBtn = form.querySelector('.qz-submit');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Envoi...';

    const formData = new FormData(form);
    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(formData).toString()
    }).then(() => {
      showResult();
    }).catch(() => {
      showResult(); // Afficher quand même côté client
    });
  });

  function showResult() {
    const recommendation = computeRecommendation(answers);
    document.getElementById('qz-result-emoji').textContent = recommendation.emoji;
    document.getElementById('qz-result-card').innerHTML = `
      <h3>${recommendation.title}</h3>
      <p>${recommendation.desc}</p>
      ${recommendation.items ? '<ul>' + recommendation.items.map(i => '<li>' + i + '</li>').join('') + '</ul>' : ''}
      ${recommendation.price ? '<div class="qz-result-price">' + recommendation.price + '</div>' : ''}
    `;
    document.getElementById('qz-result-code').textContent = recommendation.code;
    document.getElementById('qz-result-cta-main').href = recommendation.ctaLink;
    document.getElementById('qz-result-cta-main').textContent = recommendation.ctaLabel;
    showStep('result');
    if (typeof gtag === 'function') gtag('event', 'quiz_completed', { event_category: 'conversion', recommendation: recommendation.type });
  }

  function computeRecommendation(a) {
    const occasion = a.q1;
    const people = a.q2;
    const taste = a.q3;
    const timing = a.q4;

    // Événement pro ou privé → calculateur
    if (occasion === 'event-pro' || occasion === 'event-private') {
      const urgentBoost = timing === 'urgent' ? ' ⏱️ Priorité sur un créneau urgent.' : '';
      if (people === '30+') {
        return {
          emoji: '🎊', type: 'event-big',
          title: 'Formule Sur Mesure',
          desc: 'Pour votre événement de 30+ personnes, on compose votre menu avec Marine &amp; Inga.' + urgentBoost,
          items: ['Menu personnalisé', 'Service &amp; mise en place', 'Livraison Genève'],
          price: 'À partir de CHF 28/pers.',
          code: 'EVENT10', ctaLink: '/calculateur/', ctaLabel: '🧮 Calculer mon devis'
        };
      }
      return {
        emoji: '🎉', type: 'event-mid',
        title: occasion === 'event-pro' ? 'Formule Séminaire' : 'Formule Événement Privé',
        desc: 'Parfait pour votre groupe. Notre équipe prépare tout, vous profitez.' + urgentBoost,
        items: ['Entrées + plats + desserts', 'Livraison &amp; installation', 'Sur mesure selon vos goûts'],
        price: 'À partir de CHF 22/pers.',
        code: 'EVENT10', ctaLink: '/calculateur/', ctaLabel: '🧮 Calculer mon devis'
      };
    }

    // Commande régulière (B2B)
    if (occasion === 'recurring') {
      const boxType = taste === 'savory' ? 'Découverte' : taste === 'sweet' ? 'Premium' : 'Découverte';
      return {
        emoji: '📦', type: 'box-recurring',
        title: 'Pack Box Midi ' + boxType + ' × 5',
        desc: 'La solution parfaite pour nourrir votre équipe régulièrement. Commandez 1×/sem, on livre frais chaque matin.',
        items: ['Livraison Genève incluse', 'Commandez 24h à l\'avance', 'Changement menu chaque jour'],
        price: boxType === 'Premium' ? 'CHF 135 (les 5)' : 'CHF 100 (les 5)',
        code: 'EQUIPE15', ctaLink: '/boutique/', ctaLabel: '🛒 Commander maintenant'
      };
    }

    // Personnel
    if (taste === 'sweet' || taste === 'surprise') {
      return {
        emoji: '🥐', type: 'sweet-personal',
        title: 'Coffret Découverte Nimara',
        desc: 'Nos 5 pâtisseries signature dans un coffret : banana bread, cheesecake spéculos, brookie, pecan pie, cinnamon roll.',
        items: ['5 pâtisseries artisanales', 'Récupération stand ou livraison', 'Le format parfait pour tester'],
        price: 'CHF 35',
        code: 'PATIS10', ctaLink: '/boutique/', ctaLabel: '🛒 Acheter le coffret'
      };
    }
    if (taste === 'savory') {
      return {
        emoji: '🍛', type: 'savory-personal',
        title: 'Box Découverte Indienne',
        desc: 'Plongez dans les saveurs Chavannes : un plat signature + riz + accompagnement + entrée ou dessert.',
        items: ['Butter chicken, Saag Paneer, Vindaloo… au choix', 'Naans frais chaque matin', 'Chutneys maison'],
        price: 'CHF 19.90',
        code: 'INDIA10', ctaLink: 'https://wa.me/41225576020?text=Bonjour%20Nimara%2C%20je%20souhaite%20commander%20une%20Box%20Découverte', ctaLabel: '💬 Commander WhatsApp'
      };
    }
    // Both
    return {
      emoji: '🥰', type: 'mixed-personal',
      title: 'Menu Nimara Complet',
      desc: 'Le meilleur de nos deux mondes : un plat indien + une pâtisserie Nimara. Le bonheur absolu.',
      items: ['Butter chicken + riz + naan', 'Pâtisserie au choix (cheesecake, brookie…)'],
      price: 'À partir de CHF 28',
      code: 'DUO10', ctaLink: 'https://wa.me/41225576020?text=Bonjour%20Nimara%2C%20je%20souhaite%20le%20menu%20complet', ctaLabel: '💬 Commander WhatsApp'
    };
  }

  document.getElementById('qz-restart').addEventListener('click', () => {
    Object.keys(answers).forEach(k => delete answers[k]);
    document.querySelectorAll('.qz-option.is-selected').forEach(b => b.classList.remove('is-selected'));
    document.getElementById('qz-email').value = '';
    const submitBtn = form.querySelector('.qz-submit');
    submitBtn.disabled = false;
    submitBtn.textContent = '✨ Voir ma recommandation personnalisée';
    showStep('1');
  });

  showStep('1');
})();
</script>
