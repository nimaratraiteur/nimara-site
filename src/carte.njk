<script>
// LANG
let lang = localStorage.getItem('nimara-lang') || 'fr';
function setLang(l) {
  lang = l; localStorage.setItem('nimara-lang', l);
  document.querySelectorAll('[data-fr]').forEach(el => {
    const v = el.getAttribute('data-' + l);
    if (!v) return;
    if (v.includes('<')) el.innerHTML = v; else el.textContent = v;
  });
  document.querySelectorAll('.lang-btn').forEach(b => b.classList.toggle('active', b.textContent === l.toUpperCase()));
}
setLang(lang);

// SCROLL NAV
function goTo(id) { const el = document.getElementById(id); if(el) { const offset = 130; const top = el.getBoundingClientRect().top + window.pageYOffset - offset; window.scrollTo({top, behavior:'smooth'}); } }
const navSections = [
  {id:'sucres',tab:'nt-sucres'},{id:'collations',tab:'nt-collations'},
  {id:'plats',tab:'nt-plats'},{id:'boxes',tab:'nt-boxes'},{id:'boissons',tab:'nt-boissons'}
];
window.addEventListener('scroll', () => {
  const y = scrollY + 130;
  let active = navSections[0];
  navSections.forEach(s => { const el = document.getElementById(s.id); if(el && y >= el.offsetTop) active = s; });
  navSections.forEach(s => document.getElementById(s.tab)?.classList.toggle('active', s.id === active.id));
});

// FILTER
function filter(f, btn) {
  document.querySelectorAll('.f-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('[data-tags]').forEach(card => {
    const tags = card.dataset.tags || '';
    card.dataset.hidden = (f === 'all' || tags.includes(f)) ? 'false' : 'true';
  });
}

// CART
const cart = {};
function addToCart(name, price, unit) {
  const key = name;
  if (!cart[key]) cart[key] = {name, price: parseFloat(price), unit, qty: 0};
  cart[key].qty++;
  updateCartUI();
  // Animate button
  const btns = document.querySelectorAll(`[data-cart-name="${CSS.escape(name)}"]`);
  btns.forEach(b => { b.classList.add('in-cart'); b.textContent = cart[key].qty; });
}
function removeFromCart(name) {
  if (!cart[name]) return;
  cart[name].qty--;
  if (cart[name].qty <= 0) delete cart[name];
  updateCartUI();
  const btns = document.querySelectorAll(`[data-cart-name="${CSS.escape(name)}"]`);
  btns.forEach(b => {
    if (!cart[name]) { b.classList.remove('in-cart'); b.textContent = '+'; }
    else b.textContent = cart[name].qty;
  });
}
function updateCartUI() {
  const items = Object.values(cart);
  const totalQty = items.reduce((s, i) => s + i.qty, 0);
  const totalPrice = items.reduce((s, i) => s + i.qty * i.price, 0);
  const badge = document.getElementById('cart-badge');
  const countEl = document.getElementById('cart-count');
  const totalBadge = document.getElementById('cart-total-badge');
  const itemsEl = document.getElementById('cart-items');
  const footerEl = document.getElementById('cart-footer');
  const totalPriceEl = document.getElementById('cart-total-price');

  badge.classList.toggle('show', totalQty > 0);
  countEl.textContent = totalQty;
  totalBadge.textContent = '· CHF ' + totalPrice.toFixed(2);

  if (items.length === 0) {
    itemsEl.innerHTML = '<div class="cart-empty">Votre panier est vide</div>';
    footerEl.style.display = 'none';
    return;
  }
  footerEl.style.display = '';
  totalPriceEl.textContent = 'CHF ' + totalPrice.toFixed(2);
  itemsEl.innerHTML = items.map(i => `
    <div class="cart-item">
      <div class="cart-item__info">
        <span class="cart-item__name">${i.name}</span>
        <span class="cart-item__price">CHF ${i.price.toFixed(2)} / ${i.unit}</span>
      </div>
      <div class="cart-item__controls">
        <button class="cart-item__qty-btn" onclick="removeFromCart('${i.name.replace(/'/g,"\\'")}')">−</button>
        <span class="cart-item__qty">${i.qty}</span>
        <button class="cart-item__qty-btn" onclick="addToCart('${i.name.replace(/'/g,"\\'")}',${i.price},'${i.unit}')">+</button>
      </div>
    </div>
  `).join('');
}
function toggleCart() {
  const panel = document.getElementById('cart-panel');
  const overlay = document.getElementById('cart-overlay');
  const isOpen = panel.classList.contains('open');
  panel.classList.toggle('open', !isOpen);
  overlay.classList.toggle('show', !isOpen);
  document.body.style.overflow = isOpen ? '' : 'hidden';
}
function sendCartWhatsApp() {
  const items = Object.values(cart);
  if (!items.length) return;
  const total = items.reduce((s, i) => s + i.qty * i.price, 0);
  let msg = 'Bonjour Nimara 🙏\n\nJe souhaite commander :\n\n';
  items.forEach(i => { msg += `• ${i.qty}× ${i.name} (CHF ${(i.qty * i.price).toFixed(2)})\n`; });
  msg += `\nTotal : CHF ${total.toFixed(2)}\n\nMerci !`;
  window.open('https://wa.me/41225576020?text=' + encodeURIComponent(msg), '_blank');
}

// INIT: inject cart buttons into product cards
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.pc').forEach(card => {
    const nameEl = card.querySelector('.pc__name');
    const priceEl = card.querySelector('.pc__price');
    if (!nameEl || !priceEl) return;
    const name = nameEl.textContent.trim();
    const priceText = priceEl.textContent.trim();
    const priceMatch = priceText.match(/[\d.]+/);
    if (!priceMatch) return;
    const price = priceMatch[0];
    const imgDiv = card.querySelector('.pc__img');
    if (imgDiv) {
      imgDiv.style.position = 'relative';
      const btn = document.createElement('button');
      btn.className = 'cart-add';
      btn.setAttribute('data-cart-name', name);
      btn.textContent = '+';
      btn.onclick = (e) => { e.stopPropagation(); addToCart(name, price, 'pièce'); };
      imgDiv.appendChild(btn);
    }
  });
  // Also for box cards
  document.querySelectorAll('.box-card').forEach(card => {
    const nameEl = card.querySelector('.box-card__name');
    const priceEl = card.querySelector('.box-card__price');
    if (!nameEl || !priceEl) return;
    const name = nameEl.textContent.trim();
    const priceText = priceEl.textContent.trim();
    const priceMatch = priceText.match(/[\d.]+/);
    if (!priceMatch) return;
    const price = priceMatch[0];
    const imgDiv = card.querySelector('.box-card__img');
    if (imgDiv) {
      imgDiv.style.position = 'relative';
      const btn = document.createElement('button');
      btn.className = 'cart-add';
      btn.setAttribute('data-cart-name', name);
      btn.textContent = '+';
      btn.onclick = (e) => { e.stopPropagation(); addToCart(name, price, 'box'); };
      imgDiv.appendChild(btn);
    }
  });
});
</script>
