<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --v:#5B2C8D;--v2:#7c3aed;--lav:#a78bfa;
  --gold:#f59e0b;--goldd:#d97706;
  --ink:#0f0a1a;--cream:#fffbf0;--warm:#fef3c7;
  --mu:#78716c;--border:#e7e0d5;
  --wa:#25d366;
  --green:#16a34a;
}
html{scroll-behavior:smooth;overflow-x:hidden;}
body{font-family:"DM Sans",sans-serif;background:var(--cream);color:#1c1007;overflow-x:hidden;}

/* NAV */
.nav{position:sticky;top:0;z-index:200;background:rgba(255,251,240,.97);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);padding:0 32px;display:flex;align-items:center;height:60px;gap:8px;}
.logo{display:flex;align-items:center;gap:8px;text-decoration:none;}
.logo-n{width:32px;height:32px;background:var(--v);border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:"Cormorant Garamond",serif;font-size:17px;color:white;font-weight:600;}
.logo-brand{font-size:16px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#1c1007;}
.nav-tabs{display:flex;flex:1;overflow-x:auto;scrollbar-width:none;margin:0 8px;}
.nav-tabs::-webkit-scrollbar{display:none;}
.nav-tab{padding:0 12px;height:60px;display:flex;align-items:center;font-size:12px;font-weight:500;color:var(--mu);border-bottom:2px solid transparent;text-decoration:none;white-space:nowrap;transition:all .2s;cursor:pointer;background:none;border-left:none;border-right:none;border-top:none;font-family:"DM Sans",sans-serif;}
.nav-tab:hover,.nav-tab.active{color:var(--v);border-bottom-color:var(--gold);}
.nav-r{display:flex;align-items:center;gap:8px;margin-left:auto;}
.lang-sw{display:flex;background:var(--warm);border-radius:50px;padding:3px;gap:2px;border:1px solid var(--border);}
.lang-btn{padding:3px 10px;border-radius:50px;font-size:11px;font-weight:600;border:none;cursor:pointer;background:transparent;color:var(--mu);transition:all .2s;font-family:"DM Sans",sans-serif;}
.lang-btn.active{background:var(--gold);color:white;}
.nav-wa{display:flex;align-items:center;gap:5px;background:var(--wa);color:white;padding:7px 14px;border-radius:50px;font-size:12px;font-weight:700;text-decoration:none;}
.nav-wa svg{width:13px;height:13px;}

/* HERO COMPACT */
.hero-compact{background:linear-gradient(135deg,#fffbf0,#fef3c7,#fde68a);padding:40px 32px 32px;text-align:center;position:relative;overflow:hidden;}
.hero-compact::before{content:"";position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23f59e0b' fill-opacity='0.06'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");pointer-events:none;}
.hero-compact h1{font-family:"Cormorant Garamond",serif;font-size:clamp(32px,5vw,56px);font-weight:300;color:#1c1007;position:relative;z-index:1;}
.hero-compact h1 em{font-style:italic;color:var(--goldd);}
.hero-compact p{font-size:14px;color:var(--mu);margin-top:8px;position:relative;z-index:1;}

/* FILTERS */
.filters-sticky{position:sticky;top:60px;z-index:100;background:rgba(255,251,240,.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:10px 32px;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;}
.filters-sticky::-webkit-scrollbar{display:none;}
.f-btn{display:flex;align-items:center;gap:5px;background:white;border:1.5px solid var(--border);border-radius:50px;padding:6px 14px;font-size:12px;font-weight:600;color:var(--mu);cursor:pointer;font-family:"DM Sans",sans-serif;transition:all .2s;white-space:nowrap;}
.f-btn:hover{border-color:var(--v);color:var(--v);}
.f-btn.active{background:var(--v);border-color:var(--v);color:white;}
.f-btn.active.g{background:var(--green);border-color:var(--green);}
.f-btn.active.sg{background:#ea580c;border-color:#ea580c;}
.f-btn.active.vg{background:#059669;border-color:#059669;}
.f-btn.active.h{background:#7c3aed;border-color:#7c3aed;}

/* SECTIONS */
.section{max-width:1200px;margin:0 auto;padding:48px 32px 0;}
.section-head{margin-bottom:28px;padding-bottom:20px;border-bottom:2px solid var(--warm);display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;}
.section-kicker{font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;margin-bottom:6px;display:block;}
.section-kicker.s{color:var(--goldd);}
.section-kicker.g{color:var(--green);}
.section-kicker.p{color:var(--v);}
.section-title{font-family:"Cormorant Garamond",serif;font-size:clamp(28px,4vw,44px);font-weight:300;line-height:1;}
.section-title em{font-style:italic;}
.section-title em.s{color:var(--gold);}
.section-title em.g{color:var(--green);}
.section-title em.p{color:var(--v);}
.section-desc{font-size:13px;color:var(--mu);line-height:1.6;max-width:280px;}

/* SUB SECTION */
.sub-sec{max-width:1200px;margin:0 auto;padding:0 32px 16px;}
.sub-head{display:flex;align-items:center;gap:10px;margin:28px 0 16px;}
.sub-pill{display:inline-flex;align-items:center;gap:5px;background:white;border:1px solid var(--border);border-radius:50px;padding:4px 12px;font-size:10px;font-weight:700;color:var(--mu);letter-spacing:.08em;text-transform:uppercase;}
.sub-line{flex:1;height:1px;background:var(--border);}

/* PRODUCT GRID */
.prod-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;}
.prod-grid.small{grid-template-columns:repeat(auto-fill,minmax(200px,1fr));}

/* PRODUCT CARD */
.pc{background:white;border-radius:14px;overflow:hidden;border:1px solid var(--border);transition:all .3s;box-shadow:0 2px 8px rgba(0,0,0,.04);}
.pc:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,0,0,.1);border-color:var(--gold);}
.pc[data-hidden="true"]{display:none;}
.pc__img{height:190px;overflow:hidden;position:relative;background:#fef3c7;}
.pc__img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s;}
.pc:hover .pc__img img{transform:scale(1.06);}
.img-ph{width:100%;height:100%;background:linear-gradient(135deg,#fef3c7,#fde68a);display:flex;align-items:center;justify-content:center;font-size:40px;}
.pc__cat{position:absolute;top:10px;left:10px;border-radius:50px;padding:3px 10px;font-size:9px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;}
.cat-vege{background:rgba(22,163,74,.9);color:white;}
.cat-halal{background:rgba(124,58,237,.9);color:white;}
.cat-vegan{background:rgba(5,150,105,.9);color:white;}
.cat-sg{background:rgba(234,88,12,.9);color:white;}
.pc__body{padding:14px 16px 16px;}
.pc__name{font-family:"Cormorant Garamond",serif;font-size:19px;font-weight:500;line-height:1.1;margin-bottom:5px;color:#1c1007;}
.pc__desc{font-size:11px;font-weight:300;color:var(--mu);line-height:1.55;margin-bottom:10px;}
.pc__price{font-size:12px;font-weight:700;color:var(--goldd);margin-bottom:8px;}
.allergens{border-top:1px solid var(--border);padding-top:8px;margin-top:2px;}
.allergens-title{font-size:9px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--mu);margin-bottom:5px;}
.tags{display:flex;flex-wrap:wrap;gap:3px;}
.tag{display:inline-block;font-size:9px;font-weight:600;border-radius:50px;padding:2px 7px;border:1px solid transparent;}
.tag-gluten{background:#fef9c3;color:#a16207;border-color:#fde047;}
.tag-lait{background:#e0f2fe;color:#0284c7;border-color:#bae6fd;}
.tag-oeufs{background:#fff7ed;color:#c2410c;border-color:#fed7aa;}
.tag-noix{background:#fdf2f8;color:#9333ea;border-color:#e9d5ff;}
.tag-sesame{background:#fef3c7;color:#b45309;border-color:#fde68a;}
.tag-vege{background:#dcfce7;color:var(--green);border-color:#bbf7d0;}
.tag-vegan{background:#d1fae5;color:#059669;border-color:#6ee7b7;}
.tag-halal{background:#ede9fe;color:var(--v);border-color:#ddd6fe;}
.tag-sg{background:#ffedd5;color:#ea580c;border-color:#fdba74;}

/* LUNCH BOXES SPECIAL */
.box-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;}
.box-card{background:white;border-radius:14px;overflow:hidden;border:1px solid var(--border);transition:all .3s;box-shadow:0 2px 8px rgba(0,0,0,.04);}
.box-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,0,0,.1);border-color:var(--v);}
.box-card[data-hidden="true"]{display:none;}
.box-card__img{height:180px;overflow:hidden;background:#ede9fe;}
.box-card__img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s;}
.box-card:hover .box-card__img img{transform:scale(1.04);}
.box-card__body{padding:14px 16px;}
.box-card__name{font-family:"Cormorant Garamond",serif;font-size:18px;font-weight:500;margin-bottom:4px;color:#1c1007;}
.box-card__contents{font-size:11px;color:var(--mu);line-height:1.55;margin-bottom:8px;}
.box-card__tags{display:flex;flex-wrap:wrap;gap:3px;}
.box-note{grid-column:1/-1;background:var(--lavl,#ede9fe);border:1px solid #ddd6fe;border-radius:12px;padding:14px 18px;font-size:13px;color:var(--v);line-height:1.6;}
.box-note strong{font-weight:700;}

/* B2B BANNER */
.b2b-banner{max-width:1200px;margin:32px auto 0;padding:0 32px;}
.b2b{background:linear-gradient(135deg,#1c4a2a,#2d6a3f);border-radius:16px;padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;}
.b2b h3{font-family:"Cormorant Garamond",serif;font-size:26px;font-weight:300;color:white;}
.b2b h3 em{font-style:italic;color:#86efac;}
.b2b p{font-size:13px;color:rgba(255,255,255,.6);max-width:380px;line-height:1.6;margin-top:4px;}
.b2b-btn{background:white;color:#1c4a2a;padding:12px 24px;border-radius:10px;text-decoration:none;font-size:13px;font-weight:700;white-space:nowrap;transition:all .2s;}
.b2b-btn:hover{background:#f0fdf4;transform:translateY(-1px);}

/* SECTION DIVIDER */
.div{max-width:1200px;margin:0 auto;padding:0 32px;}
.div hr{border:none;height:1px;background:linear-gradient(to right,transparent,var(--border),transparent);margin:12px 0;}

/* WA FAB */
.wa-fab{position:fixed;bottom:24px;right:24px;z-index:300;width:56px;height:56px;border-radius:50%;background:var(--wa);color:white;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(37,211,102,.4);text-decoration:none;transition:all .3s;}
.wa-fab:hover{transform:scale(1.08);}
.wa-fab svg{width:26px;height:26px;}

/* FOOTER */
footer{background:#1c1007;margin-top:64px;padding:32px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;}
.f-logo{font-family:"Cormorant Garamond",serif;font-size:20px;color:white;}
.f-logo span{color:var(--gold);font-style:italic;}
.f-links{display:flex;gap:18px;flex-wrap:wrap;}
.f-links a{color:rgba(255,255,255,.35);font-size:12px;text-decoration:none;transition:color .2s;}
.f-links a:hover{color:rgba(255,255,255,.7);}

/* CART */
.cart-add{position:absolute;bottom:10px;right:10px;width:34px;height:34px;border-radius:50%;background:var(--v);color:white;border:none;cursor:pointer;font-size:18px;font-weight:700;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(91,44,141,.4);transition:all .2s;z-index:5;font-family:"DM Sans",sans-serif;}
.cart-add:hover{transform:scale(1.12);background:var(--v2);}
.cart-add.in-cart{background:var(--gold);color:white;}
.cart-badge{position:fixed;bottom:90px;right:24px;z-index:310;background:var(--v);color:white;border-radius:16px;padding:12px 20px;box-shadow:0 8px 32px rgba(91,44,141,.35);cursor:pointer;display:none;align-items:center;gap:10px;font-size:14px;font-weight:600;transition:all .3s;font-family:"DM Sans",sans-serif;border:none;}
.cart-badge:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(91,44,141,.45);}
.cart-badge.show{display:flex;}
.cart-badge__count{background:var(--gold);color:white;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;}
.cart-panel{position:fixed;bottom:0;left:0;right:0;z-index:400;background:white;border-radius:20px 20px 0 0;box-shadow:0 -8px 40px rgba(0,0,0,.15);transform:translateY(100%);transition:transform .35s cubic-bezier(.22,1,.36,1);max-height:80vh;overflow-y:auto;}
.cart-panel.open{transform:translateY(0);}
.cart-panel__header{display:flex;align-items:center;justify-content:space-between;padding:20px 24px 12px;border-bottom:1px solid var(--border);position:sticky;top:0;background:white;z-index:1;}
.cart-panel__title{font-family:"Cormorant Garamond",serif;font-size:24px;font-weight:400;}
.cart-panel__close{background:none;border:none;font-size:24px;cursor:pointer;color:var(--mu);padding:4px;}
.cart-panel__items{padding:16px 24px;}
.cart-item{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);}
.cart-item:last-child{border-bottom:none;}
.cart-item__info{display:flex;flex-direction:column;gap:2px;}
.cart-item__name{font-size:14px;font-weight:500;}
.cart-item__price{font-size:12px;color:var(--goldd);font-weight:600;}
.cart-item__controls{display:flex;align-items:center;gap:10px;}
.cart-item__qty-btn{width:28px;height:28px;border-radius:50%;border:1.5px solid var(--border);background:white;cursor:pointer;font-size:14px;font-weight:600;display:flex;align-items:center;justify-content:center;transition:all .2s;font-family:"DM Sans",sans-serif;color:var(--ink);}
.cart-item__qty-btn:hover{border-color:var(--v);color:var(--v);}
.cart-item__qty{font-size:14px;font-weight:700;min-width:20px;text-align:center;}
.cart-panel__footer{padding:16px 24px 24px;border-top:1px solid var(--border);position:sticky;bottom:0;background:white;}
.cart-total{display:flex;justify-content:space-between;font-size:16px;font-weight:700;margin-bottom:14px;}
.cart-total__price{color:var(--goldd);}
.cart-wa-btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;background:var(--wa);color:white;padding:14px;border-radius:12px;text-decoration:none;font-size:15px;font-weight:700;border:none;cursor:pointer;transition:all .2s;font-family:"DM Sans",sans-serif;}
.cart-wa-btn:hover{filter:brightness(1.08);transform:translateY(-1px);}
.cart-wa-btn svg{width:18px;height:18px;}
.cart-empty{text-align:center;padding:32px 24px;color:var(--mu);font-size:14px;}
.cart-overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:390;opacity:0;pointer-events:none;transition:opacity .3s;}
.cart-overlay.show{opacity:1;pointer-events:auto;}

/* PRINT */
@media print{
  .nav,.filters-sticky,.wa-fab,.b2b-banner,footer{display:none!important;}
  .pc[data-hidden="true"]{display:block!important;}
  .pc,.box-card{break-inside:avoid;}
  body{background:white;}
  .hero-compact{background:white;}
}

/* RESPONSIVE */
@media(max-width:768px){
  .nav{padding:0 16px;}
  .section,.sub-sec,.b2b-banner,.div{padding-left:16px;padding-right:16px;}
  .filters-sticky{padding:10px 16px;}
  .section-desc{display:none;}
  .prod-grid{grid-template-columns:1fr 1fr;gap:10px;}
  .pc__img{height:150px;}
  .box-grid{grid-template-columns:1fr;}
  footer{padding:20px 16px;flex-direction:column;text-align:center;}
}
@media(max-width:400px){
  .prod-grid{grid-template-columns:1fr;}
}
</style>
</head>
<body>

<!-- NAV -->
<nav class="nav">
  <a href="/" class="logo"><div class="logo-n">N</div><span class="logo-brand">Nimara</span></a>
  <div class="nav-tabs">
    <button class="nav-tab active" id="nt-sucres" onclick="goTo('sucres')">🍰 Sucrés</button>
    <button class="nav-tab" id="nt-collations" onclick="goTo('collations')">🥟 Collations</button>
    <button class="nav-tab" id="nt-plats" onclick="goTo('plats')">🍛 Plats</button>
    <button class="nav-tab" id="nt-boxes" onclick="goTo('boxes')">🥡 Lunch Boxes</button>
    <button class="nav-tab" id="nt-boissons" onclick="goTo('boissons')">🥭 Boissons</button>
  </div>
  <div class="nav-r">
    <div class="lang-sw">
      <button class="lang-btn active" onclick="setLang('fr')">FR</button>
      <button class="lang-btn" onclick="setLang('en')">EN</button>
