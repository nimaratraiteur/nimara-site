<script>
// STATUS OUVERT/FERMÉ
(function(){
  const now = new Date();
  const day = now.getDay(), h = now.getHours() + now.getMinutes()/60;
  const open = (day>=1&&day<=5&&h>=7.5&&h<18.5)||(day===6&&h>=8&&h<17)||(day===0&&h>=9&&h<14);
  if (!open) {
    const badge = document.getElementById('openBadge');
    badge.className = 'open-badge closed';
    badge.querySelector('.open-dot').style.animation = 'none';
    document.getElementById('openLabel').textContent = 'Actuellement fermé';
    document.getElementById('statusDot').className = 's-dot red';
    document.getElementById('statusText').textContent = 'Stand fermé';
    document.getElementById('heroPillStatus').textContent = '🔴 Actuellement fermé';
    document.getElementById('heroPillStatus').style.cssText = 'background:rgba(220,38,38,.2);border-color:rgba(220,38,38,.4);color:#fca5a5';
  }
  // Highlight today
  const days = ['0','1,2,3,4,5','6'][day===0?0:day<=5?1:2];
  document.querySelectorAll('.hour-row').forEach(r => {
    const d = r.dataset.days || '';
    if (d.split(',').includes(String(day))) {
      r.classList.add('today');
      r.querySelector('.hour-day')?.classList.add('today');
      r.querySelector('.hour-time')?.classList.add('today');
    }
  });
})();

// REVEAL
const obs = new IntersectionObserver(e => e.forEach(x => { if(x.isIntersecting) x.target.classList.add('visible'); }), {threshold:.1});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// FAQ
function toggleFaq(btn) {
  const item = btn.closest('.faq-item');
  const answer = item.querySelector('.faq-a');
  const isOpen = btn.classList.contains('open');
  document.querySelectorAll('.faq-q.open').forEach(b => { b.classList.remove('open'); b.closest('.faq-item').querySelector('.faq-a').classList.remove('open'); });
  if (!isOpen) { btn.classList.add('open'); answer.classList.add('open'); }
}

// STRIP DRAG SCROLL
['strip1','strip2','strip3'].forEach(id => {
  const s = document.getElementById(id);
  if (!s) return;
  let down=false, sx, sl;
  s.addEventListener('mousedown', e => { down=true; sx=e.pageX-s.offsetLeft; sl=s.scrollLeft; });
  s.addEventListener('mouseleave', () => down=false);
  s.addEventListener('mouseup', () => down=false);
  s.addEventListener('mousemove', e => { if(!down) return; e.preventDefault(); s.scrollLeft=sl-(e.pageX-s.offsetLeft-sx)*1.5; });
});
</script>
