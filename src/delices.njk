<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --v:#5B2C8D;--v2:#7c3aed;--lav:#a78bfa;--lavl:#ede9fe;
  --gold:#f59e0b;--goldd:#d97706;--spice:#92400e;
  --ink:#1c1007;--cream:#fffbf0;--warm:#fef3c7;
  --mu:#78716c;--border:#e7e0d5;--paper:#fff;
  --wa:#25d366;--green:#16a34a;
}
html{scroll-behavior:smooth;overflow-x:hidden;}
body{font-family:"DM Sans",sans-serif;background:var(--cream);color:var(--ink);overflow-x:hidden;}

/* NAV */
.nav{position:sticky;top:0;z-index:200;background:rgba(255,251,240,.97);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);padding:0 32px;display:flex;align-items:center;justify-content:space-between;height:60px;}
.logo{display:flex;align-items:center;gap:8px;text-decoration:none;}
.logo-n{width:32px;height:32px;background:var(--v);border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:"Cormorant Garamond",serif;font-size:17px;color:white;font-weight:600;}
.logo-brand{font-size:16px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);}
.nav-links{display:flex;gap:6px;}
.nav-link{padding:7px 14px;border-radius:50px;font-size:13px;font-weight:500;text-decoration:none;color:var(--mu);transition:all .2s;}
.nav-link:hover{color:var(--ink);background:var(--warm);}
.nav-wa{display:flex;align-items:center;gap:6px;background:var(--wa);color:white;padding:8px 16px;border-radius:50px;font-size:13px;font-weight:700;text-decoration:none;transition:all .2s;}
.nav-wa:hover{background:#1da851;}
.nav-wa svg{width:14px;height:14px;}

/* HERO FULL */
.hero{position:relative;height:100svh;min-height:560px;display:flex;align-items:flex-end;overflow:hidden;background:#1c1007;}
.hero-bg{position:absolute;inset:0;}
.hero-bg img{width:100%;height:100%;object-fit:cover;display:block;opacity:.5;}
.hero-grad{position:absolute;inset:0;background:linear-gradient(to top,rgba(28,16,7,.97) 0%,rgba(28,16,7,.5) 45%,rgba(28,16,7,.15) 100%),linear-gradient(to right,rgba(28,16,7,.6) 0%,transparent 55%);}
.hero-content{position:relative;z-index:2;padding:0 40px 56px;max-width:680px;}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(245,158,11,.15);border:1px solid rgba(245,158,11,.3);border-radius:50px;padding:5px 16px;font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:18px;}
.hero-title{font-family:"Cormorant Garamond",serif;font-size:clamp(44px,8vw,88px);font-weight:300;line-height:.95;color:white;margin-bottom:16px;}
.hero-title em{font-style:italic;color:var(--gold);}
.hero-address{display:flex;align-items:center;gap:8px;font-size:16px;color:rgba(255,255,255,.65);margin-bottom:24px;}
.hero-address svg{color:var(--gold);flex-shrink:0;}
.hero-pills{display:flex;gap:10px;flex-wrap:wrap;}
.hero-pill{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);backdrop-filter:blur(8px);border-radius:50px;padding:8px 16px;font-size:13px;color:rgba(255,255,255,.8);font-weight:500;text-decoration:none;transition:all .25s;}
.hero-pill:hover{background:rgba(255,255,255,.18);color:white;}
.hero-pill.open{background:rgba(22,163,74,.2);border-color:rgba(22,163,74,.4);color:#4ade80;}

/* STATUS BAR */
.status-bar{background:var(--ink);color:white;display:flex;align-items:center;justify-content:center;gap:32px;padding:14px 32px;flex-wrap:wrap;}
.status-item{display:flex;align-items:center;gap:8px;font-size:13px;}
.s-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.s-dot.green{background:#4ade80;box-shadow:0 0 8px #4ade80;animation:pulse 2s infinite;}
.s-dot.red{background:#f87171;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
.s-label{color:rgba(255,255,255,.4);font-size:12px;margin-right:2px;}

/* 3 ACTIONS */
.actions-section{max-width:960px;margin:0 auto;padding:40px 32px 0;display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.action-card{border-radius:18px;padding:28px 24px;display:flex;flex-direction:column;gap:12px;text-decoration:none;transition:all .3s;}
.action-card:hover{transform:translateY(-4px);}
.action-card--map{background:linear-gradient(135deg,#1c4a2a,#16a34a);color:white;box-shadow:0 4px 24px rgba(22,163,74,.25);}
.action-card--map:hover{box-shadow:0 12px 40px rgba(22,163,74,.4);}
.action-card--wa{background:linear-gradient(135deg,#064e3b,var(--wa));color:white;box-shadow:0 4px 24px rgba(37,211,102,.2);}
.action-card--wa:hover{box-shadow:0 12px 40px rgba(37,211,102,.35);}
.action-card--uber{background:#000;color:white;box-shadow:0 4px 24px rgba(0,0,0,.2);}
.action-card--uber:hover{background:#111;box-shadow:0 12px 40px rgba(0,0,0,.3);}
.ac-icon{font-size:32px;}
.ac-title{font-size:16px;font-weight:700;}
.ac-desc{font-size:13px;opacity:.7;line-height:1.5;flex:1;}
.ac-arrow{font-size:20px;align-self:flex-end;opacity:.6;}

/* MAP + INFO */
.map-section{max-width:960px;margin:32px auto 0;padding:0 32px;display:grid;grid-template-columns:1fr 360px;gap:24px;align-items:start;}
.map-card{border-radius:20px;overflow:hidden;border:1px solid var(--border);box-shadow:0 4px 24px rgba(0,0,0,.08);}
.map-card iframe{width:100%;height:380px;border:none;display:block;}
.map-footer{background:white;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid var(--border);}
.map-addr strong{font-size:14px;font-weight:600;color:var(--ink);display:block;margin-bottom:2px;}
.map-addr span{font-size:12px;color:var(--mu);}
.go-btn{display:flex;align-items:center;gap:6px;background:var(--gold);color:var(--ink);padding:8px 16px;border-radius:50px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;transition:all .2s;}
.go-btn:hover{background:var(--goldd);color:white;}

/* SIDEBAR */
.sidebar{display:flex;flex-direction:column;gap:20px;}

/* HOURS */
.hours-card{background:white;border:1px solid var(--border);border-radius:20px;padding:24px;}
.card-title{font-family:"Cormorant Garamond",serif;font-size:22px;font-weight:400;color:var(--ink);margin-bottom:16px;}
.card-title em{font-style:italic;color:var(--goldd);}
.open-badge{display:inline-flex;align-items:center;gap:6px;border-radius:50px;padding:5px 14px;font-size:11px;font-weight:700;margin-bottom:14px;}
.open-badge.open{background:#dcfce7;color:var(--green);}
.open-badge.closed{background:#fee2e2;color:#b91c1c;}
.open-dot{width:6px;height:6px;border-radius:50%;background:currentColor;animation:pulse 2s infinite;}
.hours-list{}
.hour-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border);font-size:13px;}
.hour-row:last-child{border-bottom:none;}
.hour-row.today{background:var(--warm);margin:0 -10px;padding:8px 10px;border-radius:8px;border-bottom:none;}
.hour-day{color:var(--mu);}
.hour-day.today{color:var(--spice);font-weight:700;}
.hour-time{color:var(--ink);font-weight:500;}
.hour-time.today{color:var(--goldd);font-weight:700;}

/* TRANSPORT */
.transport-card{background:white;border:1px solid var(--border);border-radius:20px;padding:24px;}
.transport-list{display:flex;flex-direction:column;gap:0;}
.ti{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--border);}
.ti:last-child{border-bottom:none;padding-bottom:0;}
.ti-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;}
.ti-icon.tram{background:var(--warm);}
.ti-icon.walk{background:#dcfce7;}
.ti-icon.bike{background:#fff7ed;}
.ti-icon.car{background:#f1f5f9;}
.ti strong{font-size:13px;font-weight:600;display:block;margin-bottom:2px;color:var(--ink);}
.ti span{font-size:12px;color:var(--mu);line-height:1.5;}

/* PRODUITS DU STAND */
.products-section{max-width:960px;margin:40px auto 0;padding:0 32px;}
.section-head{margin-bottom:24px;}
.section-kicker{font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--goldd);display:block;margin-bottom:6px;}
.section-title{font-family:"Cormorant Garamond",serif;font-size:clamp(28px,4vw,44px);font-weight:300;line-height:1;color:var(--ink);}
.section-title em{font-style:italic;color:var(--goldd);}
.section-note{font-size:13px;color:var(--mu);margin-top:6px;line-height:1.6;}

/* Product strip horizontal scroll */
.prod-strip{display:flex;gap:14px;overflow-x:auto;padding-bottom:12px;scrollbar-width:none;cursor:grab;}
.prod-strip::-webkit-scrollbar{display:none;}
.prod-strip:active{cursor:grabbing;}
.ps-card{flex-shrink:0;width:180px;background:white;border:1px solid var(--border);border-radius:14px;overflow:hidden;transition:all .3s;box-shadow:0 2px 8px rgba(0,0,0,.04);}
.ps-card:hover{transform:translateY(-4px);box-shadow:0 12px 28px rgba(0,0,0,.1);border-color:var(--gold);}
.ps-card__img{height:140px;overflow:hidden;position:relative;}
.ps-card__img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s;}
.ps-card:hover .ps-card__img img{transform:scale(1.07);}
.ps-cat{position:absolute;top:8px;left:8px;border-radius:50px;padding:2px 8px;font-size:9px;font-weight:700;letter-spacing:.04em;}
.cat-v{background:rgba(22,163,74,.9);color:white;}
.cat-h{background:rgba(91,44,141,.9);color:white;}
.cat-sg{background:rgba(234,88,12,.9);color:white;}
.ps-card__body{padding:10px 12px 12px;}
.ps-card__name{font-size:13px;font-weight:600;line-height:1.2;color:var(--ink);margin-bottom:3px;}
.ps-card__sub{font-size:11px;color:var(--mu);}
.strip-hint{text-align:center;margin-top:8px;font-size:11px;color:var(--mu);letter-spacing:.08em;text-transform:uppercase;}

/* CTA COMMANDER */
.cta-section{max-width:960px;margin:40px auto 0;padding:0 32px;}
.cta-block{background:linear-gradient(135deg,#1a0a2e,#2d1054);border-radius:24px;padding:40px;display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;}
.cta-block h2{font-family:"Cormorant Garamond",serif;font-size:clamp(28px,4vw,40px);font-weight:300;color:white;margin-bottom:8px;}
.cta-block h2 em{font-style:italic;color:var(--gold);}
.cta-block p{font-size:14px;color:rgba(255,255,255,.5);line-height:1.65;max-width:380px;}
.cta-btns{display:flex;flex-direction:column;gap:10px;flex-shrink:0;}
.cta-wa{display:flex;align-items:center;gap:8px;background:var(--wa);color:white;padding:14px 24px;border-radius:12px;font-size:14px;font-weight:700;text-decoration:none;white-space:nowrap;transition:all .2s;box-shadow:0 4px 16px rgba(37,211,102,.3);}
.cta-wa:hover{background:#1da851;transform:translateY(-1px);}
.cta-wa svg{width:18px;height:18px;}
.cta-map{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:white;padding:12px 20px;border-radius:12px;font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap;transition:all .2s;}
.cta-map:hover{background:rgba(255,255,255,.12);}

/* FAQ */
.faq-section{max-width:960px;margin:40px auto 0;padding:0 32px;}
.faq-list{border-radius:16px;overflow:hidden;border:1px solid var(--border);}
.faq-item{background:white;}
.faq-q{width:100%;padding:18px 20px;text-align:left;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:14px;font-weight:600;color:var(--ink);background:none;border:none;border-bottom:1px solid var(--border);cursor:pointer;font-family:"DM Sans",sans-serif;transition:background .2s;}
.faq-item:last-child .faq-q{border-bottom:none;}
.faq-q:hover{background:var(--warm);}
.faq-q.open{color:var(--spice);}
.faq-arrow{transition:transform .25s;color:var(--mu);flex-shrink:0;}
.faq-q.open .faq-arrow{transform:rotate(180deg);}
.faq-a{display:none;padding:16px 20px;font-size:13px;color:var(--mu);line-height:1.7;border-bottom:1px solid var(--border);background:var(--cream);}
.faq-a.open{display:block;}
.faq-item:last-child .faq-a{border-bottom:none;}

/* FOOTER */
footer{background:var(--ink);margin-top:64px;padding:32px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;}
.f-logo{font-family:"Cormorant Garamond",serif;font-size:20px;color:white;}
.f-logo span{color:var(--gold);font-style:italic;}
.f-links{display:flex;gap:18px;flex-wrap:wrap;}
.f-links a{color:rgba(255,255,255,.35);font-size:12px;text-decoration:none;transition:color .2s;}
.f-links a:hover{color:rgba(255,255,255,.7);}

/* WA FAB */
.wa-fab{position:fixed;bottom:24px;right:24px;z-index:300;width:56px;height:56px;border-radius:50%;background:var(--wa);color:white;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(37,211,102,.45);text-decoration:none;transition:all .3s;animation:wabounce 4s 2s ease infinite;}
.wa-fab:hover{transform:scale(1.1);}
.wa-fab svg{width:26px;height:26px;}
@keyframes wabounce{0%,80%,100%{transform:scale(1)}90%{transform:scale(1.08)}}

/* REVEAL */
.reveal{opacity:0;transform:translateY(20px);transition:opacity .6s ease,transform .6s ease;}
.reveal.visible{opacity:1;transform:translateY(0);}
.reveal.d1{transition-delay:.1s;}.reveal.d2{transition-delay:.2s;}.reveal.d3{transition-delay:.3s;}

/* RESPONSIVE */
@media(max-width:768px){
  .nav{padding:0 16px;}.nav-links a{display:none;}
  .hero-content{padding:0 20px 56px;}
  .actions-section{grid-template-columns:1fr;padding:20px 16px 0;}
  .map-section{grid-template-columns:1fr;padding:0 16px;}
  .sidebar{order:-1;}
  .products-section,.cta-section,.faq-section{padding-left:16px;padding-right:16px;}
  .cta-block{grid-template-columns:1fr;}
  .cta-btns{flex-direction:row;flex-wrap:wrap;}
  .status-bar{gap:16px;padding:12px 16px;}
  footer{padding:20px 16px;flex-direction:column;text-align:center;}
}
</style>
</head>
