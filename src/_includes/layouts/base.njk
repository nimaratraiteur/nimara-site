<!DOCTYPE html>
<html lang="{{ lang or 'fr' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Nimara</title>
  <meta name="description" content="{{ description }}">

  {# Open Graph #}
  <meta property="og:title" content="{{ title }} — Nimara">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://nimara.io{{ page.url }}">
  <link rel="canonical" href="https://nimara.io{{ page.url }}">

  {# Fonts #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">

  {# Styles globaux #}
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="stylesheet" href="/assets/css/vanessa-widget.css">
</head>
<body>

  {# ============================ HEADER ============================ #}
  {% include "partials/header.njk" %}

  {# ============================ CONTENU ============================ #}
  <main id="main-content">
    {{ content | safe }}
  </main>

  {# ============================ FOOTER ============================ #}
  {% include "partials/footer.njk" %}

  {# ============================ WIDGET VANESSA ============================ #}
  {# Conteneur injecté dans le DOM — le JS gère l'ouverture/fermeture et les messages #}
  <div id="vanessa-root" aria-live="polite"></div>

  {# Scripts #}
  <script src="/assets/js/main.js" defer></script>
  <script src="/assets/js/vanessa-widget.js" defer></script>

</body>
</html>
