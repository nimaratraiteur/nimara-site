<!DOCTYPE html>
<html lang="{{ lang or 'fr' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} · {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/images/og-nimara.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="fr_CH">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/images/og-nimara.jpg">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <!-- Schema.org LocalBusiness (SEO local Genève) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["Patisserie", "CateringService", "FoodEstablishment", "LocalBusiness"],
    "name": "{{ site.name }}",
    "description": "{{ site.description }}",
    "image": "{{ site.url }}/assets/images/og-nimara.jpg",
    "url": "{{ site.url }}",
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "priceRange": "CHF 3 - CHF 50",
    "servesCuisine": ["Pâtisserie artisanale", "Cuisine indienne", "Service traiteur événementiel"],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address.street }}",
      "addressLocality": "{{ site.address.city }}",
      "postalCode": "{{ site.address.zip }}",
      "addressCountry": "CH"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 46.2061637,
      "longitude": 6.1324649
    },
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "07:00", "closes": "19:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "07:30", "closes": "18:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "08:00", "closes": "14:00" }
    ],
    "sameAs": [
      "{{ site.social.instagram }}",
      "{{ site.social.facebook }}"
    ],
    "acceptsReservations": "True",
    "areaServed": { "@type": "City", "name": "Genève" }
  }
  </script>
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <!-- Styles -->
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="stylesheet" href="/assets/css/vanessa-widget.css">
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-LKZFD20DEE"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-LKZFD20DEE');</script>
  <script defer src="/assets/js/ga-events.js"></script>
  {% if extraHead %}{{ extraHead | safe }}{% endif %}
</head>
<body class="{{ bodyClass or '' }}">

  {% include "partials/header.njk" %}

  {% if page.url != '/aeroport/' %}
  <a href="/aeroport/" class="airport-teaser-badge" aria-label="Bientôt à Genève Airport" style="position:fixed;top:76px;left:50%;transform:translateX(-50%);z-index:150;background:linear-gradient(135deg,rgba(245,158,11,.95),rgba(200,151,58,.95));color:#2a1a00;padding:8px 18px;border-radius:50px;font-size:12px;font-weight:700;letter-spacing:.05em;display:flex;align-items:center;gap:8px;box-shadow:0 6px 20px rgba(245,158,11,.3);text-decoration:none;border:1px solid rgba(255,255,255,.35);transition:all .25s">
    <span style="width:8px;height:8px;border-radius:50%;background:#2a1a00;animation:airportpulse 1.5s ease-in-out infinite"></span>
    🛫 Bientôt à Genève Airport
  </a>
  <style>
    @keyframes airportpulse{0%,100%{opacity:1}50%{opacity:.3}}
    .airport-teaser-badge:hover{transform:translateX(-50%) translateY(-2px) !important;box-shadow:0 10px 28px rgba(245,158,11,.5) !important}
    @media (max-width:640px){.airport-teaser-badge{top:70px !important;font-size:11px !important;padding:6px 14px !important;gap:6px !important}}
  </style>
  {% endif %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/whatsapp-cta.njk" %}
  {% include "partials/vanessa-widget.njk" %}

  <!-- Netlify Forms detection (cachés, permettent à Netlify de reconnaître les formulaires JS) -->
  <form name="nimara-exit-capture" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="email" name="email">
    <input type="text" name="page">
    <input type="text" name="bot-field">
  </form>
  <form name="nimara-calc-capture" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="email" name="email">
    <input type="text" name="event-type">
    <input type="text" name="guests">
    <input type="text" name="estimate">
    <input type="text" name="bot-field">
  </form>
  <form name="nimara-airport-signup" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="email" name="email">
    <input type="text" name="bot-field">
  </form>

  <script src="/assets/js/main.js"></script>
  <script src="/assets/js/vanessa-widget.js"></script>
  <script src="/assets/js/exit-popup.js" defer></script>
  <script src="/assets/js/social-proof.js" defer></script>
  {% if extraScripts %}{{ extraScripts | safe }}{% endif %}

</body>
</html>
