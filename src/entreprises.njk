.van-send{background:var(--v);border:none;color:white;width:36px;height:36px;border-radius:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0;}
.van-send:hover{background:var(--v2);}
.van-send svg{width:14px;height:14px;}
.van-foot{padding:6px 12px;text-align:center;font-size:10px;color:rgba(255,255,255,.2);border-top:1px solid rgba(255,255,255,.04);}
.typing{display:flex;align-items:center;gap:4px;padding:10px 14px;}
.typing span{width:6px;height:6px;border-radius:50%;background:rgba(167,139,250,.5);animation:typing .8s infinite;}
.typing span:nth-child(2){animation-delay:.15s;}
.typing span:nth-child(3){animation-delay:.3s;}
@keyframes typing{0%,80%,100%{transform:scale(1);opacity:.5}40%{transform:scale(1.2);opacity:1}}

/* ── WA FAB ── */
.wa-fab{position:fixed;bottom:28px;right:28px;z-index:290;width:54px;height:54px;border-radius:50%;background:var(--wa);color:white;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(37,211,102,.45);text-decoration:none;transition:all .3s;}
