<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --v:#5B2C8D;--v2:#7c3aed;--lav:#a78bfa;--lavl:#ede9fe;
  --gold:#f59e0b;--goldd:#d97706;
  --ink:#0f0a1a;--ink2:#1c1007;
  --cream:#fffbf0;--warm:#fef3c7;
  --mu:#78716c;--border:#e7e0d5;
  --wa:#25d366;
  --green:#16a34a;--red:#dc2626;
}
html{scroll-behavior:smooth;overflow-x:hidden;}
body{font-family:"DM Sans",sans-serif;background:var(--ink);color:white;overflow-x:hidden;}

/* ── NAV ── */
.nav{position:fixed;top:0;left:0;right:0;z-index:200;padding:0 40px;height:64px;display:flex;align-items:center;justify-content:space-between;background:rgba(15,10,26,.92);backdrop-filter:blur(20px);border-bottom:1px solid rgba(167,139,250,.12);}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;}
.logo-n{width:34px;height:34px;background:var(--v);border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:"Cormorant Garamond",serif;font-size:18px;color:white;font-weight:600;}
.logo-brand{font-size:17px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:white;}
.nav-r{display:flex;align-items:center;gap:8px;}
.nav-link{padding:7px 14px;border-radius:50px;font-size:13px;color:rgba(255,255,255,.55);text-decoration:none;transition:all .2s;}
.nav-link:hover{color:white;background:rgba(255,255,255,.08);}
.nav-wa{display:flex;align-items:center;gap:6px;background:var(--wa);color:white;padding:8px 18px;border-radius:50px;font-size:13px;font-weight:700;text-decoration:none;transition:all .2s;}
.nav-wa:hover{background:#1da851;}
.nav-wa svg{width:14px;height:14px;}

/* ── HERO ── */
.hero{padding:120px 40px 80px;position:relative;overflow:hidden;text-align:center;}
.hero::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 70% 60% at 50% 30%,rgba(91,44,141,.25),transparent 70%);pointer-events:none;}
.hero-inner{position:relative;z-index:1;max-width:800px;margin:0 auto;}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.3);border-radius:50px;padding:5px 16px;font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:20px;}
.hero-title{font-family:"Cormorant Garamond",serif;font-size:clamp(48px,7vw,84px);font-weight:300;line-height:.95;margin-bottom:20px;}
.hero-title em{font-style:italic;color:var(--gold);}
.hero-desc{font-size:17px;font-weight:300;color:rgba(255,255,255,.55);line-height:1.75;max-width:560px;margin:0 auto 40px;}
.hero-stats{display:flex;gap:40px;justify-content:center;flex-wrap:wrap;margin-bottom:40px;}
.stat{text-align:center;}
.stat-num{font-family:"Cormorant Garamond",serif;font-size:48px;font-weight:300;color:var(--lav);line-height:1;}
.stat-label{font-size:12px;color:rgba(255,255,255,.35);letter-spacing:.08em;text-transform:uppercase;margin-top:4px;}
.hero-ctas{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;}
.btn-primary{display:flex;align-items:center;gap:8px;background:var(--v);color:white;padding:14px 28px;border-radius:12px;font-size:15px;font-weight:700;text-decoration:none;transition:all .25s;box-shadow:0 4px 20px rgba(91,44,141,.4);}
.btn-primary:hover{background:var(--v2);transform:translateY(-2px);box-shadow:0 8px 28px rgba(91,44,141,.5);}
.btn-ghost{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:white;padding:14px 28px;border-radius:12px;font-size:15px;font-weight:600;text-decoration:none;transition:all .25s;}
.btn-ghost:hover{background:rgba(255,255,255,.1);}

/* ── FORMULES ── */
.formules{padding:80px 40px;max-width:1200px;margin:0 auto;}
.section-head{text-align:center;margin-bottom:48px;}
.section-kicker{font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--lav);margin-bottom:10px;display:block;}
.section-title{font-family:"Cormorant Garamond",serif;font-size:clamp(32px,5vw,52px);font-weight:300;line-height:1;}
.section-title em{font-style:italic;color:var(--gold);}
.section-desc{font-size:15px;color:rgba(255,255,255,.45);margin-top:12px;max-width:500px;margin-left:auto;margin-right:auto;line-height:1.7;}

/* Formula tabs */
.formula-tabs{display:flex;gap:0;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:4px;margin-bottom:40px;overflow-x:auto;scrollbar-width:none;}
.formula-tabs::-webkit-scrollbar{display:none;}
.f-tab{flex:1;padding:12px 16px;border-radius:12px;font-size:13px;font-weight:600;color:rgba(255,255,255,.4);cursor:pointer;transition:all .25s;border:none;background:none;font-family:"DM Sans",sans-serif;white-space:nowrap;display:flex;align-items:center;justify-content:center;gap:6px;}
.f-tab:hover{color:rgba(255,255,255,.7);}
.f-tab.active{background:var(--v);color:white;box-shadow:0 4px 12px rgba(91,44,141,.4);}

/* Formula panel */
.formula-panel{display:none;}
.formula-panel.active{display:block;}

.formula-layout{display:grid;grid-template-columns:1fr 1.4fr;gap:32px;align-items:start;}
.formula-info{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:32px;}
.formula-icon{font-size:48px;margin-bottom:16px;display:block;}
.formula-name{font-family:"Cormorant Garamond",serif;font-size:36px;font-weight:300;margin-bottom:8px;}
.formula-tagline{font-size:14px;color:rgba(255,255,255,.5);line-height:1.6;margin-bottom:24px;}
.price-block{background:rgba(167,139,250,.08);border:1px solid rgba(167,139,250,.2);border-radius:14px;padding:20px;margin-bottom:24px;}
.price-options{display:flex;flex-direction:column;gap:8px;}
.price-row{display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.06);font-size:14px;}
.price-row:last-child{border-bottom:none;}
.price-label{color:rgba(255,255,255,.6);}
.price-val{font-weight:700;color:var(--lav);font-family:"Cormorant Garamond",serif;font-size:22px;}
.price-unit{font-size:11px;color:rgba(255,255,255,.3);margin-left:2px;font-family:"DM Sans",sans-serif;}
.formula-includes{margin-bottom:24px;}
.includes-title{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.35);margin-bottom:12px;}
.include-item{display:flex;align-items:center;gap:8px;padding:6px 0;font-size:13px;color:rgba(255,255,255,.65);}
.include-icon{color:var(--gold);font-size:15px;width:20px;flex-shrink:0;}
.formula-cta{display:flex;flex-direction:column;gap:10px;}
.f-cta-wa{display:flex;align-items:center;justify-content:center;gap:8px;background:var(--wa);color:white;padding:13px;border-radius:12px;font-weight:700;font-size:14px;text-decoration:none;transition:all .2s;}
.f-cta-wa:hover{background:#1da851;}
.f-cta-wa svg{width:17px;height:17px;}
.f-cta-calc{display:flex;align-items:center;justify-content:center;gap:8px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:white;padding:13px;border-radius:12px;font-weight:600;font-size:14px;text-decoration:none;cursor:pointer;font-family:"DM Sans",sans-serif;transition:all .2s;}
.f-cta-calc:hover{background:rgba(255,255,255,.1);}

/* Product photos grid for formula */
.formula-products{}
.prod-grid-title{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-bottom:16px;}
.prod-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
.prod-card{border-radius:12px;overflow:hidden;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);transition:all .3s;cursor:default;}
.prod-card:hover{border-color:rgba(167,139,250,.3);transform:translateY(-2px);}
.prod-card__img{width:100%;aspect-ratio:1;overflow:hidden;position:relative;}
.prod-card__img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s;}
.prod-card:hover .prod-card__img img{transform:scale(1.06);}
.prod-card__info{padding:10px 12px;}
.prod-card__name{font-size:12px;font-weight:600;margin-bottom:4px;line-height:1.2;}
.prod-card__tags{display:flex;flex-wrap:wrap;gap:3px;}
.tag{display:inline-block;font-size:9px;font-weight:700;border-radius:50px;padding:2px 7px;}
.tag-vege{background:rgba(22,163,74,.15);color:#4ade80;}
.tag-halal{background:rgba(167,139,250,.15);color:var(--lav);}
.tag-gluten{background:rgba(249,115,22,.15);color:#fb923c;}
.tag-vegan{background:rgba(16,185,129,.15);color:#34d399;}
.tag-chaud{background:rgba(239,68,68,.12);color:#fca5a5;}

/* ── FILTRES PRODUITS ── */
.produits-section{padding:0 40px 80px;max-width:1200px;margin:0 auto;}
.filters-bar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:32px;align-items:center;}
.filter-label{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-right:4px;}
.filter-btn{display:flex;align-items:center;gap:5px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:50px;padding:7px 16px;font-size:12px;font-weight:600;color:rgba(255,255,255,.5);cursor:pointer;font-family:"DM Sans",sans-serif;transition:all .2s;}
.filter-btn:hover{border-color:rgba(167,139,250,.4);color:white;}
.filter-btn.active{background:rgba(167,139,250,.15);border-color:var(--lav);color:var(--lav);}
.filter-btn.active.g{background:rgba(22,163,74,.15);border-color:#4ade80;color:#4ade80;}
.filter-btn.active.h{background:rgba(167,139,250,.15);border-color:var(--lav);color:var(--lav);}
.filter-btn.active.sg{background:rgba(249,115,22,.15);border-color:#fb923c;color:#fb923c;}
.filter-btn.active.vg{background:rgba(16,185,129,.15);border-color:#34d399;color:#34d399;}
.filter-count{font-size:11px;background:rgba(255,255,255,.1);border-radius:50px;padding:1px 7px;margin-left:4px;}

/* Product grid (filtrable) */
.all-products{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;}
.ap-card{border-radius:14px;overflow:hidden;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);transition:all .3s;}
.ap-card:hover{border-color:rgba(167,139,250,.3);transform:translateY(-3px);box-shadow:0 12px 32px rgba(0,0,0,.3);}
.ap-card[data-hidden="true"]{display:none;}
.ap-card__img{width:100%;aspect-ratio:4/3;overflow:hidden;}
.ap-card__img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s;}
.ap-card:hover .ap-card__img img{transform:scale(1.06);}
.ap-card__body{padding:12px 14px;}
.ap-card__name{font-size:14px;font-weight:600;margin-bottom:6px;line-height:1.2;}
.ap-card__desc{font-size:11px;color:rgba(255,255,255,.4);line-height:1.5;margin-bottom:8px;}
.ap-card__tags{display:flex;flex-wrap:wrap;gap:4px;}
.no-results{grid-column:1/-1;text-align:center;padding:48px;color:rgba(255,255,255,.25);font-size:14px;display:none;}

/* ── CALCULATEUR ── */
.calc-section{background:linear-gradient(135deg,#1a0a2e,#2d1054);padding:80px 40px;position:relative;overflow:hidden;}
.calc-section::before{content:"";position:absolute;top:-200px;right:-200px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(167,139,250,.15),transparent 70%);pointer-events:none;}
.calc-inner{max-width:900px;margin:0 auto;position:relative;z-index:1;}
.calc-header{margin-bottom:40px;}
.calc-title{font-family:"Cormorant Garamond",serif;font-size:clamp(32px,5vw,52px);font-weight:300;margin-bottom:8px;}
.calc-title em{font-style:italic;color:var(--gold);}
.calc-subtitle{font-size:15px;color:rgba(255,255,255,.45);}

/* Steps */
.steps{display:flex;gap:0;background:rgba(255,255,255,.05);border-radius:12px;overflow:hidden;margin-bottom:36px;}
.step{flex:1;padding:12px 8px;text-align:center;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.3);border-bottom:2px solid transparent;transition:all .3s;cursor:default;}
.step.active{color:var(--lav);border-bottom-color:var(--lav);background:rgba(167,139,250,.08);}
.step.done{color:rgba(255,255,255,.5);}

.calc-panel{display:none;}
.calc-panel.active{display:block;}

/* Step 1 - Occasion */
.occ-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;}
@media(min-width:600px){.occ-grid{grid-template-columns:repeat(4,1fr);}}
.occ-card{background:rgba(255,255,255,.05);border:2px solid rgba(255,255,255,.08);border-radius:16px;padding:24px 16px;text-align:center;cursor:pointer;transition:all .25s;}
.occ-card:hover{background:rgba(167,139,250,.1);border-color:rgba(167,139,250,.35);}
.occ-card.sel{background:rgba(167,139,250,.15);border-color:var(--lav);}
.occ-card__icon{font-size:36px;margin-bottom:10px;display:block;}
.occ-card__name{font-size:14px;font-weight:600;color:white;margin-bottom:3px;}
.occ-card__hint{font-size:11px;color:rgba(255,255,255,.35);line-height:1.4;}

/* Step 2 - Personnes */
.pers-control{display:flex;align-items:center;gap:16px;margin-bottom:20px;}
.pers-btn{width:48px;height:48px;border-radius:50%;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:white;font-size:22px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;font-family:"DM Sans",sans-serif;}
.pers-btn:hover{background:rgba(167,139,250,.25);border-color:var(--lav);}
.pers-num{font-family:"Cormorant Garamond",serif;font-size:64px;font-weight:300;color:white;min-width:120px;text-align:center;line-height:1;}
.pers-unit{color:rgba(255,255,255,.35);font-size:14px;}
.pers-presets{display:flex;gap:8px;flex-wrap:wrap;}
.pp{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.45);padding:6px 16px;border-radius:50px;font-size:12px;font-weight:600;cursor:pointer;font-family:"DM Sans",sans-serif;transition:all .2s;}
.pp:hover{background:rgba(167,139,250,.2);color:var(--lav);border-color:var(--lav);}

/* Step 3 - Prefs */
.pref-group{margin-bottom:28px;}
.pref-label{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:10px;}
.pref-opts{display:flex;gap:8px;flex-wrap:wrap;}
.pref-opt{background:rgba(255,255,255,.05);border:2px solid rgba(255,255,255,.08);color:rgba(255,255,255,.55);padding:9px 18px;border-radius:10px;font-size:13px;font-weight:500;cursor:pointer;font-family:"DM Sans",sans-serif;transition:all .2s;}
.pref-opt:hover{border-color:rgba(167,139,250,.35);color:white;}
.pref-opt.sel{background:rgba(167,139,250,.15);border-color:var(--lav);color:white;}

/* Step 4 - Résultat */
.result-box{background:rgba(167,139,250,.1);border:1px solid rgba(167,139,250,.2);border-radius:16px;padding:24px;margin-bottom:28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;}
.result-formula{}
.result-formula-label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.4);margin-bottom:4px;}
.result-formula-val{font-family:"Cormorant Garamond",serif;font-size:32px;font-weight:300;color:white;}
.result-detail{font-size:13px;color:rgba(255,255,255,.4);margin-top:2px;}
.result-price{text-align:right;}
.result-price-label{font-size:11px;color:rgba(255,255,255,.35);text-transform:uppercase;letter-spacing:.08em;margin-bottom:4px;}
.result-price-val{font-family:"Cormorant Garamond",serif;font-size:52px;font-weight:300;color:var(--lav);line-height:1;}
.result-price-unit{font-size:11px;color:rgba(255,255,255,.3);}

.result-products-title{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.3);margin-bottom:14px;}
.result-products{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin-bottom:28px;}
.rp-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.07);border-radius:12px;overflow:hidden;}
.rp-card img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;}
.rp-info{padding:10px 12px;}
.rp-name{font-size:12px;font-weight:600;margin-bottom:2px;}
.rp-qty{font-size:11px;color:rgba(255,255,255,.35);}

.result-ctas{display:flex;gap:10px;flex-wrap:wrap;}
.r-wa{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;background:var(--wa);color:white;padding:15px;border-radius:12px;font-size:14px;font-weight:700;text-decoration:none;min-width:220px;box-shadow:0 4px 16px rgba(37,211,102,.3);transition:all .2s;}
.r-wa:hover{background:#1da851;transform:translateY(-1px);}
.r-wa svg{width:18px;height:18px;}
.r-again{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.55);padding:15px 24px;border-radius:12px;font-size:13px;font-weight:600;cursor:pointer;font-family:"DM Sans",sans-serif;transition:all .2s;}
.r-again:hover{background:rgba(255,255,255,.08);color:white;}

/* Step nav */
.step-nav{display:flex;justify-content:space-between;margin-top:28px;align-items:center;}
.btn-back{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.5);padding:10px 20px;border-radius:10px;font-size:13px;cursor:pointer;font-family:"DM Sans",sans-serif;transition:all .2s;}
.btn-back:hover{background:rgba(255,255,255,.08);color:white;}
