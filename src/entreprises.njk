<script>
// ══ FORMULES ══
function showFormula(id, btn) {
  document.querySelectorAll('.formula-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.f-tab').forEach(b => b.classList.remove('active'));
  document.getElementById('fp-' + id).classList.add('active');
  btn.classList.add('active');
}

// ══ FILTRES ══
function applyFilter(filter, btn) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  let count = 0;
  document.querySelectorAll('.ap-card[data-tags]').forEach(card => {
    const tags = card.dataset.tags || '';
    const show = filter === 'all' || tags.includes(filter);
    card.dataset.hidden = show ? 'false' : 'true';
    if (show) count++;
  });
  document.getElementById('count-all').textContent = count;
}

// ══ CALCULATEUR ══
let state = { occ: null, pers: 50, comp: 'mix', diet: 'none', drinks: 'non', step: 1 };

const OCCS = {
  apero: { name: 'Apéro Dinatoire', hint: '3–4 pcs salées + 2–3 sucrées / pers', prices: { mix:28,sale:22,sucre:16,drinks:7 } },
  lunch: { name: 'Lunch Box', hint: 'Box individuelle livrée · Riz + plat + accompagnement', prices: { mix:24,sale:18,sucre:12,drinks:5 } },
  buffet: { name: 'Buffet Complet', hint: 'Service traiteur avec installation et chafing dish', prices: { mix:42,sale:32,sucre:22,drinks:10 } },
  coffee: { name: 'Coffee Break', hint: 'Pause sucrée & légèrement salée', prices: { mix:18,sale:12,sucre:14,drinks:4 } },
};

function goStep(n) {
  state.step = n;
  for(let i=1;i<=4;i++) {
    document.getElementById('cp-'+i)?.classList.toggle('active', i===n);
    const si = document.getElementById('si-'+i);
    if(si) { si.classList.toggle('active',i===n); si.classList.toggle('done',i<n); }
  }
}
function selectOcc(el) {
  document.querySelectorAll('.occ-card').forEach(c=>c.classList.remove('sel'));
  el.classList.add('sel');
  state.occ = el.dataset.occ;
  document.getElementById('btn-next1').disabled = false;
}
function adj(d) { state.pers = Math.max(10,Math.min(999,state.pers+d)); document.getElementById('persNum').textContent = state.pers; }
function setP(n) { state.pers=n; document.getElementById('persNum').textContent=n; }
function selComp(el) { document.querySelectorAll('[data-comp]').forEach(b=>b.classList.remove('sel')); el.classList.add('sel'); state.comp=el.dataset.comp; }
function selDiet(el) { document.querySelectorAll('[data-diet]').forEach(b=>b.classList.remove('sel')); el.classList.add('sel'); state.diet=el.dataset.diet; }
function selDrinks(el) { document.querySelectorAll('[data-drinks]').forEach(b=>b.classList.remove('sel')); el.classList.add('sel'); state.drinks=el.dataset.drinks; }

function fmtChf(n) { return 'CHF ' + n.toLocaleString('fr-CH',{minimumFractionDigits:2}).replace(',', "'"); }

function computeResult() {
  const occ = OCCS[state.occ];
  const base = occ.prices[state.comp] + (state.drinks==='oui' ? occ.prices.drinks : 0);
  const total = base * state.pers;
  document.getElementById('res-formula').textContent = occ.name;
  const dietLabel = {none:'',halal:' · ☪️ Halal',vege:' · 🌿 Végétarien',vegan:' · 🌱 Vegan',sansgluten:' · 🫙 Sans Gluten'}[state.diet] || '';
  document.getElementById('res-detail').textContent = occ.hint + dietLabel + (state.drinks==='oui' ? ' + Boissons' : '');
  document.getElementById('res-total').textContent = fmtChf(total);
  
  // Produits filtrés selon le régime
  const allCards = document.querySelectorAll('.ap-card[data-tags]');
  let filteredProds = [];
  allCards.forEach(c => {
    const tags = c.dataset.tags || '';
    if (state.diet === 'none' || tags.includes(state.diet)) {
      const name = c.querySelector('.ap-card__name')?.textContent;
      const img = c.querySelector('img')?.src;
      if (name && img) filteredProds.push({name, img});
    }
  });
  // Filter by comp
  const isVege = state.diet === 'vege' || state.diet === 'vegan';
  if (state.comp === 'sucre') filteredProds = filteredProds.filter(p => ['Cinnamon Roll','Brownie','Brookie','Cheesecake','Pecan Pie','Banana Bread','Carrot Cake'].includes(p.name));
  if (state.comp === 'sale') filteredProds = filteredProds.filter(p => !['Cinnamon Roll','Brownie','Brookie','Cheesecake','Pecan Pie','Banana Bread','Carrot Cake'].includes(p.name));
  
  const shown = filteredProds.slice(0, 6);
  document.getElementById('res-products').innerHTML = shown.map(p => `
    <div class="rp-card">
      <img src="${p.img}" alt="${p.name}" style="width:100%;aspect-ratio:4/3;object-fit:cover;display:block">
      <div class="rp-info"><div class="rp-name">${p.name}</div><div class="rp-qty">Inclus dans la formule</div></div>
    </div>
  `).join('');
  
  const dietTxt = {none:'',halal:' · Halal',vege:' · Végétarien',vegan:' · Vegan',sansgluten:' · Sans Gluten'}[state.diet] || '';
  const drinksTxt = state.drinks==='oui' ? ' + Boissons (Lassi Mangue, Hibiscus)' : '';
  const compTxt = {mix:'Salé + Sucré',sale:'Salé uniquement',sucre:'Sucré uniquement'}[state.comp];
  const msg = `Bonjour Nimara 🙏\n\nJe souhaite organiser :\n- Formule : ${occ.name}\n- Personnes : ${state.pers}\n- Composition : ${compTxt}${dietTxt}${drinksTxt}\n- Budget estimé : ${fmtChf(total)}\n\nPouvez-vous me proposer un devis ?`;
  document.getElementById('res-wa').href = 'https://wa.me/41225576020?text=' + encodeURIComponent(msg);
  goStep(4);
}

// ══ REVEAL ══
const obs = new IntersectionObserver(e => e.forEach(x => { if(x.isIntersecting) x.target.classList.add('visible'); }), {threshold:.12});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// ══ VANESSA ══
let vanOpen = false;
let vanInitialized = false;
const WA_SVG = '<svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>';

function toggleVan() {
  vanOpen = !vanOpen;
  const panel = document.getElementById('vanPanel');
  panel.style.display = vanOpen ? 'flex' : 'none';
  if (vanOpen && !vanInitialized) initVan();
}

function addMsg(text, isVan) {
  const msgs = document.getElementById('vanMsgs');
  const div = document.createElement('div');
  div.className = 'msg ' + (isVan ? 'msg-van' : 'msg-user');
  div.innerHTML = `<div class="msg-bubble">${text}</div>`;
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
}

function showTyping() {
  const msgs = document.getElementById('vanMsgs');
  const div = document.createElement('div');
  div.className = 'msg msg-van';
  div.id = 'typing-indicator';
  div.innerHTML = '<div class="msg-bubble typing"><span></span><span></span><span></span></div>';
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
}

function removeTyping() {
  document.getElementById('typing-indicator')?.remove();
}

function setQuickReplies(options) {
  const qr = document.getElementById('vanQuick');
  qr.innerHTML = options.map(o => `<button class="van-qbtn" onclick="handleQuick('${o.val}')">${o.label}</button>`).join('');
}

let vanContext = 'start';
function initVan() {
  vanInitialized = true;
  showTyping();
  setTimeout(() => {
    removeTyping();
    addMsg("Bonjour ! Je suis Vanessa 👋", true);
    setTimeout(() => {
      addMsg("Vous êtes ici pour organiser un événement pour votre entreprise ?", true);
      setQuickReplies([
        {label:"🎉 Oui, un événement d'entreprise", val:"event"},
        {label:"🍽️ Commande régulière d'équipe", val:"regular"},
        {label:"❓ J'ai une question", val:"question"},
      ]);
      vanContext = 'type';
    }, 600);
  }, 1200);
}

function handleQuick(val) {
  document.getElementById('vanQuick').innerHTML = '';
  if (val === 'event') {
    addMsg("🎉 Oui, un événement d'entreprise", false);
    showTyping();
    setTimeout(() => {
      removeTyping();
      addMsg("Super ! Quel type d'événement planifiez-vous ?", true);
      setQuickReplies([
        {label:"🥂 Apéro dinatoire", val:"apero"},
        {label:"🥗 Lunch boxes d'équipe", val:"lunch"},
        {label:"🍱 Buffet complet", val:"buffet"},
        {label:"☕ Coffee break", val:"coffee"},
      ]);
      vanContext = 'formula';
    }, 1000);
  } else if (val === 'regular') {
    addMsg("🍽️ Commande régulière d'équipe", false);
    showTyping();
    setTimeout(() => {
      removeTyping();
      addMsg("Excellente idée ! Pour des commandes régulières, la meilleure option est nos Lunch Boxes livrées Lun/Mer/Sam. Combien de personnes dans votre équipe ?", true);
      setQuickReplies([
        {label:"5–15 personnes", val:"small"},
        {label:"15–50 personnes", val:"medium"},
        {label:"50+ personnes", val:"large"},
      ]);
      vanContext = 'teamsize';
    }, 1000);
  } else if (val === 'question') {
    addMsg("❓ J'ai une question", false);
    showTyping();
    setTimeout(() => {
      removeTyping();
      addMsg("Bien sûr ! Posez-moi votre question directement. Je peux vous aider sur les menus, prix, livraisons, options sans gluten/halal/végé... 🙏", true);
      setQuickReplies([]);
      vanContext = 'freeform';
    }, 800);
  } else if (['apero','lunch','buffet','coffee'].includes(val)) {
    const names = {apero:'Apéro Dinatoire 🥂', lunch:'Lunch Box 🥗', buffet:'Buffet Complet 🍱', coffee:'Coffee Break ☕'};
    addMsg(names[val], false);
    showTyping();
    setTimeout(() => {
      removeTyping();
      addMsg(`Parfait, j'ai pré-sélectionné la formule ${names[val]} ! Avez-vous des contraintes alimentaires ?`, true);
      setQuickReplies([
        {label:"☪️ Halal", val:"need_halal"},
        {label:"🌿 Végétarien/Vegan", val:"need_vege"},
        {label:"🫙 Sans Gluten", val:"need_sg"},
        {label:"✅ Aucune contrainte", val:"no_constraint"},
      ]);
      vanContext = 'diet_' + val;
    }, 900);
  } else if (val.startsWith('need_') || val === 'no_constraint') {
    const dietLabel = {need_halal:'☪️ Halal', need_vege:'🌿 Végétarien/Vegan', need_sg:'🫙 Sans Gluten', no_constraint:'✅ Aucune contrainte'}[val];
    addMsg(dietLabel, false);
    showTyping();
    setTimeout(() => {
      removeTyping();
      if (val !== 'no_constraint') {
        addMsg(`Pas de souci ! Nous avons de nombreux produits ${dietLabel}. Je vous montre la sélection ↓`, true);
        const filterMap = {need_halal:'halal', need_vege:'vege', need_sg:'sansgluten'};
        const f = filterMap[val];
        const btn = document.querySelector(`[onclick="applyFilter('${f}',this)"]`);
        if (btn) { applyFilter(f, btn); document.getElementById('productsGrid').scrollIntoView({behavior:'smooth',block:'center'}); }
      } else {
        addMsg("Parfait ! Utilisez le calculateur juste en dessous pour obtenir votre devis personnalisé 👇", true);
        document.getElementById('calculateur').scrollIntoView({behavior:'smooth'});
      }
      setTimeout(() => {
        addMsg("Une fois prêt, je peux vous envoyer directement vers WhatsApp pour finaliser. 💬", true);
        setQuickReplies([
          {label:"💬 Contacter l'équipe sur WhatsApp", val:"go_wa"},
          {label:"🧮 Utiliser le calculateur", val:"go_calc"},
        ]);
      }, 600);
    }, 900);
  } else if (val === 'go_wa') {
    addMsg("💬 Contacter l'équipe sur WhatsApp", false);
    setTimeout(() => {
      window.open('https://wa.me/41225576020?text=Bonjour%20Nimara%2C%20Vanessa%20m%27a%20orient%C3%A9%20vers%20vous%20%F0%9F%99%8F', '_blank');
      addMsg("Je vous ouvre WhatsApp ! L'équipe vous répond rapidement 🚀", true);
      setQuickReplies([]);
    }, 300);
  } else if (val === 'go_calc') {
    addMsg("🧮 Utiliser le calculateur", false);
    document.getElementById('calculateur').scrollIntoView({behavior:'smooth'});
    addMsg("Je vous amène au calculateur 👆 Remplissez les 4 étapes pour obtenir votre devis !", true);
    setQuickReplies([]);
    toggleVan();
  } else if (['small','medium','large'].includes(val)) {
    const labels = {small:'5–15 personnes', medium:'15–50 personnes', large:'50+ personnes'};
    addMsg(labels[val], false);
    showTyping();
    setTimeout(() => {
      removeTyping();
      addMsg(`Super ! Pour ${labels[val]}, je vous recommande de passer votre première commande via WhatsApp. L'équipe vous configure un suivi régulier avec les tarifs entreprise. 🎯`, true);
      setQuickReplies([
        {label:WA_SVG + " Démarrer sur WhatsApp", val:"go_wa"},
      ]);
    }, 900);
  }
}

function sendMsg(e) {
  e.preventDefault();
  const input = document.getElementById('vanInput');
  const text = input.value.trim();
  if (!text) return;
  input.value = '';
  addMsg(text, false);
  document.getElementById('vanQuick').innerHTML = '';
  showTyping();
  
  // Simple keyword routing
  setTimeout(() => {
    removeTyping();
    const lc = text.toLowerCase();
    if (lc.includes('gluten') || lc.includes('sans gluten')) {
      addMsg("Oui, nous avons des produits sans gluten ! Notre Brownie (farine de riz) est 100% sans gluten. Je filtre les produits pour vous 👇", true);
      const btn = document.querySelector(`[onclick="applyFilter('sansgluten',this)"]`);
      if (btn) { applyFilter('sansgluten', btn); document.getElementById('productsGrid').scrollIntoView({behavior:'smooth',block:'center'}); }
    } else if (lc.includes('halal')) {
      addMsg("Oui, tous nos plats salés sont Halal certifiés ! Je filtre pour vous 👇", true);
      const btn = document.querySelector(`[onclick="applyFilter('halal',this)"]`);
      if (btn) { applyFilter('halal', btn); document.getElementById('productsGrid').scrollIntoView({behavior:'smooth',block:'center'}); }
    } else if (lc.includes('végé') || lc.includes('vegetar') || lc.includes('vegan')) {
      addMsg("Nous avons une belle sélection végétarienne et vegan ! Je filtre pour vous 👇", true);
      const btn = document.querySelector(`[onclick="applyFilter('vege',this)"]`);
      if (btn) { applyFilter('vege', btn); document.getElementById('productsGrid').scrollIntoView({behavior:'smooth',block:'center'}); }
    } else if (lc.includes('prix') || lc.includes('combien') || lc.includes('coût') || lc.includes('devis')) {
      addMsg("Les prix démarrent à CHF 12/personne pour un coffee break, jusqu'à CHF 42/personne pour un buffet complet. Utilisez notre calculateur pour un devis exact ! 🧮", true);
      setQuickReplies([{label:"🧮 Calculer mon devis", val:"go_calc"}]);
    } else if (lc.includes('livra') || lc.includes('quand') || lc.includes('horaire')) {
      addMsg("Nous livrons Lundi, Mercredi et Samedi avant 8h. Pour les événements, nous nous adaptons à votre planning. 📦", true);
      setQuickReplies([{label:"💬 Planifier sur WhatsApp", val:"go_wa"}]);
    } else {
      addMsg("Excellente question ! Pour cette demande spécifique, je vous recommande de parler directement avec l'équipe Nimara 🙏", true);
      setQuickReplies([{label:"💬 Parler à l'équipe", val:"go_wa"}]);
    }
  }, 1100);
}

// Auto-open Vanessa après 12 secondes
setTimeout(() => {
  if (!vanOpen) toggleVan();
}, 12000);
</script>
</body>
</html>
