<title>Nimara — Repas d'entreprise · Genève</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600;1,700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--v:#5B2C8D;--lav:#a78bfa;--gold:#c8973a;--gold2:#f0c46a;--dark:#07040f;--dark2:#110c1e;--dark3:#1a1330;}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:"DM Sans",sans-serif;background:var(--dark);color:#fff;overflow-x:hidden;}

nav{position:fixed;top:0;left:0;right:0;z-index:300;padding:14px 40px;display:flex;align-items:center;justify-content:space-between;background:rgba(7,4,15,.96);backdrop-filter:blur(20px);border-bottom:1px solid rgba(167,139,250,.1);}
.logo{font-family:"Cormorant Garamond",serif;font-size:22px;font-weight:700;color:#fff;letter-spacing:4px;text-decoration:none;}
.logo em{color:var(--gold);font-style:normal;}
.nav-wa{display:flex;align-items:center;gap:8px;background:#25d366;color:#fff;font-weight:700;font-size:13px;padding:9px 22px;border-radius:50px;text-decoration:none;transition:.2s;}
.nav-wa:hover{background:#20b858;}

.hero{position:relative;height:100vh;min-height:600px;overflow:hidden;}
.slides{position:absolute;inset:0;}
.slide{position:absolute;inset:0;opacity:0;transition:opacity 1.3s ease;}
.slide.active{opacity:1;}
.slide img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;}
.slide-caption{position:absolute;bottom:88px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.55);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.75);font-size:11px;letter-spacing:2px;padding:5px 18px;border-radius:50px;white-space:nowrap;opacity:0;transition:opacity .5s .5s;}
.slide.active .slide-caption{opacity:1;}
.hero-mask{position:absolute;inset:0;background:linear-gradient(160deg,rgba(7,4,15,.82) 0%,rgba(7,4,15,.42) 45%,rgba(7,4,15,.12) 70%,rgba(7,4,15,.6) 100%);}
.hero-content{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:80px 60px 60px;max-width:680px;}
.tag{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(200,151,58,.4);background:rgba(200,151,58,.08);color:var(--gold2);font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;padding:6px 16px;border-radius:50px;width:fit-content;margin-bottom:24px;}
.hero h1{font-family:"Cormorant Garamond",serif;font-size:clamp(3.2rem,6vw,5.4rem);font-weight:700;line-height:1.02;color:#fff;margin-bottom:18px;text-shadow:0 2px 20px rgba(0,0,0,.5);}
.hero h1 em{color:var(--gold2);font-style:italic;}
.hero-sub{font-size:16px;color:rgba(255,255,255,.55);line-height:1.75;max-width:460px;margin-bottom:36px;font-weight:300;}
.pills{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:36px;}
.pill{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.75);font-size:12px;padding:7px 16px;border-radius:50px;}
.pill b{color:#fff;}
.btn-wa{display:inline-flex;align-items:center;gap:10px;background:#25d366;color:#fff;font-weight:700;font-size:15px;padding:16px 34px;border-radius:50px;text-decoration:none;width:fit-content;box-shadow:0 8px 30px rgba(37,211,102,.35);transition:.25s;}
.btn-wa:hover{transform:translateY(-2px);box-shadow:0 14px 40px rgba(37,211,102,.5);}
.dots{position:absolute;bottom:24px;left:60px;display:flex;gap:5px;align-items:center;flex-wrap:wrap;max-width:280px;}
.dot{width:5px;height:5px;border-radius:3px;background:rgba(255,255,255,.22);cursor:pointer;transition:.35s;flex-shrink:0;}
.dot.active{background:var(--gold);width:18px;}

.sec{padding:90px 40px;background:var(--dark2);}
.sec-inner{max-width:1100px;margin:0 auto;}
.eye{font-size:10px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--lav);margin-bottom:12px;}
.stitle{font-family:"Cormorant Garamond",serif;font-size:clamp(2rem,4vw,3rem);font-weight:700;color:#fff;line-height:1.1;margin-bottom:12px;}
.stitle em{font-style:italic;color:var(--gold2);}
.sdesc{font-size:15px;color:rgba(255,255,255,.38);line-height:1.7;margin-bottom:52px;max-width:540px;}

/* GALERIE PRODUITS — 5 photos */
.galerie{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:64px;}
.gal-item{position:relative;border-radius:12px;overflow:hidden;cursor:pointer;}
.gal-item img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;transition:.5s;filter:brightness(.8);}
.gal-item:hover img{transform:scale(1.07);filter:brightness(1);}
.gal-label{position:absolute;bottom:0;left:0;right:0;padding:20px 12px 12px;background:linear-gradient(transparent,rgba(7,4,15,.9));font-size:12px;font-weight:600;color:rgba(255,255,255,.85);}
.gal-label small{display:block;font-size:10px;font-weight:300;color:rgba(255,255,255,.4);margin-top:2px;}

/* DESSERTS VEDETTES */
.desserts{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:52px;}
.dessert-card{position:relative;border-radius:18px;overflow:hidden;border:1px solid rgba(200,151,58,.2);transition:.3s;}
.dessert-card:hover{border-color:rgba(200,151,58,.5);transform:translateY(-3px);}
.dessert-card img{width:100%;aspect-ratio:16/9;object-fit:cover;object-position:center;filter:brightness(.85);transition:.4s;}
.dessert-card:hover img{filter:brightness(1);}
.dessert-info{position:absolute;bottom:0;left:0;right:0;padding:28px 22px 20px;background:linear-gradient(transparent,rgba(7,4,15,.92));display:flex;justify-content:space-between;align-items:flex-end;}
.dessert-name{font-family:"Cormorant Garamond",serif;font-size:1.4rem;font-weight:700;color:#fff;}
.dessert-name small{display:block;font-size:12px;font-weight:300;color:rgba(255,255,255,.45);margin-top:2px;font-family:"DM Sans",sans-serif;}
.dessert-prix{font-family:"Cormorant Garamond",serif;font-size:1.6rem;font-weight:700;color:var(--gold2);background:rgba(200,151,58,.12);border:1px solid rgba(200,151,58,.25);padding:4px 14px;border-radius:50px;white-space:nowrap;}

/* FORMULES */
.formules{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:52px;}
.f{background:rgba(255,255,255,.03);border:1px solid rgba(167,139,250,.12);border-radius:18px;padding:30px 26px;position:relative;transition:.3s;}
.f:hover{border-color:rgba(200,151,58,.35);transform:translateY(-3px);}
.f.star{border-color:rgba(200,151,58,.5);background:rgba(200,151,58,.05);}
.f.star::before{content:"★  POPULAIRE";position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--gold);color:#07040f;font-size:9px;font-weight:700;letter-spacing:2px;padding:4px 14px;border-radius:50px;white-space:nowrap;}
.f-lbl{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,.3);margin-bottom:8px;}
.f-prix{font-family:"Cormorant Garamond",serif;font-size:2.8rem;font-weight:700;color:#fff;margin-bottom:2px;}
.f-prix span{font-size:.95rem;font-weight:300;color:rgba(255,255,255,.35);}
.f-desc{font-size:13px;color:rgba(255,255,255,.35);margin-bottom:20px;line-height:1.5;}
.f-list{list-style:none;}
.f-list li{font-size:13.5px;color:rgba(255,255,255,.68);padding:6px 0;border-bottom:1px solid rgba(255,255,255,.05);display:flex;gap:9px;align-items:flex-start;line-height:1.5;}
.f-list li:last-child{border:none;padding-bottom:0;}
.ck{color:var(--gold);flex-shrink:0;margin-top:1px;}

/* NAANS avec photos */
.naans-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:52px;}
.naan-card{position:relative;border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.08);transition:.3s;}
.naan-card:hover{border-color:rgba(200,151,58,.4);transform:translateY(-3px);}
.naan-card img{width:100%;aspect-ratio:4/3;object-fit:cover;filter:brightness(.8);transition:.4s;}
.naan-card:hover img{filter:brightness(1);}
.naan-info{position:absolute;bottom:0;left:0;right:0;padding:24px 18px 18px;background:linear-gradient(transparent,rgba(7,4,15,.92));display:flex;justify-content:space-between;align-items:flex-end;}
.naan-name{font-size:15px;font-weight:700;color:#fff;}
.naan-name small{display:block;font-size:11px;font-weight:300;color:rgba(255,255,255,.45);margin-top:2px;}
.naan-prix{font-family:"Cormorant Garamond",serif;font-size:1.5rem;font-weight:700;color:var(--gold2);background:rgba(200,151,58,.12);border:1px solid rgba(200,151,58,.25);padding:4px 12px;border-radius:50px;white-space:nowrap;}

.xtitle{font-family:"Cormorant Garamond",serif;font-size:1.6rem;font-weight:700;color:#fff;margin-bottom:6px;}
.xsub{font-size:13px;color:rgba(255,255,255,.3);margin-bottom:28px;}
.xgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
.xcat{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:20px 18px;}
.xcat-title{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--lav);margin-bottom:14px;}
.xi{display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:13px;}
.xi:last-child{border:none;}
.xi-n{color:rgba(255,255,255,.65);}
.xi-p{color:var(--gold2);font-weight:700;font-size:11px;background:rgba(200,151,58,.1);padding:2px 9px;border-radius:50px;white-space:nowrap;margin-left:8px;flex-shrink:0;}

.zf{background:linear-gradient(135deg,#3a1a60 0%,var(--v) 100%);padding:80px 40px;}
.zf-inner{max-width:960px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;}
.zf h2{font-family:"Cormorant Garamond",serif;font-size:2.4rem;font-weight:700;color:#fff;margin-bottom:14px;}
.zf h2 em{font-style:italic;color:var(--gold2);}
.zf p{font-size:15px;color:rgba(255,255,255,.55);line-height:1.8;}
.zf-list{list-style:none;}
.zf-list li{display:flex;gap:14px;align-items:flex-start;font-size:14px;color:rgba(255,255,255,.72);padding:12px 0;border-bottom:1px solid rgba(255,255,255,.08);line-height:1.5;}
.zf-list li:last-child{border:none;}

.cta{padding:100px 40px;text-align:center;background:var(--dark3);}
.cta h2{font-family:"Cormorant Garamond",serif;font-size:clamp(2.4rem,4.5vw,3.6rem);font-weight:700;color:#fff;margin-bottom:16px;}
.cta h2 em{font-style:italic;color:var(--gold2);}
.cta p{font-size:16px;color:rgba(255,255,255,.4);margin-bottom:40px;line-height:1.7;}
.btn-wa-lg{display:inline-flex;align-items:center;gap:12px;background:#25d366;color:#fff;font-weight:700;font-size:16px;padding:18px 44px;border-radius:50px;text-decoration:none;box-shadow:0 10px 40px rgba(37,211,102,.4);transition:.25s;}
.btn-wa-lg:hover{transform:translateY(-3px);box-shadow:0 16px 48px rgba(37,211,102,.55);}

footer{background:#050309;padding:28px 40px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;border-top:1px solid rgba(255,255,255,.04);}
.fl{font-family:"Cormorant Garamond",serif;font-size:16px;font-weight:700;color:#fff;letter-spacing:3px;}
.fl em{color:var(--gold);font-style:normal;}
.fi{font-size:12px;color:rgba(255,255,255,.22);line-height:1.8;}
.fi a{color:rgba(255,255,255,.3);text-decoration:none;}

@media(max-width:900px){
  nav{padding:12px 20px;}
  .hero-content{padding:80px 24px 50px;}
  .dots{left:24px;bottom:16px;}
  .sec{padding:60px 20px;}
  .galerie{grid-template-columns:repeat(3,1fr);}
  .desserts{grid-template-columns:1fr;}
  .formules{grid-template-columns:1fr;}
  .naans-grid{grid-template-columns:1fr;}
  .xgrid{grid-template-columns:1fr 1fr;}
  .zf{padding:60px 20px;}
  .zf-inner{grid-template-columns:1fr;gap:32px;}
  .cta{padding:60px 20px;}
  footer{padding:20px;}
}
@media(max-width:500px){
  .galerie{grid-template-columns:1fr 1fr;}
  .xgrid{grid-template-columns:1fr;}
}
</style>
</head>
