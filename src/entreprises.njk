/* ── VANESSA ── */
.van-trigger{position:fixed;bottom:100px;right:28px;z-index:300;width:60px;height:60px;border-radius:50%;background:var(--v);color:white;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(91,44,141,.5);transition:all .3s;animation:vpulse 3s 3s ease infinite;}
.van-trigger:hover{transform:scale(1.08);box-shadow:0 8px 28px rgba(91,44,141,.6);}
.van-trigger img{width:36px;height:36px;border-radius:50%;object-fit:cover;}
.van-trigger span{font-size:22px;}
@keyframes vpulse{0%,80%,100%{transform:scale(1)}90%{transform:scale(1.07)}}
.van-label{position:absolute;right:70px;top:50%;transform:translateY(-50%);background:white;color:var(--ink2);padding:6px 14px;border-radius:50px;font-size:12px;font-weight:600;white-space:nowrap;box-shadow:0 2px 12px rgba(0,0,0,.2);opacity:0;transition:opacity .3s;pointer-events:none;}
.van-trigger:hover .van-label{opacity:1;}

