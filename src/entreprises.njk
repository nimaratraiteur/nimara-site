.msg-user{align-self:flex-end;}
.msg-bubble{padding:10px 14px;border-radius:14px;font-size:13px;line-height:1.55;}
.msg-van .msg-bubble{background:rgba(167,139,250,.15);border:1px solid rgba(167,139,250,.2);color:white;border-radius:4px 14px 14px 14px;}
.msg-user .msg-bubble{background:var(--v);color:white;border-radius:14px 14px 4px 14px;}
.van-quick{padding:8px 12px;display:flex;flex-wrap:wrap;gap:6px;border-top:1px solid rgba(255,255,255,.06);}
.van-qbtn{background:rgba(167,139,250,.1);border:1px solid rgba(167,139,250,.2);color:var(--lav);padding:6px 12px;border-radius:50px;font-size:12px;font-weight:600;cursor:pointer;font-family:"DM Sans",sans-serif;transition:all .2s;}
.van-qbtn:hover{background:rgba(167,139,250,.2);}
