/* ── FOOTER ── */
footer{background:rgba(0,0,0,.4);padding:36px 40px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;border-top:1px solid rgba(255,255,255,.05);}
