      <div class="kpi-icon">👆</div>
      <div class="kpi-label">Boutons cliqués</div>
      <div class="kpi-value" id="kpi-clicks">—</div>
      <div class="kpi-delta up" id="kpi-click-d">↑ chargement…</div>
    </div>
    <div class="kpi red">
      <div class="kpi-icon">📱</div>
      <div class="kpi-label">Msg / Session</div>
      <div class="kpi-value" id="kpi-mobile">—</div>
      <div class="kpi-delta" id="kpi-mob-d" style="color:var(--text3)">chargement…</div>
    </div>
  </div>

  <!-- ROW 1: Buttons + Topics -->
  <div class="grid-2">

    <div class="card">
      <div class="card-head">
        <span class="card-title">🔘 Boutons les plus cliqués</span>
        <span class="card-badge" id="total-clicks-badge">— clics</span>
      </div>
      <div class="card-body" id="btn-chart"></div>
    </div>

    <div class="card">
      <div class="card-head">
        <span class="card-title">💡 Ce que les clients veulent</span>
        <span class="card-badge">Topics détectés</span>
      </div>
      <div class="card-body">
        <div id="topics-wrap" style="margin-bottom:16px;"></div>
        <canvas id="topicChart" height="160"></canvas>
      </div>
    </div>

  </div>

  <!-- ROW 2: Activity + Summary -->
  <div class="grid-3">

    <div class="card">
      <div class="card-head">
        <span class="card-title">📈 Activité par heure</span>
