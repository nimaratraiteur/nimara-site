        <div class="van-online"><span class="van-dot"></span> En ligne</div>
      </div>
    </div>
  </div>
</nav>

<!-- MAIN -->
<main>

  <!-- HEADER -->
  <div class="page-header">
    <div>
      <div class="page-title">Analytics Vanessa</div>
      <div class="page-sub">Ce que vos clients cherchent vraiment</div>
    </div>
    <div class="date-range" style="align-items:center;gap:10px;">
      <div class="live-badge"><span class="van-dot"></span> LIVE</div>
      <button class="dr-btn active">Aujourd'hui</button>
      <button class="dr-btn">7 jours</button>
      <button class="dr-btn">30 jours</button>
    </div>
  </div>

  <!-- KPI CARDS -->
  <div class="kpi-grid">
    <div class="kpi violet">
      <div class="kpi-icon">💬</div>
      <div class="kpi-label">Conversations</div>
      <div class="kpi-value" id="kpi-conv">—</div>
      <div class="kpi-delta up" id="kpi-conv-d">↑ chargement…</div>
    </div>
