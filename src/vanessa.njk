layout: layouts/standalone
permalink: /vanessa/
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vanessa · Analytics — Nimara</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root {
  --bg: #0e0b1a;
  --bg2: #160f28;
  --bg3: #1e1535;
  --card: #1a1030;
  --card2: #221540;
  --violet: #5B2C8D;
  --violet-glow: rgba(91,44,141,.35);
  --lav: #a78bfa;
  --lav2: #c4b5fd;
  --gold: #c9a96e;
  --gold2: #e8c98a;
  --green: #4ade80;
  --red: #f87171;
  --text: #e8e0f4;
  --text2: #9d8fb8;
  --text3: #6b5e80;
  --border: rgba(167,139,250,.1);
  --border2: rgba(167,139,250,.18);
  --r: 14px;
  --r-sm: 8px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden;}

/* NOISE TEXTURE */
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.03'/%3E%3C/svg%3E");pointer-events:none;z-index:0;opacity:.4;}

/* LAYOUT */
.shell{position:relative;z-index:1;display:grid;grid-template-columns:220px 1fr;min-height:100vh;}

/* SIDEBAR */
nav{background:var(--bg2);border-right:1px solid var(--border);padding:28px 0;display:flex;flex-direction:column;gap:4px;position:sticky;top:0;height:100vh;}
.nav-logo{padding:0 20px 24px;border-bottom:1px solid var(--border);margin-bottom:8px;}
.nav-logo .n-badge{display:flex;align-items:center;gap:8px;}
.nav-logo .n-letter{width:32px;height:32px;background:var(--violet);border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:16px;color:white;}
.nav-logo .n-name{font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--lav);font-weight:600;}
.nav-logo .n-sub{font-size:10px;color:var(--text3);letter-spacing:.08em;margin-top:1px;}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px 20px;font-size:13px;color:var(--text2);cursor:pointer;border-radius:0;transition:all .2s;border-left:2px solid transparent;text-decoration:none;}
.nav-item:hover,.nav-item.active{color:var(--lav);background:rgba(167,139,250,.06);border-left-color:var(--lav);}
.nav-item .ni{font-size:16px;width:20px;text-align:center;}
.nav-section{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--text3);padding:16px 20px 4px;font-weight:600;}
.nav-bottom{margin-top:auto;padding:16px 20px;border-top:1px solid var(--border);}
.vanessa-status{display:flex;align-items:center;gap:10px;}
.van-av{width:36px;height:36px;border-radius:50%;overflow:hidden;flex-shrink:0;}
.van-av img{width:100%;height:100%;object-fit:cover;}
.van-av-fb{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--lav),var(--violet));display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;color:white;font-size:14px;flex-shrink:0;}
.van-info{flex:1;min-width:0;}
.van-name{font-size:12px;font-weight:600;color:var(--text);}
.van-online{font-size:10px;color:var(--green);display:flex;align-items:center;gap:4px;}
.van-dot{width:5px;height:5px;background:var(--green);border-radius:50%;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

/* MAIN */
main{padding:32px;overflow-y:auto;}

/* HEADER */
.page-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:32px;}
.page-title{font-family:'Playfair Display',serif;font-size:26px;font-weight:500;color:var(--text);}
.page-sub{font-size:13px;color:var(--text2);margin-top:4px;}
.date-range{display:flex;align-items:center;gap:8px;}
.dr-btn{background:var(--card);border:1px solid var(--border2);color:var(--text2);font-family:'DM Sans',sans-serif;font-size:12px;padding:8px 14px;border-radius:var(--r-sm);cursor:pointer;transition:all .2s;}
.dr-btn:hover,.dr-btn.active{background:var(--violet);color:white;border-color:var(--violet);}
.live-badge{display:flex;align-items:center;gap:6px;background:rgba(74,222,128,.1);border:1px solid rgba(74,222,128,.25);color:var(--green);font-size:11px;font-weight:600;padding:6px 12px;border-radius:20px;letter-spacing:.05em;}

/* KPI CARDS */
.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px;}
.kpi{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:20px;position:relative;overflow:hidden;transition:border-color .2s;}
.kpi:hover{border-color:var(--border2);}
.kpi::before{content:'';position:absolute;top:0;right:0;width:80px;height:80px;border-radius:50%;opacity:.08;transform:translate(20px,-20px);}
.kpi.violet::before{background:var(--lav);}
.kpi.gold::before{background:var(--gold);}
.kpi.green::before{background:var(--green);}
.kpi.red::before{background:var(--red);}
.kpi-label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);font-weight:600;margin-bottom:10px;}
.kpi-value{font-family:'Playfair Display',serif;font-size:32px;color:var(--text);font-weight:500;line-height:1;}
.kpi-delta{display:flex;align-items:center;gap:4px;font-size:11px;margin-top:8px;}
.kpi-delta.up{color:var(--green);}
.kpi-delta.down{color:var(--red);}
.kpi-icon{position:absolute;top:20px;right:20px;font-size:20px;opacity:.5;}

/* 2-COL GRID */
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;}
.grid-3{display:grid;grid-template-columns:2fr 1fr;gap:16px;margin-bottom:24px;}

/* CARD */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;}
.card-head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--border);}
.card-title{font-size:13px;font-weight:600;color:var(--text);letter-spacing:.02em;}
.card-badge{font-size:10px;background:rgba(167,139,250,.12);color:var(--lav);padding:3px 8px;border-radius:10px;font-weight:600;}
.card-body{padding:20px;}

/* BUTTONS CHART */
.btn-row{display:flex;align-items:center;gap:12px;margin-bottom:12px;}
.btn-row:last-child{margin-bottom:0;}
.btn-label{font-size:12px;color:var(--text2);width:160px;flex-shrink:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.btn-bar-wrap{flex:1;background:rgba(255,255,255,.04);border-radius:4px;height:8px;overflow:hidden;}
.btn-bar{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--violet),var(--lav));transition:width 1s cubic-bezier(.22,1,.36,1);}
.btn-count{font-size:11px;color:var(--text3);width:28px;text-align:right;font-weight:600;}

/* TOPICS */
.topic-chip{display:inline-flex;align-items:center;gap:6px;background:var(--card2);border:1px solid var(--border);border-radius:20px;padding:5px 12px;font-size:12px;color:var(--text2);margin:4px;}
.topic-chip .tc-count{background:var(--violet);color:white;border-radius:10px;padding:1px 6px;font-size:10px;font-weight:700;}

/* CONVERSATION LOG */
.conv-table{width:100%;border-collapse:collapse;}
.conv-table th{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);font-weight:600;padding:0 16px 12px;text-align:left;border-bottom:1px solid var(--border);}
.conv-table td{padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.03);font-size:13px;vertical-align:middle;}
.conv-table tr:hover td{background:rgba(167,139,250,.04);}
.conv-table tr{cursor:pointer;transition:background .15s;}
.session-id{font-family:monospace;font-size:11px;color:var(--text3);}
.msg-count{background:rgba(167,139,250,.12);color:var(--lav);border-radius:10px;padding:2px 8px;font-size:11px;font-weight:600;}
.conv-signal{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;padding:3px 8px;border-radius:10px;}
.conv-signal.hot{background:rgba(74,222,128,.12);color:var(--green);}
.conv-signal.warm{background:rgba(201,169,110,.12);color:var(--gold);}
.conv-signal.cold{background:rgba(255,255,255,.05);color:var(--text3);}
.device-icon{font-size:14px;}

/* CONVERSATION DETAIL PANEL */
.detail-panel{position:fixed;right:0;top:0;width:420px;height:100vh;background:var(--bg2);border-left:1px solid var(--border2);z-index:100;transform:translateX(100%);transition:transform .35s cubic-bezier(.22,1,.36,1);overflow-y:auto;display:flex;flex-direction:column;}
.detail-panel.open{transform:translateX(0);}
.dp-head{padding:20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.dp-close{background:rgba(255,255,255,.08);border:none;color:var(--text2);width:30px;height:30px;border-radius:50%;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;}
.dp-close:hover{background:rgba(255,255,255,.15);color:var(--text);}
.dp-meta{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;flex-wrap:wrap;gap:8px;}
.dp-tag{font-size:11px;background:var(--card2);border:1px solid var(--border);border-radius:6px;padding:4px 10px;color:var(--text2);}
.dp-chat{flex:1;padding:16px 20px;display:flex;flex-direction:column;gap:10px;}
.dp-msg{display:flex;gap:8px;align-items:flex-start;}
.dp-msg.user{flex-direction:row-reverse;}
.dp-av{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0;overflow:hidden;}
.dp-av.v img{width:100%;height:100%;object-fit:cover;}
.dp-av.v-fb{background:linear-gradient(135deg,var(--lav),var(--violet));color:white;font-size:10px;}
.dp-av.u{background:var(--card2);color:var(--text2);font-size:10px;}
.dp-bubble{max-width:82%;padding:9px 13px;border-radius:14px;font-size:12.5px;line-height:1.55;}
.dp-msg.van .dp-bubble{background:var(--card2);color:var(--text);border-bottom-left-radius:3px;}
.dp-msg.user .dp-bubble{background:linear-gradient(135deg,var(--violet),#7c3aab);color:white;border-bottom-right-radius:3px;}
.dp-time{font-size:10px;color:var(--text3);margin-top:3px;}
.dp-btn-click{display:flex;align-items:center;gap:6px;padding:6px 12px;background:rgba(167,139,250,.08);border:1px solid rgba(167,139,250,.15);border-radius:20px;font-size:11px;color:var(--lav);margin:0 auto;width:fit-content;}

/* HOUR CHART */
.hour-chart{padding:20px;}

/* SUMMARY BAR */
.summary-row{display:flex;align-items:center;justify-content:space-between;padding:12px 20px;border-bottom:1px solid var(--border);font-size:12px;}
.summary-row:last-child{border-bottom:none;}
.sr-label{color:var(--text2);}
.sr-value{font-weight:600;color:var(--text);}

/* BACK LINK */
.back-link{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--text3);padding:10px 20px 0;text-decoration:none;transition:color .2s;}
.back-link:hover{color:var(--lav);}

/* RESPONSIVE */
@media(max-width:1100px){.kpi-grid{grid-template-columns:repeat(2,1fr);}. grid-2{grid-template-columns:1fr;}}
@media(max-width:768px){.shell{grid-template-columns:1fr;}nav{display:none;}main{padding:16px;}}
</style>
</head>
<body>
<div class="shell">

<!-- SIDEBAR -->
<nav>
  <div class="nav-logo">
    <div class="n-badge">
      <div class="n-letter">N</div>
      <div>
        <div class="n-name">Nimara</div>
        <div class="n-sub">Analytics Hub</div>
      </div>
    </div>
  </div>

  <a class="back-link" href="/" style="padding:14px 20px 8px;border-bottom:1px solid var(--border);margin-bottom:8px">
    ← Retour au site
  </a>

  <span class="nav-section">Vanessa</span>
  <a class="nav-item active" href="#"><span class="ni">📊</span> Dashboard</a>
  <a class="nav-item" href="#"><span class="ni">💬</span> Conversations</a>
  <a class="nav-item" href="#"><span class="ni">🎯</span> Conversions</a>

  <span class="nav-section">Analyse</span>
  <a class="nav-item" href="#"><span class="ni">📈</span> Tendances</a>
  <a class="nav-item" href="#"><span class="ni">🔘</span> Boutons cliqués</a>
  <a class="nav-item" href="#"><span class="ni">💡</span> Suggestions</a>

  <span class="nav-section">Système</span>
  <a class="nav-item" href="#"><span class="ni">⚙️</span> Paramètres</a>
  <a class="nav-item" href="#"><span class="ni">🔗</span> Intégration n8n</a>
  <a class="nav-item" href="#"><span class="ni">🎙️</span> Vapi Voice</a>

  <div class="nav-bottom">
    <div class="vanessa-status">
      <div class="van-av">
        <img src="/assets/images/vanessa-avatar.png" alt="Vanessa"
             onerror="this.parentElement.className='van-av-fb';this.remove();this.parentElement.innerHTML='V'">
      </div>
      <div class="van-info">
