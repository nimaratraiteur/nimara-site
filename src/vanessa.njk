</main>
</div>

<!-- DETAIL PANEL -->
<div class="detail-panel" id="detail-panel">
  <div class="dp-head">
    <div>
      <div style="font-size:13px;font-weight:600;color:var(--text);">Détail de conversation</div>
      <div style="font-size:11px;color:var(--text3);margin-top:2px;" id="dp-session-id">—</div>
    </div>
    <button class="dp-close" onclick="closeDetail()">✕</button>
  </div>
  <div class="dp-meta" id="dp-meta"></div>
  <div class="dp-chat" id="dp-chat"></div>
</div>

<script>
/* ═══════════════════════════════════════════
   VANESSA ANALYTICS DASHBOARD
   Connected to n8n analytics backend
   ═══════════════════════════════════════════ */

const ANALYTICS_API = 'https://nimarageneve.app.n8n.cloud/webhook/vanessa-analytics';
let currentRange = 'today';
let analyticsData = null;

/* ── Fetch analytics from backend ────────── */
async function fetchAnalytics(range) {
  try {
    const res = await fetch(ANALYTICS_API + '?range=' + range, {
      headers: { 'Accept': 'application/json' }
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    return await res.json();
  } catch (err) {
    console.warn('[Analytics] Backend unreachable:', err.message);
    return null;
  }
}

/* ── Count-up animation ──────────────────── */
function countUp(el, end, suffix) {
  suffix = suffix || '';
  let start = 0;
  const dur = 800;
  const step = end / dur * 16;
  const timer = setInterval(function() {
    start = Math.min(start + step, end);
    el.textContent = Math.round(start) + suffix;
    if (start >= end) clearInterval(timer);
  }, 16);
}

/* ── Render dashboard ────────────────────── */
function renderDashboard(data) {
  if (!data) {
    document.getElementById('kpi-conv').textContent = '0';
    document.getElementById('kpi-conv-d').textContent = 'En attente de donnees...';
    document.getElementById('kpi-conv-rate').textContent = '0%';
    document.getElementById('kpi-rate-d').textContent = 'Aucune conversation';
    document.getElementById('kpi-clicks').textContent = '0';
    document.getElementById('kpi-click-d').textContent = 'Aucun clic';
    document.getElementById('kpi-mobile').textContent = '—';
    document.getElementById('kpi-mob-d').textContent = 'Pas de donnees';
    document.getElementById('summary-rows').innerHTML = '<div class="summary-row"><span class="sr-label">Statut</span><span class="sr-value">En attente de conversations</span></div>';
    document.getElementById('log-count-badge').textContent = '0 sessions';
    document.getElementById('conv-log').innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text3);padding:40px">Aucune conversation enregistree. Les donnees apparaitront des que Vanessa recevra des messages.</td></tr>';
    return;
  }

  analyticsData = data;
  var t = data.totals;

  // KPI cards
  setTimeout(function() {
    countUp(document.getElementById('kpi-conv'), t.conversations);
    countUp(document.getElementById('kpi-conv-rate'), data.conversionRate, '%');
    var totalClicks = t.whatsappClicks + t.carteClicks + t.calculateurClicks;
    countUp(document.getElementById('kpi-clicks'), totalClicks);
    document.getElementById('kpi-mobile').textContent = data.avgMessages.toFixed(1);
  }, 200);

  document.getElementById('kpi-conv-d').textContent = t.messages + ' messages total';
  document.getElementById('kpi-rate-d').textContent = t.hotSignals + ' signaux chauds detectes';
  var totalClicks = t.whatsappClicks + t.carteClicks + t.calculateurClicks;
  document.getElementById('kpi-click-d').textContent = t.whatsappClicks + ' WhatsApp, ' + t.carteClicks + ' carte';
  document.getElementById('kpi-mob-d').textContent = 'Msg/session en moyenne';

  // Buttons chart
  var btnData = [
    { label: '🍛 Voir la carte', count: t.carteClicks },
    { label: '🧮 Calculateur', count: t.calculateurClicks },
    { label: '💬 WhatsApp', count: t.whatsappClicks }
  ].filter(function(b) { return b.count > 0; }).sort(function(a, b) { return b.count - a.count; });

  document.getElementById('total-clicks-badge').textContent = totalClicks + ' clics';

  if (btnData.length > 0) {
    var maxBtn = btnData[0].count;
    document.getElementById('btn-chart').innerHTML = btnData.map(function(b) {
      return '<div class="btn-row">' +
        '<div class="btn-label" title="' + b.label + '">' + b.label + '</div>' +
        '<div class="btn-bar-wrap"><div class="btn-bar" style="width:0%" data-w="' + Math.round(b.count / maxBtn * 100) + '"></div></div>' +
        '<div class="btn-count">' + b.count + '</div>' +
      '</div>';
    }).join('');
    setTimeout(function() {
      document.querySelectorAll('.btn-bar').forEach(function(b) { b.style.width = b.dataset.w + '%'; });
    }, 300);
  } else {
    document.getElementById('btn-chart').innerHTML = '<div style="color:var(--text3);font-size:12px;padding:20px;text-align:center">Pas encore de clics enregistres</div>';
  }

  // Signal distribution (topic chart area)
  var signalData = [
    { label: 'Chaud (hot)', count: t.hotSignals, color: '#4ade80' },
    { label: 'Tiede (warm)', count: t.warmSignals, color: '#c9a96e' },
    { label: 'Froid (cold)', count: t.coldSignals, color: '#6b5e80' }
  ].filter(function(s) { return s.count > 0; });

  document.getElementById('topics-wrap').innerHTML = signalData.map(function(s) {
    return '<span class="topic-chip">' + s.label + '<span class="tc-count">' + s.count + '</span></span>';
  }).join('');

  if (signalData.length > 0) {
    new Chart(document.getElementById('topicChart'), {
      type: 'doughnut',
      data: {
        labels: signalData.map(function(s) { return s.label; }),
        datasets: [{ data: signalData.map(function(s) { return s.count; }), backgroundColor: signalData.map(function(s) { return s.color; }), borderWidth: 0, hoverOffset: 6 }]
      },
      options: { plugins: { legend: { labels: { color: '#9d8fb8', font: { family: 'DM Sans', size: 11 }, boxWidth: 10 } } }, cutout: '68%', responsive: true, maintainAspectRatio: true }
    });
  }

  // Activity by day/hour chart
  var daily = data.dailyBreakdown || [];
  if (daily.length > 0) {
    new Chart(document.getElementById('hourChart'), {
      type: 'bar',
      data: {
        labels: daily.map(function(d) { return d.date.split('-').reverse().join('.'); }),
        datasets: [{
          data: daily.map(function(d) { return d.messages; }),
          backgroundColor: function(ctx) {
            var g = ctx.chart.ctx.createLinearGradient(0, 0, 0, 120);
            g.addColorStop(0, 'rgba(167,139,250,.8)');
            g.addColorStop(1, 'rgba(91,44,141,.3)');
            return g;
          },
          borderRadius: 6,
          borderSkipped: false
        }]
      },
      options: { plugins: { legend: { display: false } }, scales: { x: { grid: { display: false }, ticks: { color: '#6b5e80', font: { size: 10 } } }, y: { grid: { color: 'rgba(255,255,255,.04)' }, ticks: { color: '#6b5e80', font: { size: 10 }, stepSize: 1 } } }, responsive: true, maintainAspectRatio: true }
    });
  }

  // Summary
  var totalConv = t.conversations || 1;
  document.getElementById('summary-rows').innerHTML = [
    ['Conversations', t.conversations],
    ['Messages total', t.messages],
    ['Signaux chauds', t.hotSignals + ' (' + Math.round(t.hotSignals / totalConv * 100) + '%)'],
    ['Signaux tiedes', t.warmSignals + ' (' + Math.round(t.warmSignals / totalConv * 100) + '%)'],
    ['Navigation pure', t.coldSignals],
    ['Clics WhatsApp', t.whatsappClicks],
    ['Clics carte', t.carteClicks],
    ['Clics calculateur', t.calculateurClicks],
    ['Tokens utilises', (t.inputTokens + t.outputTokens).toLocaleString('fr-CH')],
    ['Cout estime (USD)', '$' + (data.tokenCost ? data.tokenCost.estimatedCostUSD : 0)]
  ].map(function(r) { return '<div class="summary-row"><span class="sr-label">' + r[0] + '</span><span class="sr-value">' + r[1] + '</span></div>'; }).join('');

  // Recent events log
  var events = data.recentEvents || [];
  document.getElementById('log-count-badge').textContent = events.length + ' evenements';
  if (events.length > 0) {
    document.getElementById('conv-log').innerHTML = events.map(function(e) {
      var time = e.timestamp ? new Date(e.timestamp).toLocaleTimeString('fr-CH', { hour: '2-digit', minute: '2-digit' }) : '—';
      var signalClass = e.signal || 'cold';
      var signalLabel = signalClass === 'hot' ? 'Veut commander' : signalClass === 'warm' ? 'Interesse' : 'Navigation';
      var msgPreview = (e.userMessage || '').substring(0, 40);
      if (msgPreview.length >= 40) msgPreview += '...';
      return '<tr onclick="openEventDetail(this)" data-event=\'' + JSON.stringify(e).replace(/'/g, '&apos;') + '\'>' +
        '<td><span class="session-id">#' + (e.sessionId || '—') + '</span></td>' +
        '<td style="color:var(--text2);font-size:12px">' + time + '</td>' +
        '<td style="font-size:12px;color:var(--lav)">' + msgPreview + '</td>' +
        '<td><span class="msg-count">1 msg</span></td>' +
        '<td><span class="conv-signal ' + signalClass + '">' + signalLabel + '</span></td>' +
        '<td><span class="device-icon">💬</span></td>' +
      '</tr>';
    }).join('');
  } else {
    document.getElementById('conv-log').innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text3);padding:40px">Aucun evenement enregistre pour cette periode.</td></tr>';
  }
}

/* ── Event detail panel ──────────────────── */
function openEventDetail(row) {
  try {
    var e = JSON.parse(row.dataset.event);
    document.getElementById('dp-session-id').textContent = '#' + (e.sessionId || '—');
    document.getElementById('dp-meta').innerHTML = [
      '<span class="dp-tag conv-signal ' + (e.signal || 'cold') + '">' + (e.signal || 'cold') + '</span>',
      '<span class="dp-tag">' + (e.page || '/') + '</span>',
      e.inputTokens ? '<span class="dp-tag">' + e.inputTokens + ' in / ' + e.outputTokens + ' out tokens</span>' : ''
    ].join('');
    var vanAvatar = '<div class="dp-av v"><img src="/assets/images/vanessa-avatar.png" alt="V" onerror="this.parentElement.className=\'dp-av v-fb\';this.remove();this.parentElement.textContent=\'V\'"></div>';
    var userAvatar = '<div class="dp-av u">C</div>';
    document.getElementById('dp-chat').innerHTML =
      '<div class="dp-msg user">' + userAvatar + '<div><div class="dp-bubble">' + (e.userMessage || '—') + '</div></div></div>' +
      '<div class="dp-msg van">' + vanAvatar + '<div><div class="dp-bubble">' + (e.botReply || '—') + '</div></div></div>';
    document.getElementById('detail-panel').classList.add('open');
  } catch (err) { /* ignore parse errors */ }
}

function closeDetail() {
  document.getElementById('detail-panel').classList.remove('open');
}

/* ── Date range buttons ──────────────────── */
document.querySelectorAll('.dr-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.dr-btn').forEach(function(b) { b.classList.remove('active'); });
    this.classList.add('active');
    var label = this.textContent.trim();
    if (label === "Aujourd'hui") currentRange = 'today';
    else if (label === '7 jours') currentRange = '7d';
    else if (label === '30 jours') currentRange = '30d';
    loadDashboard();
  });
});

/* ── Load dashboard ──────────────────────── */
async function loadDashboard() {
  var data = await fetchAnalytics(currentRange);
  renderDashboard(data);
}

/* ── Init ────────────────────────────────── */
window.addEventListener('DOMContentLoaded', function() {
  loadDashboard();
  // Auto-refresh every 30s
  setInterval(loadDashboard, 30000);
});
</script>
</body>
</html>
