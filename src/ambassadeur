<script>
// ============================================================
// REF TRACKING
// UX: Personalize based on referrer → trust + conversion lift
// ============================================================
const params = new URLSearchParams(window.location.search);
const refParam = params.get('ref') || '';
let refName = '';

if (refParam) {
  // Format: "sophie-maillard" → "Sophie Maillard"
  refName = refParam
    .split('-')
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');

  // Show referral banner
  document.getElementById('ref-display-name').textContent = refName;
  document.getElementById('ref-pill-name').textContent = refName;
  document.getElementById('ref-banner').classList.add('show');

  // Store ref in sessionStorage for tracking
  sessionStorage.setItem('nimara_ref', refParam);
  sessionStorage.setItem('nimara_ref_name', refName);
}

// Restore ref from session if navigated away
const storedRef = sessionStorage.getItem('nimara_ref');
const storedRefName = sessionStorage.getItem('nimara_ref_name');
if (!refParam && storedRef) {
  refName = storedRefName || '';
}

// ============================================================
// TICKER — Social proof
// ============================================================
const tickerItems = [
  '🎉 Impact Hub Genève — traiteur Hackathon 3 jours',
  '✓ Events Concept SA — 3 événements en 6 mois',
  '🏆 Cuisine indienne fraîche · Livraison Genève',
  '✓ 58% de clients récurrents',
  '🌿 Halal · Artisanal · Sans additifs',
  '🎉 Organisation Internationale pour les Migrations — événement 80 personnes',
  '✓ Panier moyen événement : CHF 1\'947',
  '⭐ Livraison dans vos bureaux · Zéro effort',
];

const doubled = [...tickerItems, ...tickerItems];
const ticker = document.getElementById('ticker-content');
ticker.innerHTML = doubled.map(item => `
  <span class="ticker-item">
    <span class="ticker-dot"></span>
    ${item}
  </span>
`).join('');

// ============================================================
// SCROLL REVEAL
// UX: Progressive disclosure — content appears as needed
// ============================================================
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
      revealObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

document.querySelectorAll('.reveal').forEach((el, i) => {
  el.style.transitionDelay = `${i * 0.05}s`;
  revealObserver.observe(el);
});

// ============================================================
// COPY SCRIPT
// ============================================================
function copyScript(btn) {
  const text = document.getElementById('script-text').textContent.trim();
  navigator.clipboard.writeText(text).then(() => {
    btn.classList.add('copied');
    btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Copié !`;
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg> Copier la phrase`;
    }, 2500);
  });
}

// ============================================================
// FORM SUBMIT
// ============================================================
function handleSubmit(e) {
  e.preventDefault();

  const name = document.getElementById('name').value.trim();
  const email = document.getElementById('email').value.trim();
  const menu = document.getElementById('menu').checked;
  const btn = document.getElementById('submit-btn');

  if (!name || !email) return;

  // Loading state
  btn.classList.add('loading');

  // Generate ref slug for this person
  const myRefSlug = name.toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

  const myRefLink = `nimara.io/ambassadeur?ref=${myRefSlug}`;
  const firstName = name.split(' ')[0].toUpperCase();

  // Build WhatsApp notification to Nikhil
  let waMsg = `🎉 Nouvel Ambassadeur BNI !\n\nNom : ${name}\nEmail : ${email}\nMenu souhaité : ${menu ? 'Oui ✓' : 'Non'}\nLien unique : nimara.io/ambassadeur?ref=${myRefSlug}`;
  if (refName) waMsg += `\n\nRéféré par : ${refName}`;

  // Send to n8n webhook -> Google Sheet
  fetch("https://nimarageneve.app.n8n.cloud/webhook/nimara-ambassadeur", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({name, email, menu, refSlug: myRefSlug, referredBy: refName || null, timestamp: new Date().toISOString()})
  }).catch(err => console.log("Webhook:", err));

  // GA event
  if (typeof gtag === "function") gtag("event", "ambassadeur_inscription", {event_category: "conversion", event_label: name});

  // Save to localStorage for admin
  const entries = JSON.parse(localStorage.getItem('nimara_ambassadeurs_bni') || '[]');
  entries.push({
    id: 'reg-' + Date.now(),
    name, email, menu,
    refSlug: myRefSlug,
    referredBy: refName || null,
    badgeDone: false,
    timestamp: Date.now()
  });
  localStorage.setItem('nimara_ambassadeurs_bni', JSON.stringify(entries));

  setTimeout(() => {
    // Transition
    const formStep = document.getElementById('step-form');
    const confirmStep = document.getElementById('step-confirm');

    formStep.style.opacity = '0';
    formStep.style.transform = 'translateY(-16px)';
    formStep.style.transition = 'all 0.35s ease';

    setTimeout(() => {
      formStep.style.display = 'none';
      confirmStep.style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Update confirmation screen
      document.getElementById('confirm-first-name').textContent = firstName;
      document.getElementById('my-ref-link').textContent = myRefLink;
      document.getElementById('wa-confirm-btn').href = `https://wa.me/41225576020?text=${encodeURIComponent(waMsg)}`;

      if (refName) {
        document.getElementById('confirm-sub-text').innerHTML =
          `Référé par <strong>${refName}</strong>. Un email avec ton lien et le menu arrive.<br><strong>Va chercher ton cinnamon roll. 🎉</strong>`;
      }

      // Trigger scroll reveals on confirm page
      document.querySelectorAll('#step-confirm .reveal').forEach(el => {
        el.classList.add('visible');
      });

    }, 350);
  }, 800); // Simulated loading
}

// ============================================================
// COPY MY LINK
// ============================================================
function copyMyLink() {
  const link = document.getElementById('my-ref-link').textContent;
  const btn = document.getElementById('copy-link-btn');
  navigator.clipboard.writeText('https://' + link).then(() => {
    btn.textContent = 'Copié ✓';
    btn.classList.add('copied');
    setTimeout(() => {
      btn.textContent = 'Copier';
      btn.classList.remove('copied');
    }, 2500);
  });
}

// ============================================================
// HAPTIC-LIKE FEEDBACK on mobile (vibration API)
// UX: Tactile micro-feedback on submit
// ============================================================
document.getElementById('submit-btn').addEventListener('click', () => {
  if (navigator.vibrate) navigator.vibrate(10);
});
</script>

