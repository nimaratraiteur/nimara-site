<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0e0b1a">
<title>Nimara — Programme Ambassadeur</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ======================================================
   DESIGN SYSTEM — NIMARA AMBASSADEUR
   Aesthetic: Dark luxury editorial × artisan warmth
   Unforgettable: The referrer's name displayed as hero
   UX principles: Zero friction, social proof, urgency,
   personalization, micro-interactions, mobile-first
====================================================== */

:root {
  --violet: #5B2C8D;
  --violet-deep: #3b1a6e;
  --lavande: #a78bfa;
  --lavande-soft: #c4b5fd;
  --dark: #0e0b1a;
  --dark-mid: #130f22;
  --card: #1a1630;
  --card-hover: #1e1a38;
  --border: #2a2450;
  --border-soft: #1e1b35;
  --text: #e8e0ff;
  --muted: #7c6fa0;
  --faint: #3d3460;
  --white: #ffffff;
  --cream: #fdf8f0;
  --green: #4ade80;
  --green-soft: #14532d33;
  --amber: #fbbf24;
  --red: #f87171;

  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-pill: 999px;

  --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  --shadow-violet: 0 8px 32px rgba(91, 44, 141, 0.4);
  --shadow-card: 0 4px 24px rgba(0, 0, 0, 0.4);
}

*, *::before, *::after {
  margin: 0; padding: 0;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--dark);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ============ BACKGROUND AMBIENT ============ */
.bg-ambient {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.bg-ambient::before {
  content: '';
  position: absolute;
  top: -30%; left: 50%;
  transform: translateX(-50%);
  width: 120%;
  height: 80%;
  background: radial-gradient(ellipse, #5B2C8D44 0%, transparent 65%);
  animation: ambient-pulse 8s ease-in-out infinite;
}
.bg-ambient::after {
  content: '';
  position: absolute;
  bottom: 0; right: -10%;
  width: 60%;
  height: 60%;
  background: radial-gradient(ellipse, #a78bfa11 0%, transparent 70%);
  animation: ambient-pulse 10s ease-in-out infinite reverse;
}
@keyframes ambient-pulse {
  0%, 100% { opacity: 0.6; transform: translateX(-50%) scale(1); }
  50% { opacity: 1; transform: translateX(-50%) scale(1.05); }
}

/* ============ SOCIAL PROOF TICKER ============ */
/* UX: Social proof — active users creates trust (Cialdini) */
.ticker {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: linear-gradient(90deg, var(--violet), #7c3aed);
  padding: 8px 16px;
  overflow: hidden;
  height: 36px;
}
.ticker-inner {
  display: flex;
  align-items: center;
  gap: 40px;
  white-space: nowrap;
  animation: ticker-scroll 20s linear infinite;
}
.ticker-inner:hover { animation-play-state: paused; }
@keyframes ticker-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.ticker-item {
  font-size: 12px;
  font-weight: 600;
  color: rgba(255,255,255,0.9);
  display: flex;
  align-items: center;
  gap: 8px;
  letter-spacing: 0.3px;
  flex-shrink: 0;
}
.ticker-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--lavande-soft);
  animation: blink 2s ease infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }

/* ============ FLOATING WHATSAPP ============ */
/* UX: Always-visible CTA — never more than one tap away */
.wa-float {
  position: fixed;
  bottom: 24px; right: 20px;
  z-index: 200;
  width: 56px; height: 56px;
  border-radius: 50%;
  background: #25D366;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 20px rgba(37, 211, 102, 0.5);
  transition: var(--transition);
  text-decoration: none;
  cursor: pointer;
}
.wa-float:hover {
  transform: scale(1.1);
  box-shadow: 0 6px 28px rgba(37, 211, 102, 0.6);
}
.wa-float:active { transform: scale(0.96); }
.wa-pulse {
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 2px solid #25D366;
  opacity: 0;
  animation: wa-pulse 2.5s ease-out infinite;
}
@keyframes wa-pulse {
  0% { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(1.5); opacity: 0; }
}

/* ============ MAIN LAYOUT ============ */
.page {
  position: relative;
  z-index: 1;
  padding-top: 36px; /* ticker height */
}

/* ============ REFERRAL BANNER ============ */
/* UX: Personalization = trust + social proof in one */
.ref-banner {
  display: none;
  background: linear-gradient(135deg, #5B2C8D22, #a78bfa11);
  border-bottom: 1px solid var(--violet);
  padding: 14px 20px;
  text-align: center;
  animation: slideDown 0.5s ease forwards;
}
.ref-banner.show { display: block; }
@keyframes slideDown {
  from { opacity: 0; transform: translateY(-8px); }
  to { opacity: 1; transform: translateY(0); }
}
.ref-banner p {
  font-size: 13px;
  color: var(--lavande-soft);
  line-height: 1.5;
}
.ref-banner strong { color: var(--white); }
.ref-name-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--violet);
  border-radius: var(--radius-pill);
  padding: 3px 12px;
  font-size: 12px;
  font-weight: 700;
  color: var(--white);
  margin-top: 6px;
}

/* ============ HERO ============ */
.hero {
  padding: clamp(40px, 8vw, 80px) 20px clamp(32px, 6vw, 56px);
  text-align: center;
  max-width: 560px;
  margin: 0 auto;
}
.logo-badge {
  display: inline-block;
  background: var(--violet);
  color: var(--white);
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 4px;
  padding: 8px 18px;
  border-radius: var(--radius-sm);
  margin-bottom: 28px;
}
.logo-badge span { color: var(--lavande); }

/* UX: The headline is the hero — clear hierarchy */
.hero-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(42px, 11vw, 68px);
  font-weight: 300;
  line-height: 1.1;
  color: var(--white);
  margin-bottom: 16px;
  letter-spacing: -0.5px;
}
.hero-title em {
  font-style: italic;
  color: var(--lavande);
}
.hero-subtitle {
  font-size: clamp(14px, 3.5vw, 17px);
  color: var(--muted);
  line-height: 1.7;
  margin-bottom: 28px;
  font-weight: 300;
}
.hero-subtitle strong { color: var(--lavande-soft); font-weight: 500; }

/* UX: Urgency + social proof in one line */
.availability-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--green-soft);
  border: 1px solid rgba(74, 222, 128, 0.3);
  border-radius: var(--radius-pill);
  padding: 8px 16px;
  font-size: 13px;
  color: var(--green);
  font-weight: 600;
}
.avail-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--green);
  animation: blink 1.5s ease infinite;
}

/* ============ SOCIAL PROOF STRIP ============ */
/* UX: Numbers create trust before the ask */
.proof-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--border);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  margin-bottom: 32px;
}
.proof-item {
  background: var(--dark-mid);
  padding: 18px 12px;
  text-align: center;
}
.proof-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(24px, 6vw, 36px);
  font-weight: 600;
  color: var(--lavande);
  line-height: 1;
}
.proof-label {
  font-size: 11px;
  color: var(--muted);
  margin-top: 4px;
  line-height: 1.4;
}

/* ============ MAIN CONTENT ============ */
.content {
  max-width: 480px;
  margin: 0 auto;
  padding: 0 20px 100px;
}

/* ============ SECTION HEADINGS ============ */
.section-eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--lavande);
  margin-bottom: 12px;
}

/* ============ FORM CARD ============ */
/* UX: Card creates a "safe space" — reduces anxiety */
.form-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28px 24px;
  position: relative;
  overflow: hidden;
  margin-bottom: 20px;
  box-shadow: var(--shadow-card);
}
.form-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--violet), var(--lavande));
}

/* UX: Field labels always visible — no placeholder-only */
.field { margin-bottom: 18px; }
.field:last-of-type { margin-bottom: 0; }

.field label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 8px;
}
.field label .required {
  color: var(--lavande);
  font-size: 10px;
  letter-spacing: 0;
  text-transform: none;
  font-weight: 400;
}

.field input[type="text"],
.field input[type="email"] {
  width: 100%;
  background: var(--dark);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 14px 16px;
  font-family: 'DM Sans', sans-serif;
  font-size: 16px; /* critical: 16px prevents iOS zoom */
  color: var(--white);
  outline: none;
  transition: var(--transition);
  -webkit-appearance: none;
}
/* UX: Clear focus state — user always knows where they are */
.field input:focus {
  border-color: var(--lavande);
  background: #130f22;
  box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.15);
}
.field input:valid:not(:placeholder-shown) {
  border-color: var(--green);
}
.field input::placeholder { color: var(--faint); }

/* UX: Inline validation — instant feedback */
.field-hint {
  font-size: 11px;
  color: var(--muted);
  margin-top: 6px;
  display: none;
}
.field input:focus + .field-hint { display: block; }

/* ============ CHECKBOX ============ */
/* UX: Pre-checked = opt-out, not opt-in. Higher conversion. */
.check-row {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px;
  background: var(--dark);
  border-radius: var(--radius-sm);
  border: 1.5px solid var(--border);
  cursor: pointer;
  transition: var(--transition);
  margin-top: 4px;
}
.check-row:hover { border-color: var(--lavande); background: #130f22; }

.check-input {
  width: 22px; height: 22px;
  min-width: 22px;
  border: 2px solid var(--border);
  border-radius: 6px;
  background: var(--dark);
  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;
  position: relative;
  transition: var(--transition);
  margin-top: 1px;
}
.check-input:checked {
  background: var(--violet);
  border-color: var(--violet);
}
.check-input:checked::after {
  content: '';
  position: absolute;
  left: 6px; top: 3px;
  width: 6px; height: 10px;
  border: 2px solid white;
  border-top: none;
  border-left: none;
  transform: rotate(45deg);
}
.check-label {
  font-size: 13px;
  color: var(--muted);
  line-height: 1.5;
}
.check-label strong { color: var(--lavande-soft); font-weight: 500; }

/* ============ SUBMIT BUTTON ============ */
/* UX: Primary CTA is impossible to miss, tactile feel */
.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, var(--violet), #7c3aed);
  color: var(--white);
  border: none;
  border-radius: var(--radius-md);
  padding: 18px 24px;
  font-family: 'DM Sans', sans-serif;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.3px;
  cursor: pointer;
  margin-top: 20px;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-violet);
  transition: var(--transition);
  -webkit-appearance: none;
}
.btn-submit:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 36px rgba(91, 44, 141, 0.55);
}
.btn-submit:active { transform: translateY(0) scale(0.98); }
/* Shimmer effect on button */
.btn-submit::after {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
  transition: left 0.6s ease;
}
.btn-submit:hover::after { left: 150%; }

/* UX: Loading state — confirms action, prevents double-submit */
.btn-submit.loading {
  pointer-events: none;
  opacity: 0.8;
}
.btn-submit.loading .btn-text { opacity: 0; }
.btn-submit.loading::before {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 20px; height: 20px;
  border: 2px solid rgba(255,255,255,0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: translate(-50%, -50%) rotate(360deg); } }

/* UX: Micro-trust — privacy note under CTA */
.privacy-note {
  text-align: center;
  font-size: 11px;
  color: var(--faint);
  margin-top: 12px;
  line-height: 1.5;
}
.privacy-note a { color: var(--muted); text-decoration: underline; }

/* ============ TRUST SIGNALS ============ */
/* UX: Trust signals reduce anxiety before commitment */
.trust-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 16px;
}
.trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 12px 8px;
  background: var(--card);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-sm);
}
.trust-icon { font-size: 18px; }
.trust-text {
  font-size: 10px;
  color: var(--muted);
  text-align: center;
  line-height: 1.4;
}

/* ============ WHAT YOU GET ============ */
.benefit-list { display: flex; flex-direction: column; gap: 12px; margin-top: 16px; }
.benefit-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 16px;
  background: var(--card);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-md);
  transition: var(--transition);
  /* UX: Hover affordance on all cards */
}
.benefit-item:hover {
  border-color: var(--violet);
  background: var(--card-hover);
  transform: translateX(4px);
}
.benefit-icon {
  font-size: 24px;
  flex-shrink: 0;
  width: 44px; height: 44px;
  background: linear-gradient(135deg, #5B2C8D33, #a78bfa11);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}
.benefit-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--white);
  margin-bottom: 3px;
}
.benefit-desc {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.5;
}
.benefit-desc strong { color: var(--lavande-soft); font-weight: 500; }

/* ============ SCRIPT BOX ============ */
.script-box {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 20px;
  margin-top: 20px;
  position: relative;
  overflow: hidden;
}
.script-box::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, var(--violet), var(--lavande));
}
.script-eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--lavande);
  margin-bottom: 12px;
}
.script-quote {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(16px, 4vw, 20px);
  font-style: italic;
  color: var(--text);
  line-height: 1.6;
  border-left: 3px solid var(--violet);
  padding-left: 16px;
}
/* UX: Copy button = reduces friction to share */
.copy-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 7px 14px;
  font-family: 'DM Sans', sans-serif;
  font-size: 12px;
  color: var(--muted);
  cursor: pointer;
  margin-top: 14px;
  transition: var(--transition);
}
.copy-btn:hover { border-color: var(--lavande); color: var(--lavande); }
.copy-btn.copied { color: var(--green); border-color: var(--green); }

/* ============ CONFIRMATION SCREEN ============ */
#step-confirm { display: none; }

.confirm-hero {
  padding: clamp(40px, 8vw, 80px) 20px 24px;
  text-align: center;
  max-width: 480px;
  margin: 0 auto;
}

/* Badge animé */
.badge-anim {
  width: 140px; height: 140px;
  margin: 0 auto 28px;
  position: relative;
}
.badge-ring {
  position: absolute;
  inset: -8px;
  border-radius: 50%;
  border: 1.5px solid var(--lavande);
  opacity: 0;
  animation: ring-expand 2.5s ease-out infinite;
}
.badge-ring:nth-child(2) { animation-delay: 0.8s; }
.badge-ring:nth-child(3) { animation-delay: 1.6s; }
@keyframes ring-expand {
  0% { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(1.4); opacity: 0; }
}
.badge-circle {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--violet), #7c3aed);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-violet);
  animation: badge-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}
@keyframes badge-in {
  from { transform: scale(0.3); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.badge-star { font-size: 28px; margin-bottom: 2px; }
.badge-word {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--lavande-soft);
}
.badge-person {
  font-size: 11px;
  font-weight: 700;
  color: var(--white);
  margin-top: 2px;
}

.confirm-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(32px, 8vw, 48px);
  font-weight: 300;
  line-height: 1.1;
  color: var(--white);
  margin-bottom: 10px;
}
.confirm-title em { font-style: italic; color: var(--lavande); }

.confirm-sub {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 28px;
}
.confirm-sub strong { color: var(--lavande-soft); font-weight: 500; }

/* Reward card */
.reward-card {
  background: linear-gradient(135deg, #5B2C8D33, #a78bfa11);
  border: 1px solid var(--violet);
  border-radius: var(--radius-md);
  padding: 18px 20px;
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 16px;
  animation: slideUp 0.5s ease 0.3s both;
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}
.reward-icon { font-size: 32px; flex-shrink: 0; }
.reward-title { font-size: 15px; font-weight: 700; color: var(--white); margin-bottom: 3px; }
.reward-desc { font-size: 12px; color: var(--muted); line-height: 1.4; }

/* Share link */
.share-box {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 16px 18px;
  margin-bottom: 16px;
  animation: slideUp 0.5s ease 0.5s both;
}
.share-eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--lavande);
  margin-bottom: 10px;
}
/* UX: Show the link clearly — transparency builds trust */
.share-url {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--dark);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
}
.share-url-text {
  flex: 1;
  font-size: 12px;
  color: var(--lavande-soft);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: monospace;
  letter-spacing: 0.5px;
}
.copy-link-btn {
  background: var(--violet);
  border: none;
  border-radius: 6px;
  padding: 6px 12px;
  font-family: 'DM Sans', sans-serif;
  font-size: 11px;
  font-weight: 700;
  color: white;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
