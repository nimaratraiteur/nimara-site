function computeAnalytics() {
  const total = SESSIONS.length;
  const hot = SESSIONS.filter(s=>s.signal==='hot').length;
  const convRate = Math.round(hot/total*100);
  const allClicks = [];
  SESSIONS.forEach(s => s.btnsClicked.forEach(b => allClicks.push(b)));
  const totalClicks = allClicks.length;
  const mobile = SESSIONS.filter(s=>s.device==='mobile').length;
  const mobileP = Math.round(mobile/total*100);
  const btnFreq = {};
  allClicks.forEach(b => { btnFreq[b]=(btnFreq[b]||0)+1; });
  const topicFreq = {};
  SESSIONS.forEach(s => s.topics.forEach(t => { topicFreq[t]=(topicFreq[t]||0)+1; }));
  return {total,hot,convRate,totalClicks,mobile,mobileP,btnFreq,topicFreq};
}

window.addEventListener('DOMContentLoaded', function() {
  const stats = computeAnalytics();

  function countUp(el, end, suffix='') {
    let start=0; const dur=800;
    const step = end/dur*16;
    const timer = setInterval(()=>{
      start=Math.min(start+step,end);
      el.textContent=Math.round(start)+suffix;
      if(start>=end) clearInterval(timer);
    },16);
  }
  setTimeout(()=>{
    countUp(document.getElementById('kpi-conv'), stats.total);
    countUp(document.getElementById('kpi-conv-rate'), stats.convRate, '%');
    countUp(document.getElementById('kpi-clicks'), stats.totalClicks);
    document.getElementById('kpi-mobile').textContent = stats.mobileP+'%';
  },200);
  document.getElementById('kpi-conv-d').textContent = `↑ +3 vs hier (${stats.total-3})`;
  document.getElementById('kpi-rate-d').textContent = `↑ Taux de signal client`;
  document.getElementById('kpi-click-d').textContent = `↑ +${Math.round(stats.totalClicks*.3)} vs hier`;
  document.getElementById('kpi-mob-d').textContent = `Mobile · ${100-stats.mobileP}% desktop`;

  const sorted = Object.entries(stats.btnFreq).sort((a,b)=>b[1]-a[1]).slice(0,7);
  const max = sorted[0][1];
  document.getElementById('total-clicks-badge').textContent = stats.totalClicks+' clics';
  document.getElementById('btn-chart').innerHTML = sorted.map(([label,count])=>`
    <div class="btn-row">
      <div class="btn-label" title="${label}">${label}</div>
      <div class="btn-bar-wrap"><div class="btn-bar" style="width:0%" data-w="${Math.round(count/max*100)}"></div></div>
      <div class="btn-count">${count}</div>
    </div>
  `).join('');
  setTimeout(()=>{
    document.querySelectorAll('.btn-bar').forEach(b=>{ b.style.width=b.dataset.w+'%'; });
  },300);

  const topSorted = Object.entries(stats.topicFreq).sort((a,b)=>b[1]-a[1]).slice(0,10);
  document.getElementById('topics-wrap').innerHTML = topSorted.map(([t,n])=>
    `<span class="topic-chip">${t}<span class="tc-count">${n}</span></span>`
  ).join('');

  const topTop = topSorted.slice(0,5);
  new Chart(document.getElementById('topicChart'),{
    type:'doughnut',
    data:{
      labels:topTop.map(t=>t[0]),
      datasets:[{data:topTop.map(t=>t[1]),backgroundColor:['#5B2C8D','#7c3aab','#a78bfa','#c9a96e','#4ade80'],borderWidth:0,hoverOffset:6}]
    },
    options:{plugins:{legend:{labels:{color:'#9d8fb8',font:{family:'DM Sans',size:11},boxWidth:10}}},cutout:'68%',responsive:true,maintainAspectRatio:true}
  });

  const hours = Array.from({length:12},(_,i)=>i+7);
  const hourData = [0,1,0,1,1,0,1,1,0,1,1,1];
  new Chart(document.getElementById('hourChart'),{
    type:'bar',
    data:{
      labels:hours.map(h=>h+'h'),
      datasets:[{data:hourData,backgroundColor:function(ctx){
        const g=ctx.chart.ctx.createLinearGradient(0,0,0,120);
        g.addColorStop(0,'rgba(167,139,250,.8)');
        g.addColorStop(1,'rgba(91,44,141,.3)');
        return g;
      },borderRadius:6,borderSkipped:false}]
    },
    options:{plugins:{legend:{display:false}},scales:{x:{grid:{display:false},ticks:{color:'#6b5e80',font:{size:10}}},y:{grid:{color:'rgba(255,255,255,.04)'},ticks:{color:'#6b5e80',font:{size:10},stepSize:1}}},responsive:true,maintainAspectRatio:true}
  });

  const hotSessions = SESSIONS.filter(s=>s.signal==='hot');
  const warmSessions = SESSIONS.filter(s=>s.signal==='warm');
  document.getElementById('summary-rows').innerHTML = [
    ['🔥 Sessions chaud', hotSessions.length+' ('+Math.round(hotSessions.length/SESSIONS.length*100)+'%)'],
    ['🌟 Sessions tiède', warmSessions.length+' ('+Math.round(warmSessions.length/SESSIONS.length*100)+'%)'],
    ['❄️ Navigation pure', (SESSIONS.length-hotSessions.length-warmSessions.length)],
    ['📱 Mobile', stats.mobile+' / '+SESSIONS.length],
    ['🥐 Topic #1', 'Petit-déjeuner'],
    ['💰 Format clé', 'Box corporate'],
    ['📍 Point préféré', 'Eaux-Vives'],
  ].map(([l,v])=>`<div class="summary-row"><span class="sr-label">${l}</span><span class="sr-value">${v}</span></div>`).join('');

  document.getElementById('log-count-badge').textContent = SESSIONS.length+' sessions';
  document.getElementById('conv-log').innerHTML = SESSIONS.map(s=>`
    <tr onclick="openDetail('${s.id}')">
      <td><span class="session-id">#${s.id}</span></td>
      <td style="color:var(--text2);font-size:12px">${s.time}</td>
      <td style="font-size:12px;color:var(--lav)">${s.firstBtn}</td>
      <td><span class="msg-count">${s.msgs.length} msg</span></td>
      <td><span class="conv-signal ${s.signal}">${s.signalLabel}</span></td>
      <td><span class="device-icon">${s.device==='mobile'?'📱':'🖥️'}</span></td>
    </tr>
  `).join('');
});

function openDetail(id) {
  const s = SESSIONS.find(x=>x.id===id);
  if(!s) return;
  document.getElementById('dp-session-id').textContent = '#'+s.id+' · '+s.date+' '+s.time;
  document.getElementById('dp-meta').innerHTML = [
    `<span class="dp-tag">${s.device==='mobile'?'📱 Mobile':'🖥️ Desktop'}</span>`,
    `<span class="dp-tag conv-signal ${s.signal}">${s.signalLabel}</span>`,
    ...s.topics.map(t=>`<span class="dp-tag">${t}</span>`)
  ].join('');
  document.getElementById('dp-chat').innerHTML = s.msgs.map(m=>{
    if(m.role==='btn') return `<div class="dp-btn-click">👆 <em>${m.text}</em> <span style="color:var(--text3);margin-left:4px">${m.t}</span></div>`;
    const vanAvatar = `<div class="dp-av v"><img src="/assets/images/vanessa-avatar.png" alt="V" onerror="this.parentElement.className='dp-av v-fb';this.remove();this.parentElement.textContent='V'"></div>`;
    const userAvatar = `<div class="dp-av u">C</div>`;
    return `
      <div class="dp-msg ${m.role==='van'?'van':'user'}">
        ${m.role==='van' ? vanAvatar : userAvatar}
        <div>
          <div class="dp-bubble">${m.text}</div>
          <div class="dp-time">${m.t}</div>
        </div>
      </div>
    `;
  }).join('');
  document.getElementById('detail-panel').classList.add('open');
}

function closeDetail() {
  document.getElementById('detail-panel').classList.remove('open');
}

document.querySelectorAll('.dr-btn').forEach(btn=>{
  btn.addEventListener('click',function(){
    document.querySelectorAll('.dr-btn').forEach(b=>b.classList.remove('active'));
    this.classList.add('active');
  });
});
</script>
