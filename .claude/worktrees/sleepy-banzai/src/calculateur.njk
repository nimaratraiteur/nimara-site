---
layout: layouts/page
title: Calculateur de Devis
subtitle: "Composez votre menu ou entrez votre budget — obtenez une estimation instantanée."
description: "Calculateur de devis Nimara : estimez votre commande traiteur en quelques clics. Apéro, déjeuner, buffet, coffee break à Genève."
eyebrow: "Outil · Devis Instantané"
permalink: /calculateur/
---

<section class="section" id="calculateur">
  <div class="container" style="max-width:880px">

    <!-- Mode selector -->
    <div class="calc-mode-bar" id="calc-mode-bar">
      <button class="calc-mode-btn is-active" data-mode="compose" type="button">
        <span style="font-size:1.1rem">🧑‍🍳</span>
        <span>Je compose mon menu</span>
      </button>
      <button class="calc-mode-btn" data-mode="budget" type="button">
        <span style="font-size:1.1rem">💰</span>
        <span>Mon budget par personne</span>
      </button>
    </div>

    <!-- ═══ MODE 1 : COMPOSE ═══ -->
    <div id="mode-compose" class="calc-panel">

      <div class="calc-grid">

        <!-- Left: inputs -->
        <div class="calc-inputs">

          <div class="calc-group">
            <label class="calc-label">Type d'événement</label>
            <div class="event-type-grid" id="event-type-grid">
              {% for et in pricing.eventTypes %}
              <button class="event-type-btn{% if loop.first %} is-active{% endif %}"
                      type="button"
                      data-event="{{ et.id }}"
                      data-min="{{ et.minPerPax }}"
                      data-max="{{ et.maxPerPax }}"
                      data-drinks="{{ et.drinksPerPax }}">
                <span class="et-icon">{{ et.icon }}</span>
                <span class="et-label">{{ et.label.fr }}</span>
                <span class="et-range">{{ et.minPerPax }}–{{ et.maxPerPax }} CHF/pers.</span>
              </button>
              {% endfor %}
            </div>
          </div>

          <div class="calc-group">
            <label class="calc-label" for="guest-count">
              Nombre de personnes
              <span class="calc-val-display" id="guest-count-display">30</span>
            </label>
            <input type="range" id="guest-count" class="calc-slider"
                   min="5" max="200" step="5" value="30"
                   aria-label="Nombre de personnes">
            <div class="slider-ticks">
              {% for n in pricing.guestRanges %}
              <span>{{ n }}</span>
              {% endfor %}
            </div>
          </div>

          <div class="calc-group">
            <label class="calc-label">Options</label>
            <div style="display:flex;flex-direction:column;gap:.6rem">
              <label class="calc-checkbox">
                <input type="checkbox" id="opt-drinks" checked>
                <span class="checkbox-custom"></span>
                <span>{{ pricing.options.drinks.label.fr }} <em class="opt-cost" id="drinks-cost"></em></span>
              </label>
              <label class="calc-checkbox">
                <input type="checkbox" id="opt-delivery">
                <span class="checkbox-custom"></span>
                <span>{{ pricing.options.delivery.label.fr }} <em class="opt-cost">CHF {{ pricing.options.delivery.flat }} (offert &gt; CHF {{ pricing.options.delivery.freeAbove }})</em></span>
              </label>
            </div>
          </div>

          <div class="calc-group">
            <label class="calc-label">Cuisine</label>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap">
              <button class="filter-tab is-active" type="button" data-cuisine="both">Salé & Sucré</button>
              <button class="filter-tab" type="button" data-cuisine="sale">Salé uniquement</button>
              <button class="filter-tab" type="button" data-cuisine="sucre">Sucré uniquement</button>
            </div>
          </div>

        </div>

        <!-- Right: live estimate -->
        <div class="calc-result">
          <div class="calc-result-inner">

            <div class="calc-result-head">
              <span class="eyebrow" style="color:var(--lavender)">Estimation</span>
              <div class="calc-total" id="calc-total">CHF —</div>
              <div class="calc-range-label" id="calc-range">Fourchette de prix</div>
            </div>

            <div class="calc-breakdown" id="calc-breakdown">
              <!-- Injected by JS -->
            </div>

            <div class="calc-includes">
              <div class="calc-includes-title">Inclus dans cette formule</div>
              <div class="calc-includes-list" id="calc-includes">
                <!-- Injected by JS -->
              </div>
            </div>

            <a id="calc-wa-btn"
               href="#"
               class="btn btn-whatsapp"
               style="width:100%;justify-content:center;margin-top:1rem"
               target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Demander ce devis sur WhatsApp
            </a>

            <p style="font-size:.7rem;color:var(--gray-500);text-align:center;margin-top:.5rem">
              Estimation non contractuelle. Devis définitif sur demande.
            </p>

          </div>
        </div>

      </div>
    </div>

    <!-- ═══ MODE 2 : BUDGET ═══ -->
    <div id="mode-budget" class="calc-panel" style="display:none">

      <div class="calc-grid">

        <div class="calc-inputs">
          <div class="calc-group">
            <label class="calc-label" for="budget-input">
              Budget par personne (CHF)
              <span class="calc-val-display" id="budget-display">20</span>
            </label>
            <input type="range" id="budget-input" class="calc-slider"
                   min="8" max="50" step="1" value="20"
                   aria-label="Budget par personne en CHF">
            <div style="display:flex;justify-content:space-between;font-size:.72rem;color:var(--gray-500);margin-top:.25rem">
              <span>CHF 8</span><span>CHF 50+</span>
            </div>
          </div>

          <div class="calc-group">
            <label class="calc-label" for="budget-guests">
              Nombre de personnes
              <span class="calc-val-display" id="budget-guests-display">20</span>
            </label>
            <input type="range" id="budget-guests" class="calc-slider"
                   min="5" max="200" step="5" value="20"
                   aria-label="Nombre de personnes">
          </div>
        </div>

        <div class="calc-result">
          <div class="calc-result-inner">
            <span class="eyebrow" style="color:var(--lavender)">Formules correspondantes</span>
            <div id="budget-matches" style="margin-top:1rem;display:flex;flex-direction:column;gap:.75rem">
              <!-- Injected by JS -->
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
.calc-mode-bar {
  display: flex;
  gap: .75rem;
  margin-bottom: 2rem;
  background: var(--gray-100);
  border-radius: 14px;
  padding: .4rem;
}
.calc-mode-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  padding: .7rem 1.25rem;
  border-radius: 10px;
  font-size: .88rem;
  font-weight: 500;
  font-family: var(--font-body);
  color: var(--gray-500);
  background: transparent;
  border: none;
  cursor: pointer;
  transition: all var(--transition);
}
.calc-mode-btn.is-active {
  background: var(--white);
  color: var(--violet);
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}
.calc-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: start;
}
.calc-inputs { display: flex; flex-direction: column; gap: 1.75rem; }
.calc-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: .85rem;
  font-weight: 600;
  color: var(--dark);
  margin-bottom: .6rem;
}
.calc-val-display {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--violet);
  font-family: var(--font-display);
}
.calc-slider {
  width: 100%;
  -webkit-appearance: none;
  height: 4px;
  border-radius: 4px;
  background: var(--gray-200, #e5e7eb);
  outline: none;
  cursor: pointer;
  accent-color: var(--violet);
}
.calc-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 20px; height: 20px;
  border-radius: 50%;
  background: var(--violet);
  box-shadow: 0 2px 6px rgba(91,44,141,.3);
  cursor: pointer;
}
.slider-ticks {
  display: flex;
  justify-content: space-between;
  font-size: .65rem;
  color: var(--gray-500);
  margin-top: .2rem;
}
.event-type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: .5rem;
}
.event-type-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: .1rem;
  padding: .7rem .85rem;
  border: 1.5px solid var(--gray-300);
  border-radius: var(--radius-sm);
  background: var(--white);
  cursor: pointer;
  transition: all var(--transition);
  text-align: left;
  font-family: var(--font-body);
}
.event-type-btn:hover { border-color: var(--lavender); }
.event-type-btn.is-active { border-color: var(--violet); background: rgba(91,44,141,.04); }
.et-icon { font-size: 1.3rem; }
.et-label { font-size: .82rem; font-weight: 600; color: var(--dark); }
.et-range { font-size: .7rem; color: var(--gray-500); }
.calc-checkbox {
  display: flex;
  align-items: center;
  gap: .6rem;
  cursor: pointer;
  font-size: .88rem;
  color: var(--gray-700);
}
.calc-checkbox input { display: none; }
.checkbox-custom {
  width: 18px; height: 18px;
  border: 2px solid var(--gray-300);
  border-radius: 4px;
  flex-shrink: 0;
  transition: all .15s;
  display: flex; align-items: center; justify-content: center;
}
.calc-checkbox input:checked + .checkbox-custom {
  background: var(--violet);
  border-color: var(--violet);
}
.calc-checkbox input:checked + .checkbox-custom::after {
  content: '✓';
  color: white;
  font-size: .7rem;
  font-weight: 700;
}
.opt-cost { font-size: .75rem; color: var(--gray-500); font-style: normal; }
.calc-result {
  position: sticky;
  top: calc(var(--header-h) + 1rem);
}
.calc-result-inner {
  background: linear-gradient(135deg, var(--dark) 0%, var(--violet-dark) 100%);
  border-radius: var(--radius-lg);
  padding: 1.75rem;
  color: white;
}
.calc-result-head { text-align: center; margin-bottom: 1.5rem; }
.calc-total {
  font-family: var(--font-display);
  font-size: 2.5rem;
  color: var(--lavender-lt);
  line-height: 1;
  margin-bottom: .25rem;
}
.calc-range-label { font-size: .78rem; color: rgba(255,255,255,.5); }
.calc-breakdown { display: flex; flex-direction: column; gap: .4rem; margin-bottom: 1.25rem; }
.calc-breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: .82rem;
  padding: .35rem 0;
  border-bottom: 1px solid rgba(255,255,255,.07);
  color: rgba(255,255,255,.7);
}
.calc-breakdown-row:last-child { border: none; }
.calc-breakdown-row strong { color: white; }
.calc-includes-title { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.4); margin-bottom: .6rem; }
.calc-includes-list { display: flex; flex-wrap: wrap; gap: .35rem; }
.calc-includes-chip {
  font-size: .72rem;
  padding: .2rem .6rem;
  background: rgba(167,139,250,.12);
  border: 1px solid rgba(167,139,250,.2);
  border-radius: var(--radius-full);
  color: var(--lavender-lt);
  text-decoration: none;
  transition: background .2s;
  cursor: pointer;
}
.calc-includes-chip:hover { background: rgba(167,139,250,.25); }
.budget-match-card {
  background: var(--white);
  border: 1.5px solid var(--gray-300);
  border-radius: var(--radius);
  padding: 1rem 1.25rem;
  transition: border-color .2s;
  cursor: default;
}
.budget-match-card.best { border-color: var(--violet); background: rgba(91,44,141,.03); }
.budget-match-label { font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--lavender); margin-bottom: .25rem; }
.budget-match-name { font-weight: 600; font-size: .95rem; color: var(--dark); margin-bottom: .2rem; }
.budget-match-desc { font-size: .78rem; color: var(--gray-500); margin-bottom: .5rem; }
.budget-match-price { font-weight: 700; color: var(--violet); font-size: 1.1rem; }
@media(max-width:680px){
  .calc-grid{grid-template-columns:1fr;}
  .calc-result{position:static;}
  .event-type-grid{grid-template-columns:1fr 1fr;}
}
</style>

{% set pricingJson = pricing | dump %}
<script>
(function(){
  const PRICING = {{ pricingJson | safe }};
  let currentEvent = PRICING.eventTypes[0];
  let guests = 30;
  let withDrinks = true;
  let withDelivery = false;

  function getEventById(id){ return PRICING.eventTypes.find(e=>e.id===id); }

  function computeTotal(event, guestCount, drinks, delivery){
    const mid = (event.minPerPax + event.maxPerPax) / 2;
    const food = mid * guestCount;
    const drinksTotal = drinks ? event.drinksPerPax * guestCount : 0;
    let deliveryCost = 0;
    if(delivery){ deliveryCost = food >= PRICING.options.delivery.freeAbove ? 0 : PRICING.options.delivery.flat; }
    const total = food + drinksTotal + deliveryCost;
    return { food, drinksTotal, deliveryCost, total };
  }

  function formatChf(n){ return 'CHF ' + Math.round(n).toLocaleString('fr-CH'); }

  function updateCompose(){
    const { food, drinksTotal, deliveryCost, total } = computeTotal(currentEvent, guests, withDrinks, withDelivery);
    const minTotal = currentEvent.minPerPax * guests + (withDrinks ? currentEvent.drinksPerPax * guests : 0) + (withDelivery && total < PRICING.options.delivery.freeAbove ? PRICING.options.delivery.flat : 0);
    const maxTotal = currentEvent.maxPerPax * guests + (withDrinks ? currentEvent.drinksPerPax * guests : 0) + (withDelivery && total < PRICING.options.delivery.freeAbove ? PRICING.options.delivery.flat : 0);

    document.getElementById('calc-total').textContent = formatChf(total);
    document.getElementById('calc-range').textContent = formatChf(minTotal) + ' – ' + formatChf(maxTotal);

    const rows = [
      ['Repas (' + guests + ' pers. × ~' + Math.round((currentEvent.minPerPax+currentEvent.maxPerPax)/2) + ' CHF)', formatChf(food)],
      withDrinks ? ['Boissons (' + guests + ' × ' + currentEvent.drinksPerPax + ' CHF)', formatChf(drinksTotal)] : null,
      withDelivery ? ['Livraison', deliveryCost === 0 ? 'Offerte' : formatChf(deliveryCost)] : null,
    ].filter(Boolean);
    document.getElementById('calc-breakdown').innerHTML = rows.map(([l,v])=>
      `<div class="calc-breakdown-row"><span>${l}</span><strong>${v}</strong></div>`
    ).join('');

    document.getElementById('calc-includes').innerHTML = currentEvent.includes.map(slug=>
      `<a href="/produits/${slug}/" class="calc-includes-chip">${slug.replace(/-/g,' ')}</a>`
    ).join('');

    const waMsg = encodeURIComponent(
      `Bonjour Nimara ! Je souhaite un devis pour :\n` +
      `- Événement : ${currentEvent.label.fr}\n` +
      `- Personnes : ${guests}\n` +
      `- Boissons : ${withDrinks ? 'Oui' : 'Non'}\n` +
      `- Livraison : ${withDelivery ? 'Oui' : 'Non'}\n` +
      `- Budget estimé : ${formatChf(minTotal)} – ${formatChf(maxTotal)}`
    );
    document.getElementById('calc-wa-btn').href = 'https://wa.me/41225576020?text=' + waMsg;

    document.getElementById('drinks-cost').textContent = '(+' + formatChf(withDrinks ? currentEvent.drinksPerPax * guests : currentEvent.drinksPerPax * guests) + ')';
  }

  function updateBudget(){
    const budgetPax = parseInt(document.getElementById('budget-input').value);
    const bg = parseInt(document.getElementById('budget-guests').value);
    document.getElementById('budget-display').textContent = budgetPax;
    document.getElementById('budget-guests-display').textContent = bg;

    const matches = PRICING.eventTypes
      .map(et => {
        const mid = (et.minPerPax + et.maxPerPax) / 2;
        const diff = Math.abs(budgetPax - mid);
        const fits = budgetPax >= et.minPerPax && budgetPax <= et.maxPerPax;
        return { et, diff, fits, total: budgetPax * bg };
      })
      .sort((a,b)=> (b.fits ? 1 : 0) - (a.fits ? 1 : 0) || a.diff - b.diff)
      .slice(0,3);

    document.getElementById('budget-matches').innerHTML = matches.map((m,i)=>`
      <div class="budget-match-card ${i===0?'best':''}">
        ${i===0?'<div class="budget-match-label">✨ Meilleure correspondance</div>':''}
        <div class="budget-match-name">${m.et.icon} ${m.et.label.fr}</div>
        <div class="budget-match-desc">${m.et.description.fr}</div>
        <div style="display:flex;justify-content:space-between;align-items:center">
          <span class="budget-match-price">≈ CHF ${Math.round(m.total).toLocaleString('fr-CH')} total</span>
          <a href="https://wa.me/41225576020?text=${encodeURIComponent('Bonjour ! Je souhaite un devis pour '+m.et.label.fr+' ('+bg+' personnes, ~'+budgetPax+' CHF/pers.)')}"
             class="btn btn-primary" style="font-size:.75rem;padding:.4rem .9rem"
             target="_blank" rel="noopener noreferrer">Devis</a>
        </div>
        ${m.fits ? '<div style="font-size:.7rem;color:var(--green-wa,#25D366);margin-top:.35rem">✓ Budget compatible</div>' : '<div style="font-size:.7rem;color:var(--gray-500);margin-top:.35rem">Fourchette: CHF '+m.et.minPerPax+'–'+m.et.maxPerPax+'/pers.</div>'}
      </div>
    `).join('');
  }

  document.addEventListener('DOMContentLoaded',()=>{
    // Mode toggle
    document.querySelectorAll('.calc-mode-btn').forEach(btn=>{
      btn.addEventListener('click',()=>{
        document.querySelectorAll('.calc-mode-btn').forEach(b=>b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const mode = btn.dataset.mode;
        document.getElementById('mode-compose').style.display = mode==='compose'?'':'none';
        document.getElementById('mode-budget').style.display = mode==='budget'?'':'none';
        if(mode==='budget') updateBudget();
      });
    });

    // Event type
    document.getElementById('event-type-grid').addEventListener('click',e=>{
      const btn = e.target.closest('.event-type-btn');
      if(!btn) return;
      document.querySelectorAll('.event-type-btn').forEach(b=>b.classList.remove('is-active'));
      btn.classList.add('is-active');
      currentEvent = getEventById(btn.dataset.event);
      updateCompose();
    });

    // Guests slider
    const guestSlider = document.getElementById('guest-count');
    guestSlider.addEventListener('input',()=>{
      guests = parseInt(guestSlider.value);
      document.getElementById('guest-count-display').textContent = guests;
      updateCompose();
    });

    // Options
    document.getElementById('opt-drinks').addEventListener('change',e=>{ withDrinks=e.target.checked; updateCompose(); });
    document.getElementById('opt-delivery').addEventListener('change',e=>{ withDelivery=e.target.checked; updateCompose(); });

    // Cuisine filter (visual only, affects nothing in mock)
    document.querySelectorAll('[data-cuisine]').forEach(btn=>{
      btn.addEventListener('click',()=>{
        document.querySelectorAll('[data-cuisine]').forEach(b=>b.classList.remove('is-active'));
        btn.classList.add('is-active');
      });
    });

    // Budget mode
    document.getElementById('budget-input').addEventListener('input', updateBudget);
    document.getElementById('budget-guests').addEventListener('input', updateBudget);

    updateCompose();
    updateBudget();
  });
})();
</script>
